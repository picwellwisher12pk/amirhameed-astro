---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="About Amir Hameed — UI/UX Architect & Developer"
  description="Background, career journey, technical philosophy, and personal interests of Amir Hameed."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <!-- Bio Hero -->
    <div class="flex flex-col-reverse md:flex-row items-center md:items-start justify-between gap-8 pb-12 border-b border-zinc-200 dark:border-zinc-800">
      <div class="flex-1 text-center md:text-left">
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-mono font-medium bg-indigo-50 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-400 border border-indigo-200 dark:border-indigo-900/50 mb-3">
          Behind the Code & Design
        </span>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-zinc-900 dark:text-white tracking-tight">
          About Amir Hameed
        </h1>
        <p class="mt-4 text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed">
          Seasoned graphic designer, UX/UI architect, and senior frontend developer based in Lahore, Pakistan. Over the past decade, I've bridged the gap between fine visual aesthetics and deep engineering principles.
        </p>
      </div>

      <div class="w-36 h-36 rounded-3xl p-1 bg-gradient-to-tr from-indigo-500 to-violet-500 shadow-xl shrink-0">
        <img 
          src="https://i0.wp.com/amirhameed.com/wp-content/uploads/2019/04/IMG_1132-e1556652620263.jpg?fit=300%2C300&ssl=1" 
          alt="Amir Hameed"
          class="w-full h-full object-cover rounded-[22px] bg-zinc-800"
        />
      </div>
    </div>

    <!-- Career Timeline -->
    <section class="py-12 border-b border-zinc-200 dark:border-zinc-800">
      <h2 class="text-2xl font-bold text-zinc-900 dark:text-white mb-6">
        Professional Journey
      </h2>

      <div class="space-y-8 relative before:absolute before:inset-0 before:left-3.5 before:w-0.5 before:bg-zinc-200 dark:before:bg-zinc-800">
        
        <!-- Role 1 -->
        <div class="relative pl-10">
          <div class="absolute left-2 top-1.5 w-3.5 h-3.5 rounded-full bg-indigo-600 border-4 border-white dark:border-zinc-900"></div>
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
            <h3 class="text-lg font-bold text-zinc-900 dark:text-white">Senior Front-End Developer</h3>
            <span class="text-xs font-mono text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-950/60 px-2.5 py-0.5 rounded-md self-start sm:self-auto">2023 &mdash; Present</span>
          </div>
          <div class="text-sm font-medium text-zinc-600 dark:text-zinc-400 mt-0.5">IT22</div>
          <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Leading front-end development and UX/UI initiatives, delivering robust architectures, design systems, and responsive user experiences for modern web platforms.
          </p>
        </div>

        <!-- Role 2 -->
        <div class="relative pl-10">
          <div class="absolute left-2 top-1.5 w-3.5 h-3.5 rounded-full bg-zinc-400 border-4 border-white dark:border-zinc-900"></div>
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
            <h3 class="text-lg font-bold text-zinc-900 dark:text-white">Associate Architect of Front-End Design & Development</h3>
            <span class="text-xs font-mono text-zinc-500 bg-zinc-100 dark:bg-zinc-800 px-2.5 py-0.5 rounded-md self-start sm:self-auto">2013 &mdash; 2023</span>
          </div>
          <div class="text-sm font-medium text-zinc-600 dark:text-zinc-400 mt-0.5">Codehoppers</div>
          <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Spearheaded product design, branding, and web application architecture across 10 years of cross-disciplinary client and product projects.
          </p>
        </div>

        <!-- Role 3 -->
        <div class="relative pl-10">
          <div class="absolute left-2 top-1.5 w-3.5 h-3.5 rounded-full bg-zinc-400 border-4 border-white dark:border-zinc-900"></div>
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
            <h3 class="text-lg font-bold text-zinc-900 dark:text-white">Educator & Technical Instructor</h3>
            <span class="text-xs font-mono text-zinc-500 bg-zinc-100 dark:bg-zinc-800 px-2.5 py-0.5 rounded-md self-start sm:self-auto">10+ Years</span>
          </div>
          <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Mentored and taught hundreds of students across computer science, 3D modeling, animation, graphic design, and modern front-end technologies.
          </p>
        </div>

      </div>
    </section>

    <!-- Design & Engineering Philosophy -->
    <section class="py-12 border-b border-zinc-200 dark:border-zinc-800">
      <h2 class="text-2xl font-bold text-zinc-900 dark:text-white mb-6">
        Design & Engineering Philosophy
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-white dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800">
          <div class="w-8 h-8 rounded-xl bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 flex items-center justify-center font-bold text-sm mb-4">
            01
          </div>
          <h3 class="font-bold text-zinc-900 dark:text-white mb-2">User-Centric Empathy</h3>
          <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Every component and pixel must serve the user's intent. Interfaces should feel invisible, predictable, and delightful to interact with.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800">
          <div class="w-8 h-8 rounded-xl bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 flex items-center justify-center font-bold text-sm mb-4">
            02
          </div>
          <h3 class="font-bold text-zinc-900 dark:text-white mb-2">Architectural Cleanliness</h3>
          <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Strong typography, robust state management, and type safety. Clean code and design systems ensure sustainable long-term scale.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800">
          <div class="w-8 h-8 rounded-xl bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 flex items-center justify-center font-bold text-sm mb-4">
            03
          </div>
          <h3 class="font-bold text-zinc-900 dark:text-white mb-2">Continuous Innovation</h3>
          <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
            From the early days of HTML in 2001 to building AI-assisted automation pipelines and cross-platform extensions today, staying curious is paramount.
          </p>
        </div>
      </div>
    </section>

    <!-- Fun Facts & Milestones -->
    <section class="py-12 border-b border-zinc-200 dark:border-zinc-800">
      <h2 class="text-2xl font-bold text-zinc-900 dark:text-white mb-6">
        Fun Milestones
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="p-5 rounded-2xl bg-zinc-100/60 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800">
          <div class="text-2xl font-extrabold text-indigo-600 dark:text-indigo-400 font-mono">2001</div>
          <div class="text-sm font-bold text-zinc-900 dark:text-white mt-1">Wrote First HTML Page</div>
          <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-1">Started exploring web code over two decades ago during the early days of personal computing.</p>
        </div>

        <div class="p-5 rounded-2xl bg-zinc-100/60 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800">
          <div class="text-2xl font-extrabold text-indigo-600 dark:text-indigo-400 font-mono">2002</div>
          <div class="text-sm font-bold text-zinc-900 dark:text-white mt-1">First Adobe Photoshop Experience</div>
          <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-1">Started visual design in Photoshop 6.5, igniting a lifelong passion for digital art and UI.</p>
        </div>
      </div>
    </section>

    <!-- Personal Interests & Gaming -->
    <section class="py-12">
      <h2 class="text-2xl font-bold text-zinc-900 dark:text-white mb-4">
        Interests & Gaming
      </h2>
      <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
        When I'm not writing code or architecting UI workflows, I enjoy reading, immersing myself in books, and gaming. Some of my all-time favorites include:
      </p>

      <div class="mt-4 flex flex-wrap gap-2">
        {["Factorio (Automation)", "Commandos", "Red Alert 2", "Dota 2", "Tekken Series", "Assassin's Creed"].map((game) => (
          <span class="px-3 py-1.5 rounded-lg text-xs font-medium bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700/60">
            🎮 {game}
          </span>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
