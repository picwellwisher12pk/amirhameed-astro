---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Contact — Amir Hameed"
  description="Get in touch with Amir Hameed for front-end architecture, UI/UX consulting, or technical collaborations."
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-12">
    <!-- Header -->
    <div class="max-w-xl">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-mono font-medium bg-indigo-50 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-400 border border-indigo-200 dark:border-indigo-900/50 mb-4">
        Get in Touch
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-zinc-900 dark:text-white tracking-tight">
        Let's Connect & Build Together
      </h1>
      <p class="mt-3 text-base text-zinc-600 dark:text-zinc-400 leading-relaxed">
        Have a new project, looking for frontend architecture advice, or want to discuss automated AI workflows? Send a message below or email directly.
      </p>
    </div>

    <!-- Contact Info Cards -->
    <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 gap-4">
      <!-- Direct Email Card -->
      <div class="p-6 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/60 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono text-zinc-400">Direct Email</span>
            <span class="text-xs px-2 py-0.5 rounded-full bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 font-medium">Fastest</span>
          </div>
          <a href="mailto:amir@amirhameed.com" class="mt-3 text-lg font-bold text-zinc-900 dark:text-white hover:text-indigo-600 dark:hover:text-indigo-400 block transition-colors">
            amir@amirhameed.com
          </a>
          <p class="text-xs text-zinc-500 mt-1">Direct to personal inbox.</p>
        </div>

        <div class="mt-5 pt-4 border-t border-zinc-100 dark:border-zinc-800/80 flex items-center gap-3">
          <a 
            href="mailto:amir@amirhameed.com" 
            class="px-4 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold shadow-xs transition-colors inline-flex items-center gap-1.5"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            Send Email
          </a>
          <button 
            id="copy-email-btn"
            class="px-3 py-1.5 rounded-lg border border-zinc-200 dark:border-zinc-700 text-xs font-medium text-zinc-600 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors cursor-pointer"
          >
            Copy Address
          </button>
        </div>
      </div>

      <!-- Location Card -->
      <div class="p-6 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/60 flex flex-col justify-between">
        <div>
          <span class="text-xs font-mono text-zinc-400">Location & Timezone</span>
          <div class="mt-3 text-lg font-bold text-zinc-900 dark:text-white">
            Lahore, Pakistan
          </div>
          <p class="text-xs text-zinc-500 mt-1">PKT (UTC+5) &bull; Remote contracts worldwide.</p>
        </div>

        <div class="mt-5 pt-4 border-t border-zinc-100 dark:border-zinc-800/80 flex items-center gap-2 text-xs text-zinc-500 font-mono">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          Available for new opportunities
        </div>
      </div>
    </div>

    <!-- Contact Form (Powered by Web3Forms) -->
    <div class="mt-10 p-6 sm:p-8 rounded-3xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/40 shadow-sm">
      <div class="mb-6">
        <h2 class="text-xl font-bold text-zinc-900 dark:text-white">Send a Message</h2>
        <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-1">
          Delivered straight to Amir's inbox via Web3Forms.
        </p>
      </div>

      <form id="contact-form" class="space-y-5">
        <!-- Web3Forms Access Key: Replace with your key from web3forms.com -->
        <input type="hidden" name="access_key" value="YOUR_WEB3FORMS_ACCESS_KEY" />
        <input type="hidden" name="subject" value="New Portfolio Message from amirhameed.com" />
        <input type="hidden" name="from_name" value="amirhameed.com Portfolio" />
        <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="name" class="block text-xs font-mono font-medium text-zinc-700 dark:text-zinc-300 mb-1.5">
              Your Name *
            </label>
            <input 
              type="text" 
              id="name" 
              name="name" 
              required 
              placeholder="e.g. John Doe"
              class="w-full px-4 py-2.5 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-950 text-zinc-900 dark:text-white placeholder:text-zinc-400 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500"
            />
          </div>

          <div>
            <label for="email" class="block text-xs font-mono font-medium text-zinc-700 dark:text-zinc-300 mb-1.5">
              Email Address *
            </label>
            <input 
              type="email" 
              id="email" 
              name="email" 
              required 
              placeholder="name@example.com"
              class="w-full px-4 py-2.5 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-950 text-zinc-900 dark:text-white placeholder:text-zinc-400 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500"
            />
          </div>
        </div>

        <div>
          <label for="topic" class="block text-xs font-mono font-medium text-zinc-700 dark:text-zinc-300 mb-1.5">
            Subject / Discussion Topic
          </label>
          <input 
            type="text" 
            id="topic" 
            name="custom_topic" 
            placeholder="Architecture Consulting / Project Inquiry / Hello"
            class="w-full px-4 py-2.5 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-950 text-zinc-900 dark:text-white placeholder:text-zinc-400 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500"
          />
        </div>

        <div>
          <label for="message" class="block text-xs font-mono font-medium text-zinc-700 dark:text-zinc-300 mb-1.5">
            Your Message *
          </label>
          <textarea 
            id="message" 
            name="message" 
            rows="5" 
            required 
            placeholder="Tell me a bit about what you're building or what you have in mind..."
            class="w-full px-4 py-2.5 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-950 text-zinc-900 dark:text-white placeholder:text-zinc-400 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 resize-none"
          ></textarea>
        </div>

        <!-- Submit Button & Status -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-2">
          <button 
            type="submit"
            id="submit-btn"
            class="w-full sm:w-auto px-6 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-sm shadow-md shadow-indigo-600/20 transition-all hover:scale-[1.01] cursor-pointer flex items-center justify-center gap-2"
          >
            <span id="btn-text">Send Message &rarr;</span>
          </button>

          <div id="form-result" class="hidden text-xs font-medium"></div>
        </div>
      </form>
    </div>
  </div>

  <script>
    // Copy email button
    const copyBtn = document.getElementById('copy-email-btn');
    copyBtn?.addEventListener('click', () => {
      navigator.clipboard.writeText('amir@amirhameed.com');
      copyBtn.textContent = 'Copied! ✓';
      setTimeout(() => {
        copyBtn.textContent = 'Copy Address';
      }, 2500);
    });

    // Web3Forms AJAX handler
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const result = document.getElementById('form-result');
    const submitBtn = document.getElementById('submit-btn');
    const btnText = document.getElementById('btn-text');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!result || !submitBtn || !btnText) return;

      const formData = new FormData(form);
      const accessKey = formData.get('access_key');

      // If user hasn't added their real access key yet, provide guidance
      if (accessKey === 'YOUR_WEB3FORMS_ACCESS_KEY') {
        result.classList.remove('hidden');
        result.className = 'text-xs font-medium text-amber-600 dark:text-amber-400 bg-amber-50 dark:bg-amber-950/50 p-3 rounded-xl border border-amber-200 dark:border-amber-800';
        result.innerHTML = 'Web3Forms setup: Please paste your free Access Key from <a href="https://web3forms.com" target="_blank" class="underline font-bold">web3forms.com</a> into contact.astro, or click "Send Email" above to mail directly.';
        return;
      }

      btnText.textContent = 'Sending...';
      submitBtn.setAttribute('disabled', 'true');

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: formData,
        });

        const data = await response.json();
        result.classList.remove('hidden');

        if (response.ok && data.success) {
          result.className = 'text-xs font-medium text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/50 p-3 rounded-xl border border-emerald-200 dark:border-emerald-800';
          result.textContent = '✓ Message sent successfully! Amir will get back to you shortly.';
          form.reset();
        } else {
          result.className = 'text-xs font-medium text-rose-600 dark:text-rose-400 bg-rose-50 dark:bg-rose-950/50 p-3 rounded-xl border border-rose-200 dark:border-rose-800';
          result.textContent = data.message || 'Something went wrong. Please email directly at amir@amirhameed.com';
        }
      } catch (err) {
        result.classList.remove('hidden');
        result.className = 'text-xs font-medium text-rose-600 dark:text-rose-400 bg-rose-50 dark:bg-rose-950/50 p-3 rounded-xl border border-rose-200 dark:border-rose-800';
        result.textContent = 'Network error. Please email directly at amir@amirhameed.com';
      } finally {
        btnText.textContent = 'Send Message →';
        submitBtn.removeAttribute('disabled');
      }
    });
  </script>
</BaseLayout>
