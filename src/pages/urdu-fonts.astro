---
import BaseLayout from '../layouts/BaseLayout.astro';

const fonts = [
  // Nastaliq Styles
  {
    id: "noto-nastaliq",
    name: "Noto Nastaliq Urdu",
    family: "'Noto Nastaliq Urdu', serif",
    category: "Nastaliq (Google Fonts)",
    description: "Google's official Nastaliq font. Highly optimized for modern web browsers, stable baselines, and crisp rendering.",
    googleFont: "Noto+Nastaliq+Urdu:wght@400;500;600;700",
    badge: "Recommended for Nastaliq"
  },
  {
    id: "jameel-noori",
    name: "Jameel Noori Nastaleeq",
    family: "'Jameel Noori Nastaleeq', 'Jameel Noori Nastaleeq Kasheeda', serif",
    category: "Classic Nastaliq (CDN)",
    description: "The gold standard in Pakistani journalism, InPage, and book publishing. Most authentic classic calligraphy.",
    cdnCss: "https://fonts.cdnfonts.com/css/jameel-noori-nastaleeq",
    badge: "Pakistani Standard"
  },
  {
    id: "gulzar",
    name: "Gulzar",
    family: "'Gulzar', serif",
    category: "Modern Display Nastaliq",
    description: "Designed by Borna Izadpanah on Google Fonts. Bold, artistic calligraphic strokes with unique ligatures.",
    googleFont: "Gulzar",
    badge: "Great for Titles"
  },
  // Modern Clean Sans Styles
  {
    id: "noto-sans-arabic",
    name: "Noto Sans Arabic",
    family: "'Noto Sans Arabic', sans-serif",
    category: "Modern Tech Sans",
    description: "Ultra-clean digital typeface. Ideal for tech tutorials, code documentation, and high-density mobile screens.",
    googleFont: "Noto+Sans+Arabic:wght@300;400;500;600;700;800",
    badge: "Recommended for Tech & UI"
  },
  {
    id: "readex-pro",
    name: "Readex Pro",
    family: "'Readex Pro', sans-serif",
    category: "Geometric Sans",
    description: "Contemporary geometric font engineered by Thomas Jockin. Pairs seamlessly with English Inter or Helvetica.",
    googleFont: "Readex+Pro:wght@300;400;500;600;700",
    badge: "Modern & Geometric"
  },
  {
    id: "vazirmatn",
    name: "Vazirmatn",
    family: "'Vazirmatn', sans-serif",
    category: "Digital Interface Sans",
    description: "Sleek and versatile interface typeface by Saber Rastikerdar. Exceptional legibility across small body copy.",
    googleFont: "Vazirmatn:wght@300;400;500;600;700;800",
    badge: "Crisp UI"
  },
  {
    id: "tajawal",
    name: "Tajawal",
    family: "'Tajawal', sans-serif",
    category: "Low-Contrast Modern",
    description: "Crafted for digital products and platforms. Strong horizontal flow that works well in cards and buttons.",
    googleFont: "Tajawal:wght@300;400;500;700;800",
    badge: "Clean Headers"
  },
  {
    id: "almarai",
    name: "Almarai",
    family: "'Almarai', sans-serif",
    category: "Editorial Sans",
    description: "Custom-built for modern media networks and publications. Balanced proportions for extended reading.",
    googleFont: "Almarai:wght@300;400;700;800",
    badge: "Editorial Pick"
  },
  // Naskh & Literary Styles
  {
    id: "amiri",
    name: "Amiri",
    family: "'Amiri', serif",
    category: "Classical Naskh",
    description: "A classical Naskh typeface based on the prestigious Bulaq Press traditions. Refined and dignified for essays.",
    googleFont: "Amiri:wght@400;700",
    badge: "Literary Naskh"
  },
  {
    id: "lateef",
    name: "Lateef",
    family: "'Lateef', serif",
    category: "Casual Naskh",
    description: "Warm, flowing South Asian style Naskh with rounded curves and open counters.",
    googleFont: "Lateef:wght@300;400;600;700",
    badge: "South Asian Naskh"
  }
];

const googleFontsQuery = fonts
  .filter((f) => f.googleFont)
  .map((f) => `family=${f.googleFont}`)
  .join('&');
---

<BaseLayout 
  title="Urdu Font Showcase & Selection — Amir Hameed"
  description="Compare the top 10 Urdu web fonts in action with real text from amirhameed.com."
>
  <!-- Load Google Fonts dynamically -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href={`https://fonts.googleapis.com/css2?${googleFontsQuery}&display=swap`} rel="stylesheet">
  <!-- Load Jameel Noori Nastaleeq from CDN -->
  <link href="https://fonts.cdnfonts.com/css/jameel-noori-nastaleeq" rel="stylesheet">

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <!-- Header -->
    <div class="max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-900/40 mb-4">
        Interactive Typography Lab
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-zinc-900 dark:text-white">
        Urdu Typography Showcase
      </h1>
      <p class="mt-3 text-base text-zinc-600 dark:text-zinc-400 leading-relaxed">
        Test and compare 10 top Urdu web fonts using actual content from your blog. Adjust the font size, type your own text, and select the style that best matches your website.
      </p>
    </div>

    <!-- Interactive Controller Bar -->
    <div class="mt-8 sticky top-20 z-40 p-4 sm:p-5 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white/90 dark:bg-zinc-900/90 backdrop-blur-md shadow-lg shadow-zinc-950/5 space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        
        <!-- Quick Preset selector -->
        <div class="flex items-center gap-2 flex-wrap">
          <span class="text-xs font-mono text-zinc-400">Sample Text:</span>
          <button class="preset-btn px-3 py-1 rounded-lg text-xs font-medium bg-indigo-50 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-400 border border-indigo-200 dark:border-indigo-900" data-text="design">
            چھوٹے ڈیزائن فیصلے
          </button>
          <button class="preset-btn px-3 py-1 rounded-lg text-xs font-medium bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-200 dark:hover:bg-zinc-700" data-text="tech">
            کلاؤڈ کمپیوٹنگ اور ٹیکنالوجی
          </button>
          <button class="preset-btn px-3 py-1 rounded-lg text-xs font-medium bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-200 dark:hover:bg-zinc-700" data-text="philosophy">
            معاشرتی اصلاح اور فہم
          </button>
        </div>

        <!-- Font Size Slider -->
        <div class="flex items-center gap-3">
          <span class="text-xs font-mono text-zinc-400 whitespace-nowrap">Size:</span>
          <input 
            type="range" 
            id="font-size-slider" 
            min="18" 
            max="42" 
            value="26"
            class="w-28 sm:w-36 accent-indigo-600 cursor-pointer"
          />
          <span id="font-size-label" class="text-xs font-mono font-bold text-indigo-600 dark:text-indigo-400 w-8">
            26px
          </span>
        </div>

      </div>

      <!-- Custom Input Box -->
      <div>
        <input 
          type="text" 
          id="custom-urdu-input" 
          dir="rtl"
          value="چھوٹے ڈیزائن فیصلے اور بڑے اثرات: یوزر ایکسپیرینس کا بٹر فلائی افیکٹ" 
          class="w-full px-4 py-2.5 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-950 text-zinc-900 dark:text-white text-base font-serif focus:outline-none focus:ring-2 focus:ring-indigo-500"
          placeholder="یہاں اپنا اردو متن لکھیں..."
        />
      </div>
    </div>

    <!-- Fonts Grid -->
    <div class="mt-8 space-y-8">
      {fonts.map((font, idx) => (
        <div 
          class="font-card p-6 sm:p-8 rounded-3xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/60 shadow-sm transition-all duration-300 hover:border-indigo-500/50 hover:shadow-xl hover:shadow-indigo-500/5"
          data-font-id={font.id}
          data-font-name={font.name}
          data-font-family={font.family}
        >
          <!-- Font Card Header -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-6 border-b border-zinc-100 dark:border-zinc-800/80">
            <div class="flex items-center gap-3 flex-wrap">
              <span class="w-7 h-7 rounded-xl bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center text-xs font-mono font-bold text-zinc-700 dark:text-zinc-300">
                {idx + 1}
              </span>
              <h2 class="text-xl font-bold text-zinc-900 dark:text-white tracking-tight">
                {font.name}
              </h2>
              <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400">
                {font.category}
              </span>
              {font.badge && (
                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-indigo-50 text-indigo-600 dark:bg-indigo-950/60 dark:text-indigo-400 border border-indigo-200/60 dark:border-indigo-900/40">
                  {font.badge}
                </span>
              )}
            </div>

            <button 
              class="select-font-btn px-4 py-1.5 rounded-xl bg-zinc-100 hover:bg-indigo-600 hover:text-white dark:bg-zinc-800 dark:hover:bg-indigo-600 text-xs font-semibold text-zinc-800 dark:text-zinc-200 transition-colors self-start sm:self-auto cursor-pointer"
            >
              Select This Font &rarr;
            </button>
          </div>

          <p class="mt-4 text-xs text-zinc-500 dark:text-zinc-400">
            {font.description}
          </p>

          <!-- Interactive Text Display Area (RTL) -->
          <div class="mt-6 p-6 rounded-2xl bg-zinc-50/70 dark:bg-zinc-950/70 border border-zinc-200/70 dark:border-zinc-800/50 space-y-6" dir="rtl">
            
            <!-- Dynamic Headline -->
            <div>
              <div class="text-[11px] font-mono text-zinc-400 mb-1 text-left" dir="ltr">Heading Preview:</div>
              <h3 
                class="font-sample-headline text-zinc-900 dark:text-white font-bold leading-normal transition-all"
                style={`font-family: ${font.family}; font-size: 26px;`}
              >
                چھوٹے ڈیزائن فیصلے اور بڑے اثرات: یوزر ایکسپیرینس کا بٹر فلائی افیکٹ
              </h3>
            </div>

            <!-- Body Paragraph -->
            <div class="pt-4 border-t border-zinc-200/50 dark:border-zinc-800/50">
              <div class="text-[11px] font-mono text-zinc-400 mb-2 text-left" dir="ltr">Paragraph Reading Preview:</div>
              <p 
                class="font-sample-body text-zinc-700 dark:text-zinc-300 leading-loose text-lg"
                style={`font-family: ${font.family};`}
              >
                ڈیجیٹل دنیا میں بعض اوقات ایک چھوٹا سا ڈیزائن فیصلہ یا چند پکسلز کی تبدیلی، صارف کے مجموعی تجربے پر غیر معمولی اثر ڈال سکتی ہے۔ جب ہم کسی ایپلیکیشن یا ویب سائٹ کی ساخت پر کام کرتے ہیں تو خوبصورتی اور روانی کا توازن ہی کامیابی کی ضمانت بنتا ہے۔
              </p>
            </div>

          </div>

          <!-- Code Snippet -->
          <div class="mt-4 flex items-center justify-between text-xs font-mono text-zinc-400">
            <span class="truncate">font-family: {font.family};</span>
            <span class="text-indigo-600 dark:text-indigo-400">{font.category.split(' ')[0]}</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Modal Notification for Selection -->
    <div id="selection-modal" class="fixed bottom-6 right-6 hidden z-50 p-4 rounded-2xl bg-zinc-900 text-white shadow-2xl border border-zinc-700 flex items-center gap-3">
      <div class="w-8 h-8 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold">✓</div>
      <div>
        <div class="text-xs font-mono text-zinc-400">Choice Recorded</div>
        <div id="modal-font-name" class="text-sm font-bold text-white">Noto Nastaliq Urdu</div>
      </div>
    </div>
  </div>

  <script>
    const slider = document.getElementById('font-size-slider') as HTMLInputElement | null;
    const sizeLabel = document.getElementById('font-size-label');
    const customInput = document.getElementById('custom-urdu-input') as HTMLInputElement | null;
    const headlines = document.querySelectorAll('.font-sample-headline');
    const selectButtons = document.querySelectorAll('.select-font-btn');
    const modal = document.getElementById('selection-modal');
    const modalFontName = document.getElementById('modal-font-name');
    const presetButtons = document.querySelectorAll('.preset-btn');

    const presets: Record<string, string> = {
      design: "چھوٹے ڈیزائن فیصلے اور بڑے اثرات: یوزر ایکسپیرینس کا بٹر فلائی افیکٹ",
      tech: "کلاؤڈ انفراسٹرکچر، سرورلیس کمپیوٹنگ اور ماڈرن ویب ڈیولپمنٹ کا اسٹریٹجک روڈ میپ",
      philosophy: "اسلامی معاشرے کی اصلاح، افکارِ نو اور جدید ڈیجیٹل دنیا میں توازن کا حصول"
    };

    // Font size adjustment
    slider?.addEventListener('input', (e) => {
      const val = (e.target as HTMLInputElement).value;
      if (sizeLabel) sizeLabel.textContent = `${val}px`;
      headlines.forEach((h) => {
        (h as HTMLElement).style.fontSize = `${val}px`;
      });
    });

    // Custom text input
    customInput?.addEventListener('input', (e) => {
      const text = (e.target as HTMLInputElement).value;
      headlines.forEach((h) => {
        h.textContent = text || "یہاں اپنا اردو متن لکھیں...";
      });
    });

    // Preset button clicks
    presetButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        presetButtons.forEach((b) => {
          b.classList.remove('bg-indigo-50', 'dark:bg-indigo-950', 'text-indigo-600', 'dark:text-indigo-400', 'border-indigo-200');
          b.classList.add('bg-zinc-100', 'dark:bg-zinc-800', 'text-zinc-700', 'dark:text-zinc-300');
        });
        btn.classList.add('bg-indigo-50', 'dark:bg-indigo-950', 'text-indigo-600', 'dark:text-indigo-400', 'border-indigo-200');
        btn.classList.remove('bg-zinc-100', 'dark:bg-zinc-800', 'text-zinc-700', 'dark:text-zinc-300');

        const key = btn.getAttribute('data-text') || 'design';
        const txt = presets[key] || presets.design;
        if (customInput) customInput.value = txt;
        headlines.forEach((h) => {
          h.textContent = txt;
        });
      });
    });

    // Select font action
    selectButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const card = (e.target as HTMLElement).closest('.font-card');
        const fontName = card?.getAttribute('data-font-name') || '';
        const fontFamily = card?.getAttribute('data-font-family') || '';

        if (modal && modalFontName) {
          modalFontName.textContent = fontName;
          modal.classList.remove('hidden');
          setTimeout(() => {
            modal.classList.add('hidden');
          }, 3500);
        }

        console.log(`User selected Urdu font: ${fontName} (${fontFamily})`);
      });
    });
  </script>
</BaseLayout>
