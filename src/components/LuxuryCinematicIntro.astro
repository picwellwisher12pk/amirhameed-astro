---
// Luxury Classical Cinematic Fullscreen High-Density Nano-Particle Cloud Intro (WebGL GPU-Accelerated)
// Includes Interactive Particle Placement Studio & Live On-Screen Transform Gizmo
---

<!-- Pitch-black cinematic veil (active during luxury theme entrance) -->
<div
  id="luxury-veil"
  class="fixed inset-0 z-[2] bg-black pointer-events-none transition-opacity duration-1000 opacity-0 hidden"
  aria-hidden="true"
>
</div>

<!-- Massive high-density nano-particle gathering canvas (Fullscreen WebGL) -->
<canvas
  id="luxury-particle-canvas"
  class="fixed inset-0 z-[5] pointer-events-none hidden"
  aria-hidden="true"></canvas>

<!-- Interactive On-Screen Transform Gizmo (Visible when Particle Studio is open) -->
<div
  id="particle-placement-gizmo"
  class="fixed z-40 hidden pointer-events-auto border-2 border-dashed border-[#d4af37]/80 rounded-xl select-none cursor-move transition-[box-shadow] duration-200"
  style="box-shadow: 0 0 35px rgba(212, 175, 55, 0.22), inset 0 0 25px rgba(212, 175, 55, 0.08);"
  aria-label="Particle Image Placement Gizmo"
>
  <!-- Image Info & Coordinate Badge at Top Left -->
  <div
    class="absolute -top-8 left-0 px-2.5 py-1 rounded-md bg-zinc-950/95 border border-[#d4af37]/50 text-[11px] font-mono text-[#d4af37] whitespace-nowrap pointer-events-none flex items-center gap-2 shadow-2xl backdrop-blur-md"
  >
    <span class="w-2 h-2 rounded-full bg-[#d4af37] animate-pulse"></span>
    <span id="gizmo-label" class="font-bold">Image 1</span>
    <span class="text-zinc-600">|</span>
    <span id="gizmo-coords" class="text-zinc-300">X: 68% Y: 50% S: 1.00x</span>
  </div>

  <!-- Center Crosshair & Guideline Indicator -->
  <div
    class="absolute inset-0 flex items-center justify-center pointer-events-none opacity-40"
  >
    <div class="w-6 h-[1px] bg-[#d4af37]"></div>
    <div class="h-6 w-[1px] bg-[#d4af37] absolute"></div>
  </div>

  <!-- Drag Center Helper Instruction -->
  <div
    class="absolute inset-0 flex items-center justify-center pointer-events-none"
  >
    <span
      class="text-[10px] font-mono text-[#d4af37]/40 uppercase tracking-widest bg-zinc-950/40 px-2 py-0.5 rounded"
    >
      Drag to Move · Handles to Scale
    </span>
  </div>

  <!-- 4 Corner Handles for Scaling -->
  <div
    class="gizmo-handle nw absolute -top-2.5 -left-2.5 w-5 h-5 bg-[#d4af37] border-2 border-zinc-950 rounded-md cursor-nwse-resize shadow-lg hover:scale-125 transition-transform"
  >
  </div>
  <div
    class="gizmo-handle ne absolute -top-2.5 -right-2.5 w-5 h-5 bg-[#d4af37] border-2 border-zinc-950 rounded-md cursor-nesw-resize shadow-lg hover:scale-125 transition-transform"
  >
  </div>
  <div
    class="gizmo-handle se absolute -bottom-2.5 -right-2.5 w-5 h-5 bg-[#d4af37] border-2 border-zinc-950 rounded-md cursor-nwse-resize shadow-lg hover:scale-125 transition-transform"
  >
  </div>
  <div
    class="gizmo-handle sw absolute -bottom-2.5 -left-2.5 w-5 h-5 bg-[#d4af37] border-2 border-zinc-950 rounded-md cursor-nesw-resize shadow-lg hover:scale-125 transition-transform"
  >
  </div>

  <!-- 4 Edge Handles -->
  <div
    class="gizmo-handle n absolute -top-2 left-1/2 -translate-x-1/2 w-6 h-3 bg-[#d4af37] border border-zinc-950 rounded cursor-ns-resize shadow-lg hover:scale-110 transition-transform"
  >
  </div>
  <div
    class="gizmo-handle s absolute -bottom-2 left-1/2 -translate-x-1/2 w-6 h-3 bg-[#d4af37] border border-zinc-950 rounded cursor-ns-resize shadow-lg hover:scale-110 transition-transform"
  >
  </div>
  <div
    class="gizmo-handle w absolute top-1/2 -left-2 -translate-y-1/2 w-3 h-6 bg-[#d4af37] border border-zinc-950 rounded cursor-ew-resize shadow-lg hover:scale-110 transition-transform"
  >
  </div>
  <div
    class="gizmo-handle e absolute top-1/2 -right-2 -translate-y-1/2 w-3 h-6 bg-[#d4af37] border border-zinc-950 rounded cursor-ew-resize shadow-lg hover:scale-110 transition-transform"
  >
  </div>
</div>

<!-- Floating Particle Studio Trigger Button (Stacked at bottom-right above Replay button) -->
<button
  id="particle-studio-btn"
  type="button"
  class="fixed bottom-[122px] right-6 z-50 flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-zinc-200 dark:border-zinc-800 bg-white/95 dark:bg-zinc-900/95 text-zinc-800 dark:text-[#d4af37] shadow-xl backdrop-blur-md text-xs font-mono hover:border-[#d4af37] transition-all hover:scale-105 cursor-pointer hidden"
  title="Open Particle Placement Studio (Alt+P)"
>
  <span class="w-2 h-2 rounded-full bg-[#d4af37] animate-pulse"></span>
  <span>✦ Particle Studio</span>
</button>

<!-- Interactive Floating Particle Placement Studio HUD Panel -->
<div
  id="particle-studio-panel"
  class="fixed bottom-24 right-6 z-50 hidden w-[370px] max-w-[calc(100vw-32px)] bg-zinc-950/95 border border-[#d4af37]/35 rounded-2xl shadow-2xl backdrop-blur-xl text-zinc-200 text-xs font-sans overflow-hidden select-none transition-opacity duration-200"
>
  <!-- Studio Header with Drag Bar & Close Button -->
  <div
    class="flex items-center justify-between px-4 py-3 border-b border-zinc-800/80 bg-zinc-900/60 cursor-grab active:cursor-grabbing"
    id="studio-drag-header"
  >
    <div class="flex items-center gap-2">
      <span
        class="w-2.5 h-2.5 rounded-full bg-[#d4af37] shadow-[0_0_8px_#d4af37]"
      ></span>
      <span
        class="font-serif tracking-wider font-semibold text-[#d4af37] uppercase text-[11px]"
        >Particle Placement Studio</span
      >
    </div>
    <div class="flex items-center gap-1.5">
      <span class="text-[10px] font-mono text-zinc-500 hidden sm:inline"
        >Alt+P</span
      >
      <button
        id="studio-close-btn"
        type="button"
        class="p-1 rounded-md text-zinc-400 hover:text-white hover:bg-zinc-800 transition-colors"
        title="Close Panel"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path></svg
        >
      </button>
    </div>
  </div>

  <div class="p-4 space-y-4 max-h-[75vh] overflow-y-auto">
    <!-- Image Selector Tabs -->
    <div>
      <div
        class="text-[10px] uppercase tracking-wider font-mono text-zinc-400 mb-1.5 flex items-center justify-between"
      >
        <span>Active Image</span>
        <span class="text-[#d4af37]/80 font-normal"
          >Select image to configure</span
        >
      </div>
      <div
        id="studio-image-tabs"
        class="grid grid-cols-3 gap-1.5 p-1 bg-zinc-900/90 rounded-xl border border-zinc-800"
      >
        <!-- Rendered dynamically for each image in PARTICLE_CONFIG.images -->
      </div>
    </div>

    <!-- Live Position & Scale Sliders for Active Image -->
    <div class="space-y-3.5 pt-1">
      <!-- Scale Slider -->
      <div>
        <div class="flex items-center justify-between text-xs mb-1">
          <span class="text-zinc-300 font-medium">Scale (Size)</span>
          <span id="studio-scale-val" class="font-mono text-[#d4af37] font-bold"
            >1.00x</span
          >
        </div>
        <input
          id="studio-scale-slider"
          type="range"
          min="0.20"
          max="2.20"
          step="0.01"
          value="1.00"
          class="w-full accent-[#d4af37] h-1.5 bg-zinc-800 rounded-lg appearance-none cursor-pointer"
        />
        <div
          class="flex justify-between text-[10px] text-zinc-500 font-mono mt-0.5"
        >
          <span>0.2x (Small)</span>
          <span>1.0x (Full)</span>
          <span>2.2x (Heroic)</span>
        </div>
      </div>

      <!-- Align X Slider -->
      <div>
        <div class="flex items-center justify-between text-xs mb-1">
          <span class="text-zinc-300 font-medium"
            >Horizontal Position (Align X)</span
          >
          <span
            id="studio-alignx-val"
            class="font-mono text-[#d4af37] font-bold">68%</span
          >
        </div>
        <input
          id="studio-alignx-slider"
          type="range"
          min="0.05"
          max="0.95"
          step="0.005"
          value="0.68"
          class="w-full accent-[#d4af37] h-1.5 bg-zinc-800 rounded-lg appearance-none cursor-pointer"
        />
        <div class="flex gap-1.5 mt-1.5">
          <button
            type="button"
            class="preset-x-btn px-2 py-0.5 rounded bg-zinc-900 border border-zinc-800 hover:border-[#d4af37]/50 text-[10px] text-zinc-400 hover:text-[#d4af37] transition-colors"
            data-val="0.32">Left (32%)</button
          >
          <button
            type="button"
            class="preset-x-btn px-2 py-0.5 rounded bg-zinc-900 border border-zinc-800 hover:border-[#d4af37]/50 text-[10px] text-zinc-400 hover:text-[#d4af37] transition-colors"
            data-val="0.50">Center (50%)</button
          >
          <button
            type="button"
            class="preset-x-btn px-2 py-0.5 rounded bg-zinc-900 border border-zinc-800 hover:border-[#d4af37]/50 text-[10px] text-zinc-400 hover:text-[#d4af37] transition-colors"
            data-val="0.68">Right (68%)</button
          >
        </div>
      </div>

      <!-- Align Y Slider -->
      <div>
        <div class="flex items-center justify-between text-xs mb-1">
          <span class="text-zinc-300 font-medium"
            >Vertical Position (Align Y)</span
          >
          <span
            id="studio-aligny-val"
            class="font-mono text-[#d4af37] font-bold">50%</span
          >
        </div>
        <input
          id="studio-aligny-slider"
          type="range"
          min="0.05"
          max="0.95"
          step="0.005"
          value="0.50"
          class="w-full accent-[#d4af37] h-1.5 bg-zinc-800 rounded-lg appearance-none cursor-pointer"
        />
        <div class="flex gap-1.5 mt-1.5">
          <button
            type="button"
            class="preset-y-btn px-2 py-0.5 rounded bg-zinc-900 border border-zinc-800 hover:border-[#d4af37]/50 text-[10px] text-zinc-400 hover:text-[#d4af37] transition-colors"
            data-val="0.35">Top (35%)</button
          >
          <button
            type="button"
            class="preset-y-btn px-2 py-0.5 rounded bg-zinc-900 border border-zinc-800 hover:border-[#d4af37]/50 text-[10px] text-zinc-400 hover:text-[#d4af37] transition-colors"
            data-val="0.50">Center (50%)</button
          >
          <button
            type="button"
            class="preset-y-btn px-2 py-0.5 rounded bg-zinc-900 border border-zinc-800 hover:border-[#d4af37]/50 text-[10px] text-zinc-400 hover:text-[#d4af37] transition-colors"
            data-val="0.65">Bottom (65%)</button
          >
        </div>
      </div>
    </div>

    <!-- On-Screen Drag Gizmo Toggle -->
    <div
      class="pt-2 border-t border-zinc-800/80 flex items-center justify-between"
    >
      <label class="flex items-center gap-2 cursor-pointer">
        <input
          id="studio-toggle-gizmo"
          type="checkbox"
          checked
          class="accent-[#d4af37] rounded cursor-pointer"
        />
        <span class="text-xs text-zinc-300 font-medium"
          >On-Screen Interactive Drag Box</span
        >
      </label>
      <span class="text-[10px] text-zinc-500 font-mono">Move on Canvas</span>
    </div>

    <!-- Live Scroll / Morph Scrubbing Preview Slider -->
    <div class="pt-2 border-t border-zinc-800/80">
      <div class="flex items-center justify-between text-xs mb-1">
        <span class="text-zinc-300 font-medium">Scroll / Morph Scrub</span>
        <div class="flex items-center gap-2">
          <span id="studio-morph-val" class="font-mono text-zinc-400">0%</span>
          <button
            id="studio-sync-scroll-btn"
            type="button"
            class="text-[10px] font-mono text-[#d4af37] hover:underline"
            title="Return to following page scroll"
          >
            Sync Scroll
          </button>
        </div>
      </div>
      <input
        id="studio-morph-slider"
        type="range"
        min="0"
        max="100"
        step="0.5"
        value="0"
        class="w-full accent-[#d4af37] h-1.5 bg-zinc-800 rounded-lg appearance-none cursor-pointer"
      />
      <div
        id="studio-morph-markers"
        class="flex justify-between text-[10px] text-zinc-500 font-mono mt-0.5"
      >
        <!-- Markers dynamically rendered -->
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="pt-2 border-t border-zinc-800/80 flex flex-col gap-2">
      <div class="grid grid-cols-2 gap-2">
        <button
          id="studio-copy-btn"
          type="button"
          class="flex items-center justify-center gap-1.5 py-2 px-3 rounded-xl bg-[#d4af37]/20 hover:bg-[#d4af37]/30 border border-[#d4af37]/50 text-[#d4af37] font-mono text-[11px] font-semibold transition-all cursor-pointer"
        >
          <svg
            class="w-3.5 h-3.5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
            ></path></svg
          >
          <span id="studio-copy-text">Copy Code</span>
        </button>
        <button
          id="studio-save-btn"
          type="button"
          class="flex items-center justify-center gap-1.5 py-2 px-3 rounded-xl bg-zinc-900 hover:bg-zinc-800 border border-zinc-700 text-zinc-200 font-mono text-[11px] transition-all cursor-pointer"
        >
          <span id="studio-save-text">Save to Browser</span>
        </button>
      </div>
      <button
        id="studio-reset-btn"
        type="button"
        class="w-full py-1 text-[10px] text-zinc-500 hover:text-rose-400 font-mono transition-colors text-center cursor-pointer"
      >
        Reset All Images to Default Positions
      </button>
    </div>
  </div>
</div>

<script>
  // =========================================================================
  // 🎛️ LUXURY PARTICLE SYSTEM CONFIGURATION - TWEAK ANY SETTING FREELY
  // =========================================================================
  const DEFAULT_IMAGE_LAYOUTS = [
    {
      scale: 1.0936430948476303,
      alignX: 0.7600426894343649,
      alignY: 0.48698481561822127,
    },
    {
      scale: 1.047331014887852,
      alignX: 0.7465314834578441,
      alignY: 0.48590021691973967,
    },
    {
      scale: 1.1170019439785475,
      alignX: 0.8046424759871932,
      alignY: 0.4436008676789588,
    },
  ];

  const PARTICLE_CONFIG = {
    // 1. POSITIONING & SIZING PER IMAGE (Interactive Placement Studio updates these live!)
    imageLayouts: JSON.parse(JSON.stringify(DEFAULT_IMAGE_LAYOUTS)),

    // 2. CURSOR REVOLVING & INTERACTION PARAMETERS
    cursorRadius: 90.0, // Distance parameter: radius of influence around cursor (in pixels)
    cursorFeather: 0.2, // Feather parameter: 0.0 = sharp circle, 1.0 = ultra soft gradient feather
    revolveSpeed: 2.8, // Revolving speed parameter: how fast particles swirl/revolve around cursor
    repelStrength: 10.0, // Repulsion cushion: soft distance keeping particles from collapsing into cursor
    returnSpeed: 0.015, // Elastic return speed when cursor moves away

    // 3. OPACITY & TEXT CONTRAST (50% dimming after animation completes)
    initialOpacity: 1.0, // 100% full vibrant particle brightness during intro gathering
    settledDimOpacity: 0.5, // 50% opacity reduction once elements finish animating in so text is crisp
    dimTransitionDuration: 1.4, // Duration in seconds to smoothly transition from 100% to 50%

    // 4. TIMING & GRADUAL SEQUENTIAL REVEAL
    introGatherDuration: 2200, // Duration in ms for particle flight and assembly
    elementStaggerDelay: 320, // Stagger interval between each element fading/drifting in

    // 5. SCROLL ARCHITECTURE & MULTI-PICTURE MORPHING
    fixedInViewport: true, // Particles always remain in sight when scrolling (don't scroll off screen)
    morphPlateau: 0.2, // Resting share for each picture (20% settled zone, 60% morphing zone)
    images: [
      "/images/amir-portrait-luxury.jpg", // Screen 1 picture (current portrait)
      "/images/2.jpg", // Screen 2 picture
      "/images/3.jpg", // Screen 3 picture
    ],
  };

  // Restore saved layouts from localStorage if available
  function restoreSavedLayouts() {
    try {
      const raw = localStorage.getItem("luxury_particle_layouts");
      if (raw) {
        const parsed = JSON.parse(raw);
        if (Array.isArray(parsed)) {
          parsed.forEach((layout, i) => {
            if (layout && typeof layout.scale === "number") {
              PARTICLE_CONFIG.imageLayouts[i] = {
                scale: layout.scale,
                alignX: layout.alignX,
                alignY: layout.alignY,
              };
            }
          });
        }
      }
    } catch (e) {
      console.warn("Could not restore particle layouts from localStorage", e);
    }
  }
  restoreSavedLayouts();

  function saveLayoutsToStorage() {
    try {
      localStorage.setItem(
        "luxury_particle_layouts",
        JSON.stringify(PARTICLE_CONFIG.imageLayouts),
      );
    } catch (e) {
      console.warn("Could not save particle layouts to localStorage", e);
    }
  }

  function getImageLayout(index: number) {
    if (PARTICLE_CONFIG.imageLayouts[index]) {
      return PARTICLE_CONFIG.imageLayouts[index];
    }
    const fallback = { scale: 1.0, alignX: 0.5, alignY: 0.5 };
    PARTICLE_CONFIG.imageLayouts[index] = fallback;
    return fallback;
  }

  // Expose configuration globally for testing & tweaking: window.PARTICLE_CONFIG
  (window as any).PARTICLE_CONFIG = PARTICLE_CONFIG;

  // WebGL Shaders with Dynamic Per-Image Transforms & Orbital Cursor Revolving
  const VS_SOURCE = `
    attribute vec2 a_targetA;
    attribute vec3 a_colorA;
    attribute vec2 a_targetB;
    attribute vec3 a_colorB;
    attribute vec2 a_origin;
    attribute vec4 a_params; // x: delay, y: duration, z: size, w: curl

    uniform float u_time;
    uniform vec2 u_resolution;
    uniform vec2 u_mouse;
    uniform float u_mouse_active;
    uniform float u_cursor_radius;
    uniform float u_cursor_feather;
    uniform float u_revolve_speed;
    uniform float u_repel_strength;
    uniform float u_dim_factor;
    uniform float u_morph_t; // 0.0 to 1.0 morph between Image A and Image B

    // Dynamic Live Transforms (Scale and Center per Image)
    uniform vec2 u_centerA;
    uniform float u_sizeA;
    uniform vec2 u_centerB;
    uniform float u_sizeB;

    varying vec3 v_color;
    varying float v_alpha;

    void main() {
      float delay = a_params.x;
      float duration = a_params.y;
      float size = a_params.z;
      float curl = a_params.w;

      float pElapsed = max(0.0, u_time - delay);
      float progress = clamp(pElapsed / duration, 0.0, 1.0);

      // Smooth quintic ease out for majestic cinematic gathering
      float t = 1.0 - progress;
      float ease = 1.0 - t * t * t * t;

      // Dynamically compute screen pixel target coordinates from normalized coordinates
      vec2 targetPosA = u_centerA + a_targetA * u_sizeA;
      vec2 targetPosB = u_centerB + a_targetB * u_sizeB;

      // Morph between Picture A and Picture B with organic celestial swirl
      float morphSwirl = sin(u_morph_t * 3.14159265);
      vec2 morphDiff = targetPosB - targetPosA;
      vec2 morphPerp = vec2(-morphDiff.y, morphDiff.x) * 0.18 * curl;
      vec2 morphedTarget = mix(targetPosA, targetPosB, u_morph_t) + morphPerp * morphSwirl;
      vec3 morphedColor = mix(a_colorA, a_colorB, u_morph_t);

      // Organic bidirectional vortex curl during gathering flight
      float swirlAngle = (1.0 - ease) * curl;
      vec2 diff = a_origin - morphedTarget;
      float cosA = cos(swirlAngle);
      float sinA = sin(swirlAngle);
      vec2 rotatedDiff = vec2(
        diff.x * cosA - diff.y * sinA,
        diff.x * sinA + diff.y * cosA
      );
      vec2 currentOrigin = morphedTarget + rotatedDiff;
      vec2 pos = mix(currentOrigin, morphedTarget, ease);

      // Subtle breathing ambient shimmer when settled
      if (progress >= 1.0) {
        float shimmer = sin(u_time * 0.002 + morphedTarget.x * 0.01 + morphedTarget.y * 0.01) * 0.6;
        pos.y += shimmer;
      }

      // Dynamic cursor revolving physics with feathering
      if (u_mouse_active > 0.01) {
        vec2 toMouse = pos - u_mouse;
        float d = length(toMouse);
        if (d < u_cursor_radius && d > 0.01) {
          float ratio = d / u_cursor_radius;
          float featherStart = max(0.0, 1.0 - u_cursor_feather);
          float falloff = 1.0 - smoothstep(featherStart, 1.0, ratio);

          // True celestial orbital revolving around cursor
          float revolveAngle = u_time * 0.003 * u_revolve_speed * falloff;
          float cosR = cos(revolveAngle);
          float sinR = sin(revolveAngle);
          vec2 rotatedToMouse = vec2(
            toMouse.x * cosR - toMouse.y * sinR,
            toMouse.x * sinR + toMouse.y * cosR
          );

          // Gentle repulsive cushion so particles orbit as a disk rather than collapsing
          float push = u_repel_strength * falloff * (1.0 - ratio);
          vec2 orbitPos = u_mouse + normalize(rotatedToMouse) * (d + push);
          pos = mix(pos, orbitPos, falloff * u_mouse_active);
        }
      }

      // Map to clip space (-1 to 1)
      vec2 zeroToOne = pos / u_resolution;
      vec2 zeroToTwo = zeroToOne * 2.0;
      vec2 clipSpace = zeroToTwo - 1.0;
      clipSpace.y = -clipSpace.y; // Invert Y for screen

      gl_Position = vec4(clipSpace, 0.0, 1.0);
      gl_PointSize = size * (1.0 + (1.0 - progress) * 0.6);

      v_color = morphedColor;
      v_alpha = min(1.0, pElapsed / 250.0) * u_dim_factor;
    }
  `;

  const FS_SOURCE = `
    precision mediump float;
    varying vec3 v_color;
    varying float v_alpha;

    void main() {
      // Circular nano particle with soft stardust glow
      vec2 coord = gl_PointCoord - vec2(0.5);
      float dist = length(coord);
      if (dist > 0.5) discard;
      float soft = smoothstep(0.5, 0.1, dist);
      gl_FragColor = vec4(v_color, v_alpha * soft);
    }
  `;

  let currentAnimId: number | null = null;
  let targetMouseX = -9999;
  let targetMouseY = -9999;
  let mouseX = -9999;
  let mouseY = -9999;

  // Window-level mouse tracking for effortless cursor interaction
  window.addEventListener(
    "pointermove",
    (e: MouseEvent | PointerEvent) => {
      targetMouseX = e.clientX;
      targetMouseY = e.clientY;
    },
    { passive: true },
  );

  window.addEventListener("pointerleave", () => {
    targetMouseX = -9999;
    targetMouseY = -9999;
  });

  // Pre-load all images configured in PARTICLE_CONFIG.images
  async function loadAllConfigImages(
    srcList: string[],
  ): Promise<HTMLImageElement[]> {
    const list =
      srcList && srcList.length > 0
        ? srcList
        : ["/images/amir-portrait-luxury.jpg"];
    const promises = list.map((src) => {
      return new Promise<HTMLImageElement>((resolve) => {
        const img = new Image();
        img.crossOrigin = "anonymous";
        img.onload = () => resolve(img);
        img.onerror = () => {
          console.warn(`[LuxuryParticles] Could not load image: ${src}`);
          resolve(img);
        };
        img.src = src;
      });
    });
    return Promise.all(promises);
  }

  // Sample target positions and colors for any image in NORMALIZED image coordinates (nx, ny)
  function sampleImageTargets(
    img: HTMLImageElement,
    particleCount: number,
  ): Float32Array {
    const imgW = img.naturalWidth || 1800;
    const imgH = img.naturalHeight || 1800;
    const imgAspect = imgW / imgH;

    const sampleW = 400;
    const sampleH = Math.max(250, Math.round(400 / imgAspect));
    const offscreen = document.createElement("canvas");
    offscreen.width = sampleW;
    offscreen.height = sampleH;
    const offCtx = offscreen.getContext("2d");

    const buffer = new Float32Array(particleCount * 5); // 5 floats: nx, ny, r, g, b

    if (!offCtx || imgW === 0 || imgH === 0) {
      // Fallback
      for (let i = 0; i < particleCount; i++) {
        buffer[i * 5] = (Math.random() - 0.5) * imgAspect;
        buffer[i * 5 + 1] = Math.random() - 0.5;
        buffer[i * 5 + 2] = 0.96;
        buffer[i * 5 + 3] = 0.84;
        buffer[i * 5 + 4] = 0.43;
      }
      return buffer;
    }

    offCtx.drawImage(img, 0, 0, sampleW, sampleH);
    const imgData = offCtx.getImageData(0, 0, sampleW, sampleH).data;
    const totalPixels = sampleW * sampleH;

    const cdf = new Float64Array(totalPixels);
    let runningSum = 0;

    for (let i = 0; i < totalPixels; i++) {
      const idx = i * 4;
      const r = imgData[idx] / 255;
      const g = imgData[idx + 1] / 255;
      const b = imgData[idx + 2] / 255;
      const a = imgData[idx + 3] / 255;

      const lum = 0.299 * r + 0.587 * g + 0.114 * b;
      let weight = 0;

      if (a > 0.08) {
        if (lum > 0.04) {
          weight = (Math.pow(lum, 0.82) * 1.2 + 0.12) * a;
        } else if (r > 0.02 || g > 0.02 || b > 0.02) {
          weight = 0.05 * a;
        }
      }

      runningSum += weight;
      cdf[i] = runningSum;
    }

    const totalWeight = runningSum > 0 ? runningSum : 1;

    for (let p = 0; p < particleCount; p++) {
      const rnd = Math.random() * totalWeight;

      let low = 0;
      let high = totalPixels - 1;
      while (low < high) {
        const mid = (low + high) >> 1;
        if (cdf[mid] < rnd) {
          low = mid + 1;
        } else {
          high = mid;
        }
      }

      const pixelIndex = low;
      const py = Math.floor(pixelIndex / sampleW);
      const px = pixelIndex % sampleW;

      // Sub-pixel continuous random jitter: completely eliminates grid
      const subX = px + Math.random();
      const subY = py + Math.random();

      // Normalized coordinates centered at (0, 0):
      // nx ranges from -0.5 * imgAspect to +0.5 * imgAspect
      // ny ranges from -0.5 to +0.5
      const nx = (subX / sampleW - 0.5) * imgAspect;
      const ny = subY / sampleH - 0.5;

      const samplePx = Math.min(sampleW - 1, Math.max(0, Math.floor(subX)));
      const samplePy = Math.min(sampleH - 1, Math.max(0, Math.floor(subY)));
      const byteIdx = (samplePy * sampleW + samplePx) * 4;
      const r = imgData[byteIdx] / 255;
      const g = imgData[byteIdx + 1] / 255;
      const b = imgData[byteIdx + 2] / 255;

      const isGold = Math.random() < 0.14;
      const finalR = isGold ? 0.96 : r;
      const finalG = isGold ? 0.84 : g;
      const finalB = isGold ? 0.43 : b;

      const base = p * 5;
      buffer[base] = nx;
      buffer[base + 1] = ny;
      buffer[base + 2] = finalR;
      buffer[base + 3] = finalG;
      buffer[base + 4] = finalB;
    }

    return buffer;
  }

  // State for Interactive Particle Placement Studio
  let studioActive = false;
  let studioGizmoVisible = true;
  let studioManualMorph: number | null = null;
  let selectedImageIdx = 0;
  let activeImageAspects: number[] = [];

  async function initLuxuryCinematicIntro() {
    if (currentAnimId) {
      cancelAnimationFrame(currentAnimId);
      currentAnimId = null;
    }

    const isLuxury =
      document.documentElement.getAttribute("data-theme") === "luxury";
    const veil = document.getElementById("luxury-veil");
    const canvas = document.getElementById(
      "luxury-particle-canvas",
    ) as HTMLCanvasElement | null;
    const portraitImg = document.getElementById(
      "luxury-portrait-img",
    ) as HTMLImageElement | null;
    const morpher = document.getElementById("luxury-morphing-container");
    const studioBtn = document.getElementById("particle-studio-btn");

    if (!isLuxury || !canvas) {
      document.documentElement.classList.remove("luxury-animating");
      veil?.classList.add("hidden");
      canvas?.classList.add("hidden");
      studioBtn?.classList.add("hidden");
      closeStudioPanel();
      if (portraitImg) {
        portraitImg.style.opacity = "1";
        portraitImg.style.display = "";
      }
      if (morpher) morpher.style.opacity = "1";
      return;
    }

    // Set initial black screen & animating state
    document.documentElement.classList.add("luxury-animating");
    veil?.classList.remove("hidden");
    veil?.classList.remove("opacity-0");
    veil?.classList.add("opacity-100");
    canvas.classList.remove("hidden");
    canvas.style.opacity = "1";
    studioBtn?.classList.remove("hidden");

    // Keep final JPEG hidden in luxury mode - live particles are the portrait
    if (portraitImg) {
      portraitImg.style.opacity = "0";
      portraitImg.style.display = "none";
    }
    if (morpher) morpher.style.display = "none";

    const screenW = window.innerWidth;
    const screenH = window.innerHeight;
    canvas.width = screenW;
    canvas.height = screenH;

    const gl = (canvas.getContext("webgl") ||
      canvas.getContext("experimental-webgl")) as WebGLRenderingContext | null;

    if (!gl) {
      fallbackCanvas2D(canvas, veil);
      return;
    }

    // Load ALL pictures configured in PARTICLE_CONFIG.images
    const loadedImages = await loadAllConfigImages(PARTICLE_CONFIG.images);
    if (!loadedImages || loadedImages.length === 0) {
      fallbackCanvas2D(canvas, veil);
      return;
    }

    // Store aspect ratios
    activeImageAspects = loadedImages.map(
      (img) => (img.naturalWidth || 1800) / (img.naturalHeight || 1800),
    );

    // Setup Interactive Studio UI listeners
    setupInteractiveStudioUI();

    runWebGLMultiPointCloud(gl, canvas, loadedImages, veil);
  }

  function createShader(
    gl: WebGLRenderingContext,
    type: number,
    source: string,
  ) {
    const shader = gl.createShader(type);
    if (!shader) return null;
    gl.shaderSource(shader, source);
    gl.compileShader(shader);
    if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
      console.error(gl.getShaderInfoLog(shader));
      gl.deleteShader(shader);
      return null;
    }
    return shader;
  }

  function runWebGLMultiPointCloud(
    gl: WebGLRenderingContext,
    canvas: HTMLCanvasElement,
    loadedImages: HTMLImageElement[],
    veil: HTMLElement | null,
  ) {
    const vs = createShader(gl, gl.VERTEX_SHADER, VS_SOURCE);
    const fs = createShader(gl, gl.FRAGMENT_SHADER, FS_SOURCE);
    if (!vs || !fs) return;

    const program = gl.createProgram();
    if (!program) return;
    gl.attachShader(program, vs);
    gl.attachShader(program, fs);
    gl.linkProgram(program);
    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
      console.error(gl.getProgramInfoLog(program));
      return;
    }
    gl.useProgram(program);

    const screenW = canvas.width;
    const screenH = canvas.height;

    const isMobile = screenW < 768;
    const TARGET_PARTICLES = isMobile ? 48000 : 92000;

    // 1. Sample target buffers in NORMALIZED image coordinates
    const targetBuffers = loadedImages.map((img) =>
      sampleImageTargets(img, TARGET_PARTICLES),
    );

    // 2. Upload target VBOs for each image
    const targetVBOs = targetBuffers.map((buffer) => {
      const vbo = gl.createBuffer();
      gl.bindBuffer(gl.ARRAY_BUFFER, vbo);
      gl.bufferData(gl.ARRAY_BUFFER, buffer, gl.STATIC_DRAW);
      return vbo;
    });

    // 3. Base buffer: origins (ox, oy) and flight params (delay, duration, size, curl)
    const baseBuffer = new Float32Array(TARGET_PARTICLES * 6);
    for (let p = 0; p < TARGET_PARTICLES; p++) {
      const ox = (Math.random() * 1.3 - 0.15) * screenW;
      const oy = (Math.random() * 1.3 - 0.15) * screenH;
      const delay = Math.random() * 650;
      const duration = 1500 + Math.random() * 500;
      const size = Math.random() * 1.3 + 0.9;
      const curl =
        (Math.random() < 0.5 ? -1.0 : 1.0) * (0.8 + Math.random() * 1.4);

      const base = p * 6;
      baseBuffer[base] = ox;
      baseBuffer[base + 1] = oy;
      baseBuffer[base + 2] = delay;
      baseBuffer[base + 3] = duration;
      baseBuffer[base + 4] = size;
      baseBuffer[base + 5] = curl;
    }

    const baseVBO = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, baseVBO);
    gl.bufferData(gl.ARRAY_BUFFER, baseBuffer, gl.STATIC_DRAW);

    // Attribute Locations
    const aTargetALoc = gl.getAttribLocation(program, "a_targetA");
    const aColorALoc = gl.getAttribLocation(program, "a_colorA");
    const aTargetBLoc = gl.getAttribLocation(program, "a_targetB");
    const aColorBLoc = gl.getAttribLocation(program, "a_colorB");
    const aOriginLoc = gl.getAttribLocation(program, "a_origin");
    const aParamsLoc = gl.getAttribLocation(program, "a_params");

    // Uniform Locations
    const uTimeLoc = gl.getUniformLocation(program, "u_time");
    const uResolutionLoc = gl.getUniformLocation(program, "u_resolution");
    const uMouseLoc = gl.getUniformLocation(program, "u_mouse");
    const uMouseActiveLoc = gl.getUniformLocation(program, "u_mouse_active");
    const uCursorRadiusLoc = gl.getUniformLocation(program, "u_cursor_radius");
    const uCursorFeatherLoc = gl.getUniformLocation(
      program,
      "u_cursor_feather",
    );
    const uRevolveSpeedLoc = gl.getUniformLocation(program, "u_revolve_speed");
    const uRepelStrengthLoc = gl.getUniformLocation(
      program,
      "u_repel_strength",
    );
    const uDimFactorLoc = gl.getUniformLocation(program, "u_dim_factor");
    const uMorphTLoc = gl.getUniformLocation(program, "u_morph_t");

    // Dynamic Live Transform Uniforms
    const uCenterALoc = gl.getUniformLocation(program, "u_centerA");
    const uSizeALoc = gl.getUniformLocation(program, "u_sizeA");
    const uCenterBLoc = gl.getUniformLocation(program, "u_centerB");
    const uSizeBLoc = gl.getUniformLocation(program, "u_sizeB");

    gl.enable(gl.BLEND);
    gl.blendFunc(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA);

    let startTime: number | null = null;
    let elementsRevealed = false;
    let mouseActive = 0.0;
    let dimStartTime: number | null = null;

    function render(timestamp: number) {
      if (!startTime) startTime = timestamp;
      const elapsed = timestamp - startTime;

      // Handle window resize dynamically without re-sampling
      const curW = window.innerWidth;
      const curH = window.innerHeight;
      if (canvas.width !== curW || canvas.height !== curH) {
        canvas.width = curW;
        canvas.height = curH;
      }

      // Smooth mouse position for fluid cursor interaction
      if (targetMouseX > -5000) {
        if (mouseX < -5000) {
          mouseX = targetMouseX;
          mouseY = targetMouseY;
        } else {
          mouseX += (targetMouseX - mouseX) * PARTICLE_CONFIG.returnSpeed;
          mouseY += (targetMouseY - mouseY) * PARTICLE_CONFIG.returnSpeed;
        }
      } else {
        mouseX = -9999;
        mouseY = -9999;
      }

      // Smoothly activate cursor interaction as particles finish assembling
      if (elapsed > 1600) {
        mouseActive = Math.min(1.0, mouseActive + 0.03);
      }

      // Smooth 50% opacity dimming after all elements animate in
      let currentDim = PARTICLE_CONFIG.initialOpacity;
      if (dimStartTime !== null) {
        const dimElapsed = (timestamp - dimStartTime) / 1000;
        const dimProgress = Math.min(
          1.0,
          Math.max(0.0, dimElapsed / PARTICLE_CONFIG.dimTransitionDuration),
        );
        const dimEase = dimProgress * dimProgress * (3.0 - 2.0 * dimProgress);
        currentDim =
          PARTICLE_CONFIG.initialOpacity +
          (PARTICLE_CONFIG.settledDimOpacity - PARTICLE_CONFIG.initialOpacity) *
            dimEase;
      }

      // Calculate scroll fraction or use Studio manual scrub
      const numImages = targetVBOs.length;
      let imgIndexA = 0;
      let imgIndexB = 0;
      let morphT = 0.0;

      if (numImages > 1) {
        let scrollFraction = 0.0;

        if (studioManualMorph !== null) {
          scrollFraction = studioManualMorph;
        } else {
          const scrollY = window.scrollY || window.pageYOffset || 0;
          const docHeight = document.documentElement.scrollHeight;
          const winHeight = window.innerHeight;
          const maxScroll = Math.max(1, docHeight - winHeight);
          scrollFraction = Math.min(1.0, Math.max(0.0, scrollY / maxScroll));
        }

        const totalSegments = numImages - 1;
        const rawSegmentPos = scrollFraction * totalSegments;
        imgIndexA = Math.min(numImages - 2, Math.floor(rawSegmentPos));
        imgIndexB = imgIndexA + 1;
        const localSegmentT = rawSegmentPos - imgIndexA; // 0.0 to 1.0

        // Plateau zone where picture is settled, and smooth morph in between
        const plateau = PARTICLE_CONFIG.morphPlateau || 0.2;
        if (localSegmentT <= plateau) {
          morphT = 0.0;
        } else if (localSegmentT >= 1.0 - plateau) {
          morphT = 1.0;
        } else {
          const norm = (localSegmentT - plateau) / (1.0 - 2.0 * plateau);
          morphT = norm * norm * (3.0 - 2.0 * norm);
        }
      }

      // Compute dynamic scale and center for Image A and Image B
      const layoutA = getImageLayout(imgIndexA);
      const layoutB = getImageLayout(imgIndexB);

      const sizeA = curH * layoutA.scale;
      const centerAX = curW * layoutA.alignX;
      const centerAY = curH * layoutA.alignY;

      const sizeB = curH * layoutB.scale;
      const centerBX = curW * layoutB.alignX;
      const centerBY = curH * layoutB.alignY;

      gl.viewport(0, 0, curW, curH);
      gl.clearColor(0.0, 0.0, 0.0, 0.0);
      gl.clear(gl.COLOR_BUFFER_BIT);

      gl.uniform1f(uTimeLoc, elapsed);
      gl.uniform2f(uResolutionLoc, curW, curH);
      gl.uniform2f(uMouseLoc, mouseX, mouseY);
      gl.uniform1f(uMouseActiveLoc, mouseActive);
      gl.uniform1f(uCursorRadiusLoc, PARTICLE_CONFIG.cursorRadius);
      gl.uniform1f(uCursorFeatherLoc, PARTICLE_CONFIG.cursorFeather);
      gl.uniform1f(uRevolveSpeedLoc, PARTICLE_CONFIG.revolveSpeed);
      gl.uniform1f(uRepelStrengthLoc, PARTICLE_CONFIG.repelStrength);
      gl.uniform1f(uDimFactorLoc, currentDim);
      gl.uniform1f(uMorphTLoc, morphT);

      // Pass Dynamic Live Transform Uniforms to GPU
      gl.uniform2f(uCenterALoc, centerAX, centerAY);
      gl.uniform1f(uSizeALoc, sizeA);
      gl.uniform2f(uCenterBLoc, centerBX, centerBY);
      gl.uniform1f(uSizeBLoc, sizeB);

      // Bind Target A (nx, ny, r, g, b)
      const vboA = targetVBOs[imgIndexA];
      gl.bindBuffer(gl.ARRAY_BUFFER, vboA);
      gl.enableVertexAttribArray(aTargetALoc);
      gl.vertexAttribPointer(aTargetALoc, 2, gl.FLOAT, false, 5 * 4, 0);
      gl.enableVertexAttribArray(aColorALoc);
      gl.vertexAttribPointer(aColorALoc, 3, gl.FLOAT, false, 5 * 4, 2 * 4);

      // Bind Target B (nx, ny, r, g, b)
      const vboB = targetVBOs[imgIndexB];
      gl.bindBuffer(gl.ARRAY_BUFFER, vboB);
      gl.enableVertexAttribArray(aTargetBLoc);
      gl.vertexAttribPointer(aTargetBLoc, 2, gl.FLOAT, false, 5 * 4, 0);
      gl.enableVertexAttribArray(aColorBLoc);
      gl.vertexAttribPointer(aColorBLoc, 3, gl.FLOAT, false, 5 * 4, 2 * 4);

      // Bind Base (ox, oy, delay, duration, size, curl)
      gl.bindBuffer(gl.ARRAY_BUFFER, baseVBO);
      gl.enableVertexAttribArray(aOriginLoc);
      gl.vertexAttribPointer(aOriginLoc, 2, gl.FLOAT, false, 6 * 4, 0);
      gl.enableVertexAttribArray(aParamsLoc);
      gl.vertexAttribPointer(aParamsLoc, 4, gl.FLOAT, false, 6 * 4, 2 * 4);

      gl.drawArrays(gl.POINTS, 0, TARGET_PARTICLES);

      // Keep gizmo overlay synced with selected image
      if (studioActive && studioGizmoVisible) {
        updateGizmoPosition(curW, curH);
      }

      // Once particles assemble to make the picture (~2200ms)
      if (elapsed > PARTICLE_CONFIG.introGatherDuration && !elementsRevealed) {
        elementsRevealed = true;
        if (veil) {
          veil.classList.add("opacity-0");
          setTimeout(() => veil.classList.add("hidden"), 1000);
        }

        // Gradually reveal header & hero elements one by one!
        revealSequentialElements(() => {
          setTimeout(() => {
            dimStartTime = performance.now();
          }, 300);
        });
      }

      currentAnimId = requestAnimationFrame(render);
    }

    currentAnimId = requestAnimationFrame(render);
  }

  function fallbackCanvas2D(
    canvas: HTMLCanvasElement,
    veil: HTMLElement | null,
  ) {
    if (veil) {
      veil.classList.add("opacity-0");
      setTimeout(() => veil.classList.add("hidden"), 900);
    }
    revealSequentialElements();
  }

  // Gradual, graceful sequential reveal of header and hero elements
  function revealSequentialElements(onAllRevealed?: () => void) {
    const header = document.querySelector("header");
    const seq1 = document.querySelector(".luxury-seq-1");
    const seq2 = document.querySelector(".luxury-seq-2");
    const seq3 = document.querySelector(".luxury-seq-3");
    const seq4 = document.querySelector(".luxury-seq-4");
    const seq5 = document.querySelector(".luxury-seq-5");
    const replayBtn = document.getElementById("replay-luxury-btn");
    const studioBtn = document.getElementById("particle-studio-btn");
    const scrollIndicator = document.getElementById("luxury-scroll-indicator");
    const themeSwitcher = document.getElementById("theme-switcher-widget");
    const fontTester = document.getElementById("font-tester-root");
    const seqRest = document.querySelectorAll(".luxury-seq-rest");
    const footer = document.querySelector("footer");

    const stagger = PARTICLE_CONFIG.elementStaggerDelay;

    setTimeout(() => header?.classList.add("luxury-revealed"), 100);
    setTimeout(() => seq1?.classList.add("luxury-revealed"), 100 + stagger);
    setTimeout(() => seq2?.classList.add("luxury-revealed"), 100 + stagger * 2);
    setTimeout(() => seq3?.classList.add("luxury-revealed"), 100 + stagger * 3);
    setTimeout(() => seq4?.classList.add("luxury-revealed"), 100 + stagger * 4);
    setTimeout(
      () => {
        seq5?.classList.add("luxury-revealed");
        replayBtn?.classList.add("luxury-revealed");
        studioBtn?.classList.add("luxury-revealed");
      },
      100 + stagger * 5,
    );

    const finalDelay = 100 + stagger * 6;
    setTimeout(() => {
      scrollIndicator?.classList.add("luxury-revealed");
      themeSwitcher?.classList.add("luxury-revealed");
      fontTester?.classList.add("luxury-revealed");
      footer?.classList.add("luxury-revealed");
      seqRest.forEach((el) => el.classList.add("luxury-revealed"));
      document.documentElement.classList.remove("luxury-animating");

      if (onAllRevealed) {
        onAllRevealed();
      }
    }, finalDelay);
  }

  // =========================================================================
  // 🛠️ INTERACTIVE PARTICLE PLACEMENT STUDIO & GIZMO CONTROLLER
  // =========================================================================
  function setupInteractiveStudioUI() {
    const studioBtn = document.getElementById("particle-studio-btn");
    const studioPanel = document.getElementById("particle-studio-panel");
    const studioCloseBtn = document.getElementById("studio-close-btn");
    const imageTabsContainer = document.getElementById("studio-image-tabs");
    const morphMarkersContainer = document.getElementById(
      "studio-morph-markers",
    );
    const scaleSlider = document.getElementById(
      "studio-scale-slider",
    ) as HTMLInputElement | null;
    const alignXSlider = document.getElementById(
      "studio-alignx-slider",
    ) as HTMLInputElement | null;
    const alignYSlider = document.getElementById(
      "studio-aligny-slider",
    ) as HTMLInputElement | null;
    const morphSlider = document.getElementById(
      "studio-morph-slider",
    ) as HTMLInputElement | null;
    const toggleGizmo = document.getElementById(
      "studio-toggle-gizmo",
    ) as HTMLInputElement | null;
    const syncScrollBtn = document.getElementById("studio-sync-scroll-btn");
    const copyBtn = document.getElementById("studio-copy-btn");
    const saveBtn = document.getElementById("studio-save-btn");
    const resetBtn = document.getElementById("studio-reset-btn");
    const gizmo = document.getElementById("particle-placement-gizmo");
    const dragHeader = document.getElementById("studio-drag-header");

    if (!studioBtn || !studioPanel) return;

    // Toggle button
    studioBtn.onclick = () => {
      studioActive = !studioActive;
      toggleStudioPanel(studioActive);
    };

    studioCloseBtn?.addEventListener("click", () => {
      studioActive = false;
      toggleStudioPanel(false);
    });

    // Keyboard shortcut: Alt+P to toggle
    window.addEventListener("keydown", (e) => {
      if (e.altKey && (e.key === "p" || e.key === "P")) {
        studioActive = !studioActive;
        toggleStudioPanel(studioActive);
      }
    });

    // Render image selector tabs
    if (imageTabsContainer) {
      imageTabsContainer.innerHTML = "";
      PARTICLE_CONFIG.images.forEach((_, idx) => {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = `py-1.5 px-2 rounded-md font-mono text-[11px] transition-all cursor-pointer text-center ${
          idx === selectedImageIdx
            ? "bg-[#d4af37] text-zinc-950 font-bold shadow-md"
            : "text-zinc-400 hover:text-white hover:bg-zinc-800"
        }`;
        btn.textContent = `Image ${idx + 1}`;
        btn.onclick = () => {
          selectImageTab(idx);
        };
        imageTabsContainer.appendChild(btn);
      });
    }

    // Render morph scrub markers
    if (morphMarkersContainer) {
      morphMarkersContainer.innerHTML = "";
      PARTICLE_CONFIG.images.forEach((_, idx) => {
        const span = document.createElement("span");
        span.textContent = `Img ${idx + 1}`;
        morphMarkersContainer.appendChild(span);
      });
    }

    // Sync input sliders with selected image layout
    syncControlsToActiveImage();

    // Scale slider input
    scaleSlider?.addEventListener("input", () => {
      const layout = getImageLayout(selectedImageIdx);
      layout.scale = parseFloat(scaleSlider.value);
      const valEl = document.getElementById("studio-scale-val");
      if (valEl) valEl.textContent = `${layout.scale.toFixed(2)}x`;
      updateGizmoPosition(window.innerWidth, window.innerHeight);
      saveLayoutsToStorage();
    });

    // Align X slider input
    alignXSlider?.addEventListener("input", () => {
      const layout = getImageLayout(selectedImageIdx);
      layout.alignX = parseFloat(alignXSlider.value);
      const valEl = document.getElementById("studio-alignx-val");
      if (valEl) valEl.textContent = `${Math.round(layout.alignX * 100)}%`;
      updateGizmoPosition(window.innerWidth, window.innerHeight);
      saveLayoutsToStorage();
    });

    // Align Y slider input
    alignYSlider?.addEventListener("input", () => {
      const layout = getImageLayout(selectedImageIdx);
      layout.alignY = parseFloat(alignYSlider.value);
      const valEl = document.getElementById("studio-aligny-val");
      if (valEl) valEl.textContent = `${Math.round(layout.alignY * 100)}%`;
      updateGizmoPosition(window.innerWidth, window.innerHeight);
      saveLayoutsToStorage();
    });

    // Preset buttons for X and Y
    document.querySelectorAll(".preset-x-btn").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const target = e.currentTarget as HTMLElement;
        const val = parseFloat(target.getAttribute("data-val") || "0.5");
        const layout = getImageLayout(selectedImageIdx);
        layout.alignX = val;
        if (alignXSlider) alignXSlider.value = String(val);
        const valEl = document.getElementById("studio-alignx-val");
        if (valEl) valEl.textContent = `${Math.round(val * 100)}%`;
        updateGizmoPosition(window.innerWidth, window.innerHeight);
        saveLayoutsToStorage();
      });
    });

    document.querySelectorAll(".preset-y-btn").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const target = e.currentTarget as HTMLElement;
        const val = parseFloat(target.getAttribute("data-val") || "0.5");
        const layout = getImageLayout(selectedImageIdx);
        layout.alignY = val;
        if (alignYSlider) alignYSlider.value = String(val);
        const valEl = document.getElementById("studio-aligny-val");
        if (valEl) valEl.textContent = `${Math.round(val * 100)}%`;
        updateGizmoPosition(window.innerWidth, window.innerHeight);
        saveLayoutsToStorage();
      });
    });

    // Toggle gizmo visibility checkbox
    toggleGizmo?.addEventListener("change", () => {
      studioGizmoVisible = toggleGizmo.checked;
      if (!studioGizmoVisible && gizmo) {
        gizmo.classList.add("hidden");
      } else if (studioGizmoVisible && studioActive && gizmo) {
        gizmo.classList.remove("hidden");
        updateGizmoPosition(window.innerWidth, window.innerHeight);
      }
    });

    // Morph scrub slider input
    morphSlider?.addEventListener("input", () => {
      const pct = parseFloat(morphSlider.value);
      studioManualMorph = pct / 100;
      const morphValEl = document.getElementById("studio-morph-val");
      if (morphValEl) morphValEl.textContent = `${Math.round(pct)}%`;
    });

    syncScrollBtn?.addEventListener("click", () => {
      studioManualMorph = null;
      if (morphSlider) {
        const scrollY = window.scrollY || window.pageYOffset || 0;
        const docHeight = document.documentElement.scrollHeight;
        const winHeight = window.innerHeight;
        const maxScroll = Math.max(1, docHeight - winHeight);
        const curPct = Math.min(100, Math.max(0, (scrollY / maxScroll) * 100));
        morphSlider.value = curPct.toFixed(1);
        const morphValEl = document.getElementById("studio-morph-val");
        if (morphValEl) morphValEl.textContent = `${Math.round(curPct)}%`;
      }
    });

    // Copy Configuration Code
    copyBtn?.addEventListener("click", () => {
      const code = `imageLayouts: ${JSON.stringify(PARTICLE_CONFIG.imageLayouts, null, 2)},`;
      navigator.clipboard.writeText(code).then(() => {
        const textEl = document.getElementById("studio-copy-text");
        if (textEl) textEl.textContent = "✓ Copied!";
        setTimeout(() => {
          if (textEl) textEl.textContent = "Copy Code";
        }, 2000);
      });
    });

    // Save to Browser button
    saveBtn?.addEventListener("click", () => {
      saveLayoutsToStorage();
      const textEl = document.getElementById("studio-save-text");
      if (textEl) textEl.textContent = "✓ Saved!";
      setTimeout(() => {
        if (textEl) textEl.textContent = "Save to Browser";
      }, 2000);
    });

    // Reset Defaults
    resetBtn?.addEventListener("click", () => {
      if (
        confirm(
          "Reset all particle image positions and scales back to default?",
        )
      ) {
        localStorage.removeItem("luxury_particle_layouts");
        PARTICLE_CONFIG.imageLayouts = JSON.parse(
          JSON.stringify(DEFAULT_IMAGE_LAYOUTS),
        );
        syncControlsToActiveImage();
        updateGizmoPosition(window.innerWidth, window.innerHeight);
      }
    });

    // Setup Gizmo Dragging and Resizing
    setupGizmoInteractions();

    // Setup Panel Dragging
    setupPanelDrag(dragHeader, studioPanel);
  }

  function toggleStudioPanel(open: boolean) {
    const studioPanel = document.getElementById("particle-studio-panel");
    const gizmo = document.getElementById("particle-placement-gizmo");
    if (!studioPanel) return;

    if (open) {
      studioPanel.classList.remove("hidden");
      if (studioGizmoVisible && gizmo) {
        gizmo.classList.remove("hidden");
        updateGizmoPosition(window.innerWidth, window.innerHeight);
      }
      syncControlsToActiveImage();
    } else {
      studioPanel.classList.add("hidden");
      gizmo?.classList.add("hidden");
      studioManualMorph = null;
    }
  }

  function closeStudioPanel() {
    studioActive = false;
    toggleStudioPanel(false);
  }

  function selectImageTab(idx: number) {
    selectedImageIdx = idx;
    const tabs = document.querySelectorAll("#studio-image-tabs button");
    tabs.forEach((tab, i) => {
      if (i === idx) {
        tab.className =
          "py-1.5 px-2 rounded-md font-mono text-[11px] transition-all cursor-pointer text-center bg-[#d4af37] text-zinc-950 font-bold shadow-md";
      } else {
        tab.className =
          "py-1.5 px-2 rounded-md font-mono text-[11px] transition-all cursor-pointer text-center text-zinc-400 hover:text-white hover:bg-zinc-800";
      }
    });

    // Morph preview smoothly to this image
    const numImages = PARTICLE_CONFIG.images.length;
    if (numImages > 1) {
      studioManualMorph = idx / (numImages - 1);
      const morphSlider = document.getElementById(
        "studio-morph-slider",
      ) as HTMLInputElement | null;
      if (morphSlider) {
        morphSlider.value = String(studioManualMorph * 100);
        const morphValEl = document.getElementById("studio-morph-val");
        if (morphValEl)
          morphValEl.textContent = `${Math.round(studioManualMorph * 100)}%`;
      }
    }

    syncControlsToActiveImage();
    updateGizmoPosition(window.innerWidth, window.innerHeight);
  }

  function syncControlsToActiveImage() {
    const layout = getImageLayout(selectedImageIdx);
    const scaleSlider = document.getElementById(
      "studio-scale-slider",
    ) as HTMLInputElement | null;
    const alignXSlider = document.getElementById(
      "studio-alignx-slider",
    ) as HTMLInputElement | null;
    const alignYSlider = document.getElementById(
      "studio-aligny-slider",
    ) as HTMLInputElement | null;

    if (scaleSlider) scaleSlider.value = layout.scale.toFixed(2);
    if (alignXSlider) alignXSlider.value = layout.alignX.toFixed(3);
    if (alignYSlider) alignYSlider.value = layout.alignY.toFixed(3);

    const scaleVal = document.getElementById("studio-scale-val");
    const alignXVal = document.getElementById("studio-alignx-val");
    const alignYVal = document.getElementById("studio-aligny-val");

    if (scaleVal) scaleVal.textContent = `${layout.scale.toFixed(2)}x`;
    if (alignXVal)
      alignXVal.textContent = `${Math.round(layout.alignX * 100)}%`;
    if (alignYVal)
      alignYVal.textContent = `${Math.round(layout.alignY * 100)}%`;
  }

  function updateGizmoPosition(screenW: number, screenH: number) {
    const gizmo = document.getElementById("particle-placement-gizmo");
    if (!gizmo || !studioActive || !studioGizmoVisible) return;

    const layout = getImageLayout(selectedImageIdx);
    const aspect = activeImageAspects[selectedImageIdx] || 1.0;
    const size = screenH * layout.scale;
    const drawW = size * aspect;
    const drawH = size;
    const centerX = screenW * layout.alignX;
    const centerY = screenH * layout.alignY;

    const left = centerX - drawW / 2;
    const top = centerY - drawH / 2;

    gizmo.style.left = `${left}px`;
    gizmo.style.top = `${top}px`;
    gizmo.style.width = `${drawW}px`;
    gizmo.style.height = `${drawH}px`;

    const label = document.getElementById("gizmo-label");
    const coords = document.getElementById("gizmo-coords");
    if (label) label.textContent = `Image ${selectedImageIdx + 1}`;
    if (coords) {
      coords.textContent = `X: ${(layout.alignX * 100).toFixed(1)}% Y: ${(layout.alignY * 100).toFixed(1)}% S: ${layout.scale.toFixed(2)}x`;
    }
  }

  // Interactive On-Screen Gizmo Drag & Scale
  function setupGizmoInteractions() {
    const gizmo = document.getElementById("particle-placement-gizmo");
    if (!gizmo) return;

    let isDragging = false;
    let isScaling = false;
    let startX = 0;
    let startY = 0;
    let startAlignX = 0;
    let startAlignY = 0;
    let startScale = 1.0;
    let startDist = 0;

    gizmo.addEventListener("pointerdown", (e) => {
      e.stopPropagation();
      e.preventDefault();

      const target = e.target as HTMLElement;
      const layout = getImageLayout(selectedImageIdx);
      const screenW = window.innerWidth;
      const screenH = window.innerHeight;

      // Temporarily pull cursor revolving away so particles don't swirl away during positioning
      targetMouseX = -9999;
      targetMouseY = -9999;

      if (target.classList.contains("gizmo-handle")) {
        isScaling = true;
        startX = e.clientX;
        startY = e.clientY;
        startScale = layout.scale;
        const cx = screenW * layout.alignX;
        const cy = screenH * layout.alignY;
        startDist = Math.hypot(e.clientX - cx, e.clientY - cy);
      } else {
        isDragging = true;
        startX = e.clientX;
        startY = e.clientY;
        startAlignX = layout.alignX;
        startAlignY = layout.alignY;
      }

      window.addEventListener("pointermove", onPointerMove);
      window.addEventListener("pointerup", onPointerUp);
    });

    function onPointerMove(e: PointerEvent) {
      const layout = getImageLayout(selectedImageIdx);
      const screenW = window.innerWidth;
      const screenH = window.innerHeight;

      if (isDragging) {
        const dx = e.clientX - startX;
        const dy = e.clientY - startY;
        layout.alignX = Math.max(
          0.02,
          Math.min(0.98, startAlignX + dx / screenW),
        );
        layout.alignY = Math.max(
          0.02,
          Math.min(0.98, startAlignY + dy / screenH),
        );
        syncControlsToActiveImage();
        updateGizmoPosition(screenW, screenH);
      } else if (isScaling) {
        const cx = screenW * layout.alignX;
        const cy = screenH * layout.alignY;
        const curDist = Math.hypot(e.clientX - cx, e.clientY - cy);
        const ratio = curDist / Math.max(10, startDist);
        layout.scale = Math.max(0.2, Math.min(2.5, startScale * ratio));
        syncControlsToActiveImage();
        updateGizmoPosition(screenW, screenH);
      }
    }

    function onPointerUp() {
      if (isDragging || isScaling) {
        saveLayoutsToStorage();
      }
      isDragging = false;
      isScaling = false;
      window.removeEventListener("pointermove", onPointerMove);
      window.removeEventListener("pointerup", onPointerUp);
    }
  }

  // Draggable Studio Panel Window
  function setupPanelDrag(header: HTMLElement | null, panel: HTMLElement) {
    if (!header) return;

    let isDragging = false;
    let startX = 0;
    let startY = 0;
    let initialLeft = 0;
    let initialTop = 0;

    header.addEventListener("pointerdown", (e) => {
      if ((e.target as HTMLElement).closest("#studio-close-btn")) return;
      isDragging = true;
      startX = e.clientX;
      startY = e.clientY;
      const rect = panel.getBoundingClientRect();
      initialLeft = rect.left;
      initialTop = rect.top;

      panel.style.bottom = "auto";
      panel.style.right = "auto";
      panel.style.left = `${initialLeft}px`;
      panel.style.top = `${initialTop}px`;

      window.addEventListener("pointermove", onPointerMove);
      window.addEventListener("pointerup", onPointerUp);
    });

    function onPointerMove(e: PointerEvent) {
      if (!isDragging) return;
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      panel.style.left = `${Math.max(10, Math.min(window.innerWidth - 380, initialLeft + dx))}px`;
      panel.style.top = `${Math.max(10, Math.min(window.innerHeight - 150, initialTop + dy))}px`;
    }

    function onPointerUp() {
      isDragging = false;
      window.removeEventListener("pointermove", onPointerMove);
      window.removeEventListener("pointerup", onPointerUp);
    }
  }

  // Global listener for Replay button
  window.addEventListener("replay-luxury-intro", () => {
    window.scrollTo({ top: 0, behavior: "smooth" });
    document.documentElement.classList.add("luxury-animating");
    document
      .querySelectorAll(".luxury-revealed")
      .forEach((el) => el.classList.remove("luxury-revealed"));
    setTimeout(initLuxuryCinematicIntro, 350);
  });

  // Watch for theme changes from ThemeSwitcher
  const observer = new MutationObserver((mutations) => {
    for (const mutation of mutations) {
      if (
        mutation.type === "attributes" &&
        mutation.attributeName === "data-theme"
      ) {
        const theme = document.documentElement.getAttribute("data-theme");
        if (theme === "luxury") {
          initLuxuryCinematicIntro();
        } else {
          if (currentAnimId) cancelAnimationFrame(currentAnimId);
          document.documentElement.classList.remove("luxury-animating");
          document.getElementById("luxury-veil")?.classList.add("hidden");
          document
            .getElementById("luxury-particle-canvas")
            ?.classList.add("hidden");
          document
            .getElementById("particle-studio-btn")
            ?.classList.add("hidden");
          closeStudioPanel();
          const portraitImg = document.getElementById("luxury-portrait-img");
          if (portraitImg) {
            portraitImg.style.opacity = "1";
            portraitImg.style.display = "";
          }
        }
      }
    }
  });

  observer.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["data-theme"],
  });

  // Run on initial page load
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initLuxuryCinematicIntro);
  } else {
    initLuxuryCinematicIntro();
  }
</script>
