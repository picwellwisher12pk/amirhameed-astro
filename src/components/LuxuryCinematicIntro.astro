    // 6: Soft Physics Displace (Elastic Damped Membrane)
    // 7: Neural Constellation (Synaptic Filaments)
    interactiveMode: 1,
    isRandomMode: true,
    effectIntensity: 1.0,
    effectSpeed: 1.0,
    cursorRadius: 140.0,
    repelStrength: 20.0,
    returnSpeed: 0.035,
    dragDamping: 0.90,

    // 3. OPACITY & TEXT CONTRAST (50% dimming after animation completes)
    initialOpacity: 1.0,
    settledDimOpacity: 0.50,
    dimTransitionDuration: 1.4,

    // 4. TIMING & GRADUAL SEQUENTIAL REVEAL
    introGatherDuration: 2200,
    elementStaggerDelay: 320,

    // 5. SCROLL ARCHITECTURE & MULTI-PICTURE MORPHING
    fixedInViewport: true,
    morphPlateau: 0.20,
    images: [
      "/images/amir-portrait-luxury.jpg",
      "/images/2.jpg",
      "/images/3.jpg",
    ],
  };

  // Restore saved layouts & mode from localStorage
  function restoreSavedSettings() {
    try {
      const lockedMode = localStorage.getItem('luxury_particle_locked_mode');
      if (lockedMode) {
        const modeNum = parseInt(lockedMode, 10);
        if (modeNum >= 1 && modeNum <= 7) {
          PARTICLE_CONFIG.interactiveMode = modeNum;
          PARTICLE_CONFIG.isRandomMode = false;
        }
      } else {
        // Random mode selected fresh on each page load!
        PARTICLE_CONFIG.interactiveMode = Math.floor(Math.random() * 7) + 1;
        PARTICLE_CONFIG.isRandomMode = true;
      }

      // Clear legacy single-mode storage so it doesn't freeze the random selection
      localStorage.removeItem('luxury_particle_mode');

      const raw = localStorage.getItem('luxury_particle_layouts');
      if (raw) {
        const parsed = JSON.parse(raw);
        if (Array.isArray(parsed)) {
          parsed.forEach((layout, i) => {
            if (layout && typeof layout.scale === 'number') {
              PARTICLE_CONFIG.imageLayouts[i] = {
                scale: layout.scale,
                alignX: layout.alignX,
                alignY: layout.alignY,
              };
            }
          });
        }
      }
    } catch (e) {
      console.warn('Could not restore particle settings from localStorage', e);
    }
  }
  restoreSavedSettings();

  function saveSettingsToStorage() {
    try {
      localStorage.setItem('luxury_particle_layouts', JSON.stringify(PARTICLE_CONFIG.imageLayouts));
      if (!PARTICLE_CONFIG.isRandomMode) {
        localStorage.setItem('luxury_particle_locked_mode', String(PARTICLE_CONFIG.interactiveMode));
      } else {
        localStorage.removeItem('luxury_particle_locked_mode');
      }
    } catch (e) {
      console.warn('Could not save particle settings to localStorage', e);
    }
  }

  function getImageLayout(index: number) {
    if (PARTICLE_CONFIG.imageLayouts[index]) {
      return PARTICLE_CONFIG.imageLayouts[index];
    }
    const fallback = { scale: 1.0, alignX: 0.50, alignY: 0.50 };
    PARTICLE_CONFIG.imageLayouts[index] = fallback;
    return fallback;
  }

  // Expose configuration globally for testing & tweaking: window.PARTICLE_CONFIG
  (window as any).PARTICLE_CONFIG = PARTICLE_CONFIG;

  // WebGL Shaders with 5 Switchable Organic Interaction Modes
  const VS_SOURCE = `
    attribute vec2 a_targetA;
    attribute vec3 a_colorA;
    attribute vec2 a_targetB;
    attribute vec3 a_colorB;
    attribute vec2 a_origin;
    attribute vec4 a_params; // x: delay, y: duration, z: size, w: curl

    uniform float u_time;
    uniform vec2 u_resolution;
    uniform vec2 u_mouse;
    uniform vec2 u_mouse_vel;
    uniform float u_mouse_speed;
    uniform float u_mouse_active;
    uniform float u_cursor_radius;
    uniform float u_dim_factor;
    uniform float u_morph_t; // 0.0 to 1.0 morph between Image A and Image B

    // Interactive Mode & Parameters
    uniform int u_interactive_mode; // 1: Hologram, 2: Ripple, 3: Lantern, 4: Gravity, 5: Fluid
    uniform float u_param_intensity;
    uniform float u_param_speed;
    uniform float u_repel_strength;

    // Dynamic Live Transforms (Scale and Center per Image)
    uniform vec2 u_centerA;
    uniform float u_sizeA;
    uniform vec2 u_centerB;
    uniform float u_sizeB;

    varying vec3 v_color;
    varying float v_alpha;

    // Simplex Noise & Divergence-Free Curl Field
    vec3 mod289(vec3 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
    vec2 mod289(vec2 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
    vec3 permute(vec3 x) { return mod289(((x * 34.0) + 1.0) * x); }

    float snoise(vec2 v) {
      const vec4 C = vec4(0.211324865405187,
                          0.366025403784439,
                         -0.577350269189626,
                          0.024390243902439);
      vec2 i  = floor(v + dot(v, C.yy));
      vec2 x0 = v - i + dot(i, C.xx);
      vec2 i1 = (x0.x > x0.y) ? vec2(1.0, 0.0) : vec2(0.0, 1.0);
      vec4 x12 = x0.xyxy + C.xxzz;
      x12.xy -= i1;
      i = mod289(i);
      vec3 p = permute(permute(i.y + vec3(0.0, i1.y, 1.0))
            + i.x + vec3(0.0, i1.x, 1.0));
      vec3 m = max(0.5 - vec3(dot(x0, x0), dot(x12.xy, x12.xy), dot(x12.zw, x12.zw)), 0.0);
      m = m * m;
      m = m * m;
      vec3 x = 2.0 * fract(p * C.www) - 1.0;
      vec3 h = abs(x) - 0.5;
      vec3 ox = floor(x + 0.5);
      vec3 a0 = x - ox;
      m *= 1.79284291400159 - 0.85373472095314 * (a0 * a0 + h * h);
      vec3 g;
      g.x  = a0.x  * x0.x  + h.x  * x0.y;
      g.yz = a0.yz * x12.xz + h.yz * x12.yw;
      return 130.0 * dot(m, g);
    }

    vec2 curlNoise(vec2 p) {
      float eps = 0.5;
      float n1 = snoise(vec2(p.x, p.y + eps));
      float n2 = snoise(vec2(p.x, p.y - eps));
      float n3 = snoise(vec2(p.x + eps, p.y));
      float n4 = snoise(vec2(p.x - eps, p.y));
      float dx = (n1 - n2) / (2.0 * eps);
      float dy = (n3 - n4) / (2.0 * eps);
      return vec2(dx, -dy);
    }

    void main() {
      float delay = a_params.x;
      float duration = a_params.y;
      float size = a_params.z;
      float curl = a_params.w;

      float pElapsed = max(0.0, u_time - delay);
      float progress = clamp(pElapsed / duration, 0.0, 1.0);

      // Smooth quintic ease out for majestic cinematic gathering
      float t = 1.0 - progress;
      float ease = 1.0 - t * t * t * t;

      // Dynamically compute screen pixel target coordinates from normalized coordinates
      vec2 targetPosA = u_centerA + a_targetA * u_sizeA;
      vec2 targetPosB = u_centerB + a_targetB * u_sizeB;

      // Morph between Picture A and Picture B with organic celestial swirl
      float morphSwirl = sin(u_morph_t * 3.14159265);
      vec2 morphDiff = targetPosB - targetPosA;
      vec2 morphPerp = vec2(-morphDiff.y, morphDiff.x) * 0.18 * curl;
      vec2 morphedTarget = mix(targetPosA, targetPosB, u_morph_t) + morphPerp * morphSwirl;
      vec3 morphedColor = mix(a_colorA, a_colorB, u_morph_t);
      vec3 finalColor = morphedColor;
      float pointSize = size * (1.0 + (1.0 - progress) * 0.6);

      // Organic bidirectional vortex curl during gathering flight
      float swirlAngle = (1.0 - ease) * curl;
      vec2 diff = a_origin - morphedTarget;
      float cosA = cos(swirlAngle);
      float sinA = sin(swirlAngle);
      vec2 rotatedDiff = vec2(
        diff.x * cosA - diff.y * sinA,
        diff.x * sinA + diff.y * cosA
      );
      vec2 currentOrigin = morphedTarget + rotatedDiff;
      vec2 pos = mix(currentOrigin, morphedTarget, ease);

      // Subtle breathing ambient shimmer when settled
      if (progress >= 1.0) {
        float shimmer = sin(u_time * 0.002 + morphedTarget.x * 0.01 + morphedTarget.y * 0.01) * 0.6;
        pos.y += shimmer;
      }

      // =====================================================================
      // 🔮 8 SWITCHABLE ORGANIC INTERACTIVE MODES
      // =====================================================================
      if (u_mouse_active > 0.01) {
        vec2 toMouse = pos - u_mouse;
        float d = length(toMouse);

        // -------------------------------------------------------------
        // MODE 1: Volumetric Quantum Aura (Pure Particle Movements Only)
        // -------------------------------------------------------------
        if (u_interactive_mode == 1) {
          vec2 center = mix(u_centerA, u_centerB, u_morph_t);
          float curSize = mix(u_sizeA, u_sizeB, u_morph_t);
          float distToCenter = length(pos - center);
          float normFaceDist = distToCenter / max(1.0, curSize * 0.45);

          // 1. Concentric Quantum Interference Wave
          float waveSpeed = u_time * 0.0055 * u_param_speed;
          float ringWave = sin(d * 0.048 - waveSpeed);
          float ringDecay = exp(-d * 0.0070);
          float ringIntensity = ringWave * ringDecay * u_param_intensity;

          // 2. Silhouette Aura Factor: Keeps facial core (eyes/nose/mouth) 100% solid & unwarped
          float outerFactor = smoothstep(0.18, 0.95, normFaceDist);
          vec2 tangent = vec2(-toMouse.y, toMouse.x);
          vec2 normTangent = length(tangent) > 0.001 ? normalize(tangent) : vec2(0.0, 1.0);
          vec2 normRadial = d > 0.001 ? (toMouse / d) : vec2(1.0, 0.0);
          
          // Pure particle movements: Orbital quantum harmonic drift + radial breathing wave
          vec2 orbitalPush = normTangent * (sin(d * 0.04 + waveSpeed * 1.5) * 7.5 * outerFactor * ringDecay * u_param_intensity);
          vec2 radialPulse = normRadial * (ringIntensity * 5.5 * outerFactor);
          pos += (orbitalPush + radialPulse) * u_mouse_active;
          // Note: Zero color bloom/glow and zero pointSize change. Pure particle displacement only.
        }

        // -------------------------------------------------------------
        // MODE 2: Silk Surface Ripple (Liquid Gold Waves)
        // -------------------------------------------------------------
        else if (u_interactive_mode == 2) {
          float maxRippleDist = u_cursor_radius * 2.2;
          if (d < maxRippleDist && d > 0.01) {
            float wavePhase = d * 0.075 - u_time * 0.007 * u_param_speed;
            float wave = sin(wavePhase);
            float decay = exp(-d * 0.011) * (1.0 - smoothstep(u_cursor_radius * 0.6, maxRippleDist, d));
            vec2 rippleDisplace = normalize(toMouse) * (wave * 20.0 * decay * u_param_intensity);
            pos += rippleDisplace * u_mouse_active;
          }
        }

        // -------------------------------------------------------------
        // MODE 3: Celestial Lantern (Physical Micro Attraction)
        // -------------------------------------------------------------
        else if (u_interactive_mode == 3) {
          float lanternRadius = u_cursor_radius * 1.6;
          if (d < lanternRadius && d > 0.01) {
            float lightFalloff = max(0.0, 1.0 - d / lanternRadius);
            lightFalloff = lightFalloff * lightFalloff * (3.0 - 2.0 * lightFalloff);
            // Subtle ambient physical attraction toward cursor
            pos += normalize(-toMouse) * (lightFalloff * 8.0 * u_param_intensity) * u_mouse_active;
          }
        }

        // -------------------------------------------------------------
        // MODE 4: Gravitational Lens (Cosmic Curvature)
        // -------------------------------------------------------------
        else if (u_interactive_mode == 4) {
          float maxGravDist = u_cursor_radius * 1.8;
          if (d < maxGravDist && d > 1.0) {
            float r0 = u_cursor_radius * 0.45;
            vec2 tangent = vec2(-toMouse.y, toMouse.x);
            float deflection = (r0 / (d + 25.0)) * (34.0 * u_param_intensity);
            float falloff = 1.0 - smoothstep(r0, maxGravDist, d);
            vec2 gravDisplace = (normalize(tangent) * deflection + normalize(-toMouse) * (deflection * 0.35)) * falloff;
            pos += gravDisplace * u_mouse_active;
          }
        }

        // -------------------------------------------------------------
        // MODE 5: Fluid Stardust Wake (Curl Turbulence)
        // -------------------------------------------------------------
        else if (u_interactive_mode == 5) {
          if (d < u_cursor_radius && d > 0.01) {
            float normD = d / u_cursor_radius;
            float falloff = 1.0 - normD;
            falloff = falloff * falloff * (3.0 - 2.0 * falloff);

            vec2 velocityWake = u_mouse_vel * (0.38 * u_param_intensity) * falloff;
            vec2 curlCoord = pos * 0.0065 + vec2(u_time * 0.0006, -u_time * 0.0005);
            vec2 fluidVortex = curlNoise(curlCoord) * (46.0 * u_param_intensity) * falloff;
            vec2 radialPush = normalize(toMouse) * (u_repel_strength * falloff * (1.0 - normD * 0.5));

            float particleInertia = 0.75 + 0.5 * abs(curl);
            vec2 totalDisplacement = (velocityWake + fluidVortex + radialPush) * particleInertia;
            pos += totalDisplacement * u_mouse_active;
          }
        }

        // -------------------------------------------------------------
        // MODE 6: Simple Soft Physics (Elastic Damped Membrane)
        // -------------------------------------------------------------
        else if (u_interactive_mode == 6) {
          float sigma = u_cursor_radius * 0.58;
          float gaussian = exp(- (d * d) / (2.0 * sigma * sigma));
          
          if (gaussian > 0.0008) {
            vec2 pushDir = (d > 0.01) ? (toMouse / d) : vec2(0.0, 1.0);
            float softPush = gaussian * (22.0 * u_param_intensity);
            vec2 viscousDrag = u_mouse_vel * (0.16 * u_param_intensity) * gaussian;
            float springPhase = u_time * 0.005 * u_param_speed - d * 0.025;
            float springWave = sin(springPhase) * gaussian * (3.0 * u_param_intensity);
            
            vec2 displacement = pushDir * softPush + viscousDrag + pushDir * springWave;
            pos += displacement * u_mouse_active;
          }
        }

        // -------------------------------------------------------------
        // MODE 7: Neural Constellation (Synaptic Web & Nodal Beacons)
        // -------------------------------------------------------------
        else if (u_interactive_mode == 7) {
          float constellRadius = u_cursor_radius * 1.5;
          if (d < constellRadius && d > 0.01) {
            float normD = d / constellRadius;
            float falloff = 1.0 - normD;
            falloff = falloff * falloff * (3.0 - 2.0 * falloff);

            // Subtle magnetic synaptic tension toward cursor
            pos += normalize(-toMouse) * (falloff * 7.0 * u_param_intensity) * u_mouse_active;

            // Micro electrical twitch / synaptic shimmer
            float twitch = sin(u_time * 0.02 + pos.x * 0.15 + pos.y * 0.15) * (falloff * 2.0 * u_param_intensity);
            pos.y += twitch * u_mouse_active;
          }
        }

        // -------------------------------------------------------------
        // MODE 8: Holographic Cyber Scanlines (Laser Sweep & Prismatic Slices)
        // -------------------------------------------------------------
        else if (u_interactive_mode == 8) {
          // 1. Continuous Vertical Holographic Laser Sweep
          float sweepProgress = fract(u_time * 0.00035 * u_param_speed);
          float laserY = sweepProgress * u_resolution.y;
          float beamDist = abs(pos.y - laserY);
          float laserBeam = smoothstep(55.0, 0.0, beamDist) * u_param_intensity;

          // 2. High-Tech Horizontal Micro-Scanline Frequency (Quantum comb)
          float scanFreq = sin(pos.y * 0.75 + u_time * 0.015);
          float glitchJitter = step(0.94, sin(pos.y * 0.25 + u_time * 0.04)) * 3.5;
          
          // Subtle horizontal slice shimmer only when beam passes or cursor is near
          float cursorProximity = max(0.0, 1.0 - d / (u_cursor_radius * 1.3));
          float activeSlice = max(laserBeam, cursorProximity * 0.75);
          pos.x += (scanFreq * 2.2 + glitchJitter) * activeSlice * u_param_intensity * u_mouse_active;

          // 3. Interactive Cursor Interference Beam (Cross-field laser)
          if (abs(pos.x - u_mouse.x) < 2.5 && d < u_cursor_radius * 1.2) {
            pointSize += 1.5 * u_mouse_active;
          }

          // 4. Prismatic Cyan-Gold Chromatic Holographic Shimmer
          if (activeSlice > 0.05) {
            vec3 cyberHolo = vec3(0.55, 0.92, 1.0); // Cyan laser
            vec3 goldHolo = vec3(1.0, 0.88, 0.52);  // Champagne gold
            vec3 holoGlint = mix(goldHolo, cyberHolo, sin(pos.y * 0.1 + u_time * 0.008) * 0.5 + 0.5);
            finalColor = mix(finalColor, holoGlint, activeSlice * 0.65 * u_mouse_active);
            pointSize += activeSlice * 1.4 * u_mouse_active;
          }
        }
      }

      // Map to clip space (-1 to 1)
      vec2 zeroToOne = pos / u_resolution;
      vec2 zeroToTwo = zeroToOne * 2.0;
      vec2 clipSpace = zeroToTwo - 1.0;
      clipSpace.y = -clipSpace.y; // Invert Y for screen

      gl_Position = vec4(clipSpace, 0.0, 1.0);
      gl_PointSize = pointSize;

      v_color = finalColor;
      v_alpha = min(1.0, pElapsed / 250.0) * u_dim_factor;
    }
  `;

  const FS_SOURCE = `
    precision mediump float;
    varying vec3 v_color;
    varying float v_alpha;

    void main() {
      // Circular nano particle with soft celestial stardust core and ethereal halo
      vec2 coord = gl_PointCoord - vec2(0.5);
      float dist = length(coord);
      if (dist > 0.5) discard;
      float core = smoothstep(0.22, 0.0, dist);
      float halo = smoothstep(0.5, 0.08, dist);
      float intensity = halo * 0.75 + core * 0.55;
      gl_FragColor = vec4(v_color, v_alpha * intensity);
    }
  `;

  let currentAnimId: number | null = null;
  let constellCanvas: HTMLCanvasElement | null = null;
  let constellCtx: CanvasRenderingContext2D | null = null;
  let targetMouseX = -9999;
  let targetMouseY = -9999;
  let mouseX = -9999;
  let mouseY = -9999;
  let interpVelX = 0;
  let interpVelY = 0;
  let mouseVelX = 0;
  let mouseVelY = 0;
  let smoothVelX = 0;
  let smoothVelY = 0;
  let rawMouseActive = 0.0;
  let modeTransitionProgress = 1.0;
  let pendingMode: number | null = null;
  let lastMoveTime = performance.now();

  // Window-level mouse tracking for kinetic velocity & parallax interaction
  window.addEventListener('pointermove', (e: MouseEvent | PointerEvent) => {
    const now = performance.now();
    const dt = Math.max(1, now - lastMoveTime);
    lastMoveTime = now;

    if (targetMouseX > -5000) {
      const vx = (e.clientX - targetMouseX) / (dt / 16.6);
      const vy = (e.clientY - targetMouseY) / (dt / 16.6);
      const maxV = 80;
      mouseVelX = Math.max(-maxV, Math.min(maxV, vx));
      mouseVelY = Math.max(-maxV, Math.min(maxV, vy));
    }

    targetMouseX = e.clientX;
    targetMouseY = e.clientY;
  }, { passive: true });

  window.addEventListener('pointerleave', () => {
    targetMouseX = -9999;
    targetMouseY = -9999;
    mouseVelX = 0;
    mouseVelY = 0;
  });

  // Pre-load all images configured in PARTICLE_CONFIG.images
  async function loadAllConfigImages(srcList: string[]): Promise<HTMLImageElement[]> {
    const list = srcList && srcList.length > 0 ? srcList : ['/images/amir-portrait-luxury.jpg'];
    const promises = list.map((src) => {
      return new Promise<HTMLImageElement>((resolve) => {
        const img = new Image();
        img.crossOrigin = 'anonymous';
        img.onload = () => resolve(img);
        img.onerror = () => {
          console.warn(`[LuxuryParticles] Could not load image: ${src}`);
          resolve(img);
        };
        img.src = src;
      });
    });
    return Promise.all(promises);
  }

  // Sample target positions and colors for any image in NORMALIZED image coordinates (nx, ny)
  function sampleImageTargets(
    img: HTMLImageElement,
    particleCount: number
  ): Float32Array {
    const imgW = img.naturalWidth || 1800;
    const imgH = img.naturalHeight || 1800;
    const imgAspect = imgW / imgH;

    const sampleW = 400;
    const sampleH = Math.max(250, Math.round(400 / imgAspect));
    const offscreen = document.createElement('canvas');
    offscreen.width = sampleW;
    offscreen.height = sampleH;
    const offCtx = offscreen.getContext('2d');

    const buffer = new Float32Array(particleCount * 5); // 5 floats: nx, ny, r, g, b

    if (!offCtx || imgW === 0 || imgH === 0) {
      for (let i = 0; i < particleCount; i++) {
        buffer[i * 5] = (Math.random() - 0.5) * imgAspect;
        buffer[i * 5 + 1] = Math.random() - 0.5;
        buffer[i * 5 + 2] = 0.96;
        buffer[i * 5 + 3] = 0.84;
        buffer[i * 5 + 4] = 0.43;
      }
      return buffer;
    }

    offCtx.drawImage(img, 0, 0, sampleW, sampleH);
    const imgData = offCtx.getImageData(0, 0, sampleW, sampleH).data;
    const totalPixels = sampleW * sampleH;

    const cdf = new Float64Array(totalPixels);
    let runningSum = 0;

    for (let i = 0; i < totalPixels; i++) {
      const idx = i * 4;
      const r = imgData[idx] / 255;
      const g = imgData[idx + 1] / 255;
      const b = imgData[idx + 2] / 255;
      const a = imgData[idx + 3] / 255;

      const lum = 0.299 * r + 0.587 * g + 0.114 * b;
      let weight = 0;

      if (a > 0.08) {
        if (lum > 0.04) {
          weight = (Math.pow(lum, 0.82) * 1.2 + 0.12) * a;
        } else if (r > 0.02 || g > 0.02 || b > 0.02) {
          weight = 0.05 * a;
        }
      }

      runningSum += weight;
      cdf[i] = runningSum;
    }

    const totalWeight = runningSum > 0 ? runningSum : 1;

    for (let p = 0; p < particleCount; p++) {
      const rnd = Math.random() * totalWeight;

      let low = 0;
      let high = totalPixels - 1;
      while (low < high) {
        const mid = (low + high) >> 1;
        if (cdf[mid] < rnd) {
          low = mid + 1;
        } else {
          high = mid;
        }
      }

      const pixelIndex = low;
      const py = Math.floor(pixelIndex / sampleW);
      const px = pixelIndex % sampleW;

      // Sub-pixel continuous random jitter: completely eliminates grid
      const subX = px + Math.random();
      const subY = py + Math.random();

      // Normalized coordinates centered at (0, 0):
      const nx = (subX / sampleW - 0.5) * imgAspect;
      const ny = (subY / sampleH - 0.5);

      const samplePx = Math.min(sampleW - 1, Math.max(0, Math.floor(subX)));
      const samplePy = Math.min(sampleH - 1, Math.max(0, Math.floor(subY)));
      const byteIdx = (samplePy * sampleW + samplePx) * 4;
      const r = imgData[byteIdx] / 255;
      const g = imgData[byteIdx + 1] / 255;
      const b = imgData[byteIdx + 2] / 255;

      const isGold = Math.random() < 0.14;
      const finalR = isGold ? 0.96 : r;
      const finalG = isGold ? 0.84 : g;
      const finalB = isGold ? 0.43 : b;

      const base = p * 5;
      buffer[base] = nx;
      buffer[base + 1] = ny;
      buffer[base + 2] = finalR;
      buffer[base + 3] = finalG;
      buffer[base + 4] = finalB;

      if (p % 110 === 0 && constellationNodes.length < 500) {
        constellationNodes.push({ nx, ny });
      }
    }

    return buffer;
  }

  // State for Interactive Particle Placement Studio
  let studioActive = false;
  let studioGizmoVisible = true;
  let studioManualMorph: number | null = null;
  let selectedImageIdx = 0;
  let activeImageAspects: number[] = [];
  let constellationNodes: { nx: number; ny: number }[] = [];

  async function initLuxuryCinematicIntro() {
    if (currentAnimId) {
      cancelAnimationFrame(currentAnimId);
      currentAnimId = null;
    }

    const isLuxury = document.documentElement.getAttribute('data-theme') === 'luxury';
    const veil = document.getElementById('luxury-veil');
    const canvas = document.getElementById('luxury-particle-canvas') as HTMLCanvasElement | null;
    constellCanvas = document.getElementById('luxury-constellation-canvas') as HTMLCanvasElement | null;
    constellCtx = constellCanvas?.getContext('2d') || null;
    const portraitImg = document.getElementById('luxury-portrait-img') as HTMLImageElement | null;
    const morpher = document.getElementById('luxury-morphing-container');
    const studioBtn = document.getElementById('particle-studio-btn');

    constellationNodes = [];

    if (!isLuxury || !canvas) {
      document.documentElement.classList.remove('luxury-animating');
      veil?.classList.add('hidden');
      canvas?.classList.add('hidden');
      constellCanvas?.classList.add('hidden');
      studioBtn?.classList.add('hidden');
      closeStudioPanel();
      if (portraitImg) {
        portraitImg.style.opacity = '1';
        portraitImg.style.display = '';
      }
      if (morpher) morpher.style.opacity = '1';
      return;
    }

    document.documentElement.classList.add('luxury-animating');
    veil?.classList.remove('hidden');
    veil?.classList.remove('opacity-0');
    veil?.classList.add('opacity-100');
    canvas.classList.remove('hidden');
    canvas.style.opacity = '1';
    if (constellCanvas) {
      constellCanvas.classList.remove('hidden');
      constellCanvas.style.opacity = '1';
    }
    studioBtn?.classList.remove('hidden');

    if (portraitImg) {
      portraitImg.style.opacity = '0';
      portraitImg.style.display = 'none';
    }
    if (morpher) morpher.style.display = 'none';

    const screenW = window.innerWidth;
    const screenH = window.innerHeight;
    canvas.width = screenW;
    canvas.height = screenH;

    const gl = (canvas.getContext('webgl') || canvas.getContext('experimental-webgl')) as WebGLRenderingContext | null;

    if (!gl) {
      fallbackCanvas2D(canvas, veil);
      return;
    }

    const loadedImages = await loadAllConfigImages(PARTICLE_CONFIG.images);
    if (!loadedImages || loadedImages.length === 0) {
      fallbackCanvas2D(canvas, veil);
      return;
    }

    activeImageAspects = loadedImages.map((img) => (img.naturalWidth || 1800) / (img.naturalHeight || 1800));

    setupInteractiveStudioUI();
    runWebGLMultiPointCloud(gl, canvas, loadedImages, veil);
  }

  function createShader(gl: WebGLRenderingContext, type: number, source: string) {
    const shader = gl.createShader(type);
    if (!shader) return null;
    gl.shaderSource(shader, source);
    gl.compileShader(shader);
    if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
      console.error(gl.getShaderInfoLog(shader));
      gl.deleteShader(shader);
      return null;
    }
    return shader;
  }

  function runWebGLMultiPointCloud(
    gl: WebGLRenderingContext, 
    canvas: HTMLCanvasElement, 
    loadedImages: HTMLImageElement[], 
    veil: HTMLElement | null
  ) {
    const vs = createShader(gl, gl.VERTEX_SHADER, VS_SOURCE);
    const fs = createShader(gl, gl.FRAGMENT_SHADER, FS_SOURCE);
    if (!vs || !fs) return;

    const program = gl.createProgram();
    if (!program) return;
    gl.attachShader(program, vs);
    gl.attachShader(program, fs);
    gl.linkProgram(program);
    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
      console.error(gl.getProgramInfoLog(program));
      return;
    }
    gl.useProgram(program);

    const screenW = canvas.width;
    const screenH = canvas.height;

    const isMobile = screenW < 768;
    const TARGET_PARTICLES = isMobile ? 48000 : 92000;

    const targetBuffers = loadedImages.map((img) =>
      sampleImageTargets(img, TARGET_PARTICLES)
    );

    const targetVBOs = targetBuffers.map((buffer) => {
      const vbo = gl.createBuffer();
      gl.bindBuffer(gl.ARRAY_BUFFER, vbo);
      gl.bufferData(gl.ARRAY_BUFFER, buffer, gl.STATIC_DRAW);
      return vbo;
    });

    const baseBuffer = new Float32Array(TARGET_PARTICLES * 6);
    for (let p = 0; p < TARGET_PARTICLES; p++) {
      const ox = (Math.random() * 1.3 - 0.15) * screenW;
      const oy = (Math.random() * 1.3 - 0.15) * screenH;
      const delay = Math.random() * 650;
      const duration = 1500 + Math.random() * 500;
      const size = Math.random() * 1.3 + 0.9;
      const curl = (Math.random() < 0.5 ? -1.0 : 1.0) * (0.8 + Math.random() * 1.4);

      const base = p * 6;
      baseBuffer[base] = ox;
      baseBuffer[base + 1] = oy;
      baseBuffer[base + 2] = delay;
      baseBuffer[base + 3] = duration;
      baseBuffer[base + 4] = size;
      baseBuffer[base + 5] = curl;
    }

    const baseVBO = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, baseVBO);
    gl.bufferData(gl.ARRAY_BUFFER, baseBuffer, gl.STATIC_DRAW);

    // Attribute Locations
    const aTargetALoc = gl.getAttribLocation(program, 'a_targetA');
    const aColorALoc = gl.getAttribLocation(program, 'a_colorA');
    const aTargetBLoc = gl.getAttribLocation(program, 'a_targetB');
    const aColorBLoc = gl.getAttribLocation(program, 'a_colorB');
    const aOriginLoc = gl.getAttribLocation(program, 'a_origin');
    const aParamsLoc = gl.getAttribLocation(program, 'a_params');

    // Uniform Locations
    const uTimeLoc = gl.getUniformLocation(program, 'u_time');
    const uResolutionLoc = gl.getUniformLocation(program, 'u_resolution');
    const uMouseLoc = gl.getUniformLocation(program, 'u_mouse');
    const uMouseVelLoc = gl.getUniformLocation(program, 'u_mouse_vel');
    const uMouseSpeedLoc = gl.getUniformLocation(program, 'u_mouse_speed');
    const uMouseActiveLoc = gl.getUniformLocation(program, 'u_mouse_active');
    const uCursorRadiusLoc = gl.getUniformLocation(program, 'u_cursor_radius');
    const uDimFactorLoc = gl.getUniformLocation(program, 'u_dim_factor');
    const uMorphTLoc = gl.getUniformLocation(program, 'u_morph_t');

    // Mode uniforms
    const uInteractiveModeLoc = gl.getUniformLocation(program, 'u_interactive_mode');
    const uParamIntensityLoc = gl.getUniformLocation(program, 'u_param_intensity');
    const uParamSpeedLoc = gl.getUniformLocation(program, 'u_param_speed');
    const uRepelStrengthLoc = gl.getUniformLocation(program, 'u_repel_strength');

    // Dynamic Live Transform Uniforms
    const uCenterALoc = gl.getUniformLocation(program, 'u_centerA');
    const uSizeALoc = gl.getUniformLocation(program, 'u_sizeA');
    const uCenterBLoc = gl.getUniformLocation(program, 'u_centerB');
    const uSizeBLoc = gl.getUniformLocation(program, 'u_sizeB');

    gl.enable(gl.BLEND);
    gl.blendFunc(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA);

    let startTime: number | null = null;
    let elementsRevealed = false;
    let mouseActive = 0.0;
    let dimStartTime: number | null = null;

    function render(timestamp: number) {
      if (!startTime) startTime = timestamp;
      const elapsed = timestamp - startTime;

      const curW = window.innerWidth;
      const curH = window.innerHeight;
      if (canvas.width !== curW || canvas.height !== curH) {
        canvas.width = curW;
        canvas.height = curH;
      }

      // Smooth kinetic velocity with exponential drag
      smoothVelX += (mouseVelX - smoothVelX) * 0.22;
      smoothVelY += (mouseVelY - smoothVelY) * 0.22;
      mouseVelX *= (PARTICLE_CONFIG.dragDamping || 0.90);
      mouseVelY *= (PARTICLE_CONFIG.dragDamping || 0.90);

      const cursorSpeed = Math.hypot(smoothVelX, smoothVelY);

      // Critically Damped Spring Follower: Accelerates smoothly (ease in) and decelerates smoothly (ease out)
      if (targetMouseX > -5000) {
        if (mouseX < -5000) {
          mouseX = targetMouseX;
          mouseY = targetMouseY;
          interpVelX = 0;
          interpVelY = 0;
        } else {
          const springK = Math.max(0.04, Math.min(0.24, (PARTICLE_CONFIG.returnSpeed || 0.12) * 1.15));
          const damping = 0.74;
          interpVelX = (interpVelX + (targetMouseX - mouseX) * springK) * damping;
          interpVelY = (interpVelY + (targetMouseY - mouseY) * springK) * damping;
          mouseX += interpVelX;
          mouseY += interpVelY;
        }
      } else {
        // Pointer off-screen: smoothly decelerate tracking and preserve position during ease-out
        interpVelX *= 0.8;
        interpVelY *= 0.8;
        mouseX += interpVelX;
        mouseY += interpVelY;
        if (rawMouseActive <= 0.002) {
          mouseX = -9999;
          mouseY = -9999;
        }
        smoothVelX = 0;
        smoothVelY = 0;
      }

      // Smooth Ease-In and Ease-Out for Pointer Force Field Activation & Deactivation
      const isPointerOnscreen = targetMouseX > -5000 && elapsed > 1600;
      const targetMouseActive = isPointerOnscreen ? 1.0 : 0.0;
      if (rawMouseActive < targetMouseActive) {
        rawMouseActive = Math.min(targetMouseActive, rawMouseActive + 0.035);
      } else if (rawMouseActive > targetMouseActive) {
        rawMouseActive = Math.max(targetMouseActive, rawMouseActive - 0.035);
      }
      // Smooth S-Curve Ease In & Out: Hermite cubic 3t^2 - 2t^3
      const easedMouseActive = rawMouseActive * rawMouseActive * (3.0 - 2.0 * rawMouseActive);

      // Smooth Ease-In and Ease-Out Mode Transitions
      if (pendingMode !== null) {
        modeTransitionProgress = Math.max(0.0, modeTransitionProgress - 0.075);
        if (modeTransitionProgress <= 0.0) {
          PARTICLE_CONFIG.interactiveMode = pendingMode;
          pendingMode = null;
        }
      } else if (modeTransitionProgress < 1.0) {
        modeTransitionProgress = Math.min(1.0, modeTransitionProgress + 0.065);
      }
      // Cubic Hermite Ease-In & Out for Mode Switching
      const modeEase = modeTransitionProgress * modeTransitionProgress * (3.0 - 2.0 * modeTransitionProgress);

      let currentDim = PARTICLE_CONFIG.initialOpacity;
      if (dimStartTime !== null) {
        const dimElapsed = (timestamp - dimStartTime) / 1000;
        const dimProgress = Math.min(1.0, Math.max(0.0, dimElapsed / PARTICLE_CONFIG.dimTransitionDuration));
        const dimEase = dimProgress * dimProgress * (3.0 - 2.0 * dimProgress);
        currentDim = PARTICLE_CONFIG.initialOpacity + (PARTICLE_CONFIG.settledDimOpacity - PARTICLE_CONFIG.initialOpacity) * dimEase;
      }

      const numImages = targetVBOs.length;
      let imgIndexA = 0;
      let imgIndexB = 0;
      let morphT = 0.0;

      if (numImages > 1) {
        let scrollFraction = 0.0;

        if (studioManualMorph !== null) {
          scrollFraction = studioManualMorph;
        } else {
          const scrollY = window.scrollY || window.pageYOffset || 0;
          const docHeight = document.documentElement.scrollHeight;
          const winHeight = window.innerHeight;
          const maxScroll = Math.max(1, docHeight - winHeight);
          scrollFraction = Math.min(1.0, Math.max(0.0, scrollY / maxScroll));
        }

        const totalSegments = numImages - 1;
        const rawSegmentPos = scrollFraction * totalSegments;
        imgIndexA = Math.min(numImages - 2, Math.floor(rawSegmentPos));
        imgIndexB = imgIndexA + 1;
        const localSegmentT = rawSegmentPos - imgIndexA;

        const plateau = PARTICLE_CONFIG.morphPlateau || 0.20;
        if (localSegmentT <= plateau) {
          morphT = 0.0;
        } else if (localSegmentT >= 1.0 - plateau) {
          morphT = 1.0;
        } else {
          const norm = (localSegmentT - plateau) / (1.0 - 2.0 * plateau);
          morphT = norm * norm * (3.0 - 2.0 * norm);
        }
      }

      const layoutA = getImageLayout(imgIndexA);
      const layoutB = getImageLayout(imgIndexB);

      const sizeA = curH * layoutA.scale;
      const centerAX = curW * layoutA.alignX;
      const centerAY = curH * layoutA.alignY;

      const sizeB = curH * layoutB.scale;
      const centerBX = curW * layoutB.alignX;
      const centerBY = curH * layoutB.alignY;

      gl.viewport(0, 0, curW, curH);
      gl.clearColor(0.0, 0.0, 0.0, 0.0);
      gl.clear(gl.COLOR_BUFFER_BIT);

      gl.uniform1f(uTimeLoc, elapsed);
      gl.uniform2f(uResolutionLoc, curW, curH);
      gl.uniform2f(uMouseLoc, mouseX, mouseY);
      gl.uniform2f(uMouseVelLoc, smoothVelX, smoothVelY);
      gl.uniform1f(uMouseSpeedLoc, cursorSpeed);
      gl.uniform1f(uMouseActiveLoc, easedMouseActive);
      gl.uniform1f(uCursorRadiusLoc, PARTICLE_CONFIG.cursorRadius);
      gl.uniform1f(uDimFactorLoc, currentDim);
      gl.uniform1f(uMorphTLoc, morphT);

      // Active Interactive Mode & Tuning Parameters (Eased during mode transition)
      gl.uniform1i(uInteractiveModeLoc, PARTICLE_CONFIG.interactiveMode);
      gl.uniform1f(uParamIntensityLoc, PARTICLE_CONFIG.effectIntensity * modeEase);
      gl.uniform1f(uParamSpeedLoc, PARTICLE_CONFIG.effectSpeed);
      gl.uniform1f(uRepelStrengthLoc, PARTICLE_CONFIG.repelStrength * modeEase);

      // Transforms
      gl.uniform2f(uCenterALoc, centerAX, centerAY);
      gl.uniform1f(uSizeALoc, sizeA);
      gl.uniform2f(uCenterBLoc, centerBX, centerBY);
      gl.uniform1f(uSizeBLoc, sizeB);

      // Bind Target A
      const vboA = targetVBOs[imgIndexA];
      gl.bindBuffer(gl.ARRAY_BUFFER, vboA);
      gl.enableVertexAttribArray(aTargetALoc);
      gl.vertexAttribPointer(aTargetALoc, 2, gl.FLOAT, false, 5 * 4, 0);
      gl.enableVertexAttribArray(aColorALoc);
      gl.vertexAttribPointer(aColorALoc, 3, gl.FLOAT, false, 5 * 4, 2 * 4);

      // Bind Target B
      const vboB = targetVBOs[imgIndexB];
      gl.bindBuffer(gl.ARRAY_BUFFER, vboB);
      gl.enableVertexAttribArray(aTargetBLoc);
      gl.vertexAttribPointer(aTargetBLoc, 2, gl.FLOAT, false, 5 * 4, 0);
      gl.enableVertexAttribArray(aColorBLoc);
      gl.vertexAttribPointer(aColorBLoc, 3, gl.FLOAT, false, 5 * 4, 2 * 4);

      // Bind Base
      gl.bindBuffer(gl.ARRAY_BUFFER, baseVBO);
      gl.enableVertexAttribArray(aOriginLoc);
      gl.vertexAttribPointer(aOriginLoc, 2, gl.FLOAT, false, 6 * 4, 0);
      gl.enableVertexAttribArray(aParamsLoc);
      gl.vertexAttribPointer(aParamsLoc, 4, gl.FLOAT, false, 6 * 4, 2 * 4);

      gl.drawArrays(gl.POINTS, 0, TARGET_PARTICLES);

      // Render Neural Constellation Synaptic Filaments
      if (constellCtx && constellCanvas) {
        if (constellCanvas.width !== curW || constellCanvas.height !== curH) {
          constellCanvas.width = curW;
          constellCanvas.height = curH;
        }
        constellCtx.clearRect(0, 0, curW, curH);

        if (PARTICLE_CONFIG.interactiveMode === 7 && mouseActive > 0.01 && mouseX > -100 && constellationNodes.length > 0) {
          const maxConnDist = PARTICLE_CONFIG.cursorRadius * 1.35;
          const activeLayout = getImageLayout(imgIndexA);
          const activeSize = curH * activeLayout.scale;
          const activeCX = curW * activeLayout.alignX;
          const activeCY = curH * activeLayout.alignY;

          // Find active nodes in cursor vicinity
          const activeNodes: { x: number; y: number; dist: number }[] = [];
          for (let i = 0; i < constellationNodes.length; i++) {
            const node = constellationNodes[i];
            const px = activeCX + node.nx * activeSize;
            const py = activeCY + node.ny * activeSize;
            const d = Math.hypot(px - mouseX, py - mouseY);
            if (d < maxConnDist) {
              activeNodes.push({ x: px, y: py, dist: d });
            }
          }

          if (activeNodes.length > 0) {
            activeNodes.sort((a, b) => a.dist - b.dist);
            const maxMouseLinks = Math.min(activeNodes.length, 14);

            constellCtx.save();
            constellCtx.lineWidth = 1.0;

            // 1. Draw glowing synaptic axon filaments to mouse
            for (let i = 0; i < maxMouseLinks; i++) {
              const n = activeNodes[i];
              const alpha = (1.0 - n.dist / maxConnDist) * 0.75 * PARTICLE_CONFIG.effectIntensity;
              constellCtx.strokeStyle = `rgba(212, 175, 55, ${alpha.toFixed(3)})`;
              constellCtx.beginPath();
              constellCtx.moveTo(mouseX, mouseY);
              constellCtx.lineTo(n.x, n.y);
              constellCtx.stroke();

              // Action potential traveling spark pulse
              const pulseT = (elapsed * 0.0028 * PARTICLE_CONFIG.effectSpeed + i * 0.18) % 1.0;
              const sx = mouseX + (n.x - mouseX) * pulseT;
              const sy = mouseY + (n.y - mouseY) * pulseT;
              constellCtx.fillStyle = `rgba(255, 245, 180, ${(alpha * 1.3).toFixed(3)})`;
              constellCtx.beginPath();
              constellCtx.arc(sx, sy, 1.8, 0, Math.PI * 2);
              constellCtx.fill();
            }

            // 2. Inter-node synaptic mesh
            const nodeConnLimit = 48;
            for (let i = 0; i < activeNodes.length; i++) {
              for (let j = i + 1; j < activeNodes.length; j++) {
                const d = Math.hypot(activeNodes[i].x - activeNodes[j].x, activeNodes[i].y - activeNodes[j].y);
                if (d < nodeConnLimit) {
                  const alpha = (1.0 - d / nodeConnLimit) * 0.42 * (1.0 - activeNodes[i].dist / maxConnDist) * PARTICLE_CONFIG.effectIntensity;
                  if (alpha > 0.02) {
                    constellCtx.strokeStyle = `rgba(212, 175, 55, ${alpha.toFixed(3)})`;
                    constellCtx.beginPath();
                    constellCtx.moveTo(activeNodes[i].x, activeNodes[i].y);
                    constellCtx.lineTo(activeNodes[j].x, activeNodes[j].y);
                    constellCtx.stroke();
                  }
                }
              }
            }

            // 3. Central neural cursor core
            constellCtx.fillStyle = 'rgba(212, 175, 55, 0.45)';
            constellCtx.beginPath();
            constellCtx.arc(mouseX, mouseY, 3.5, 0, Math.PI * 2);
            constellCtx.fill();

            constellCtx.restore();
          }
        }
      }

      if (studioActive && studioGizmoVisible) {
        updateGizmoPosition(curW, curH);
      }

      if (elapsed > PARTICLE_CONFIG.introGatherDuration && !elementsRevealed) {
        elementsRevealed = true;
        if (veil) {
          veil.classList.add('opacity-0');
          setTimeout(() => veil.classList.add('hidden'), 1000);
        }

        revealSequentialElements(() => {
          setTimeout(() => {
            dimStartTime = performance.now();
          }, 300);
        });
      }

      currentAnimId = requestAnimationFrame(render);
    }

    currentAnimId = requestAnimationFrame(render);
  }

  function fallbackCanvas2D(
    canvas: HTMLCanvasElement, 
    veil: HTMLElement | null
  ) {
    if (veil) {
      veil.classList.add('opacity-0');
      setTimeout(() => veil.classList.add('hidden'), 900);
    }
    revealSequentialElements();
  }

  function revealSequentialElements(onAllRevealed?: () => void) {
    const header = document.querySelector('header');
    const seq1 = document.querySelector('.luxury-seq-1');
    const seq2 = document.querySelector('.luxury-seq-2');
    const seq3 = document.querySelector('.luxury-seq-3');
    const seq4 = document.querySelector('.luxury-seq-4');
    const seq5 = document.querySelector('.luxury-seq-5');
    const replayBtn = document.getElementById('replay-luxury-btn');
    const studioBtn = document.getElementById('particle-studio-btn');
    const scrollIndicator = document.getElementById('luxury-scroll-indicator');
    const themeSwitcher = document.getElementById('theme-switcher-widget');
    const fontTester = document.getElementById('font-tester-root');
    const seqRest = document.querySelectorAll('.luxury-seq-rest');
    const footer = document.querySelector('footer');

    const stagger = PARTICLE_CONFIG.elementStaggerDelay;

    setTimeout(() => header?.classList.add('luxury-revealed'), 100);
    setTimeout(() => seq1?.classList.add('luxury-revealed'), 100 + stagger);
    setTimeout(() => seq2?.classList.add('luxury-revealed'), 100 + stagger * 2);
    setTimeout(() => seq3?.classList.add('luxury-revealed'), 100 + stagger * 3);
    setTimeout(() => seq4?.classList.add('luxury-revealed'), 100 + stagger * 4);
    setTimeout(() => {
      seq5?.classList.add('luxury-revealed');
      replayBtn?.classList.add('luxury-revealed');
      studioBtn?.classList.add('luxury-revealed');
      const modeDock = document.getElementById('luxury-mode-dock');
      if (modeDock) {
        modeDock.classList.remove('opacity-0', 'translate-y-4');
        modeDock.classList.add('opacity-100', 'translate-y-0');
        if (typeof (window as any).showLuxuryModeToast === 'function') {
          setTimeout(() => {
            (window as any).showLuxuryModeToast?.(PARTICLE_CONFIG.interactiveMode, false, PARTICLE_CONFIG.isRandomMode);
          }, 350);
        }
      }
    }, 100 + stagger * 5);

    const finalDelay = 100 + stagger * 6;
    setTimeout(() => {
      scrollIndicator?.classList.add('luxury-revealed');
      themeSwitcher?.classList.add('luxury-revealed');
      fontTester?.classList.add('luxury-revealed');
      footer?.classList.add('luxury-revealed');
      seqRest.forEach((el) => el.classList.add('luxury-revealed'));
      document.documentElement.classList.remove('luxury-animating');

      if (onAllRevealed) {
        onAllRevealed();
      }
    }, finalDelay);
  }

  // =========================================================================
  // 🛠️ INTERACTIVE PARTICLE PLACEMENT STUDIO & MODE CONTROLLER
  // =========================================================================
  function setupInteractiveStudioUI() {
    const studioBtn = document.getElementById('particle-studio-btn');
    const studioPanel = document.getElementById('particle-studio-panel');
    const studioCloseBtn = document.getElementById('studio-close-btn');
    const imageTabsContainer = document.getElementById('studio-image-tabs');
    const morphMarkersContainer = document.getElementById('studio-morph-markers');
    const scaleSlider = document.getElementById('studio-scale-slider') as HTMLInputElement | null;
    const alignXSlider = document.getElementById('studio-alignx-slider') as HTMLInputElement | null;
    const alignYSlider = document.getElementById('studio-aligny-slider') as HTMLInputElement | null;
    const morphSlider = document.getElementById('studio-morph-slider') as HTMLInputElement | null;
    const toggleGizmo = document.getElementById('studio-toggle-gizmo') as HTMLInputElement | null;
    const syncScrollBtn = document.getElementById('studio-sync-scroll-btn');
    const copyBtn = document.getElementById('studio-copy-btn');
    const saveBtn = document.getElementById('studio-save-btn');
    const resetBtn = document.getElementById('studio-reset-btn');
    const gizmo = document.getElementById('particle-placement-gizmo');
    const dragHeader = document.getElementById('studio-drag-header');

    // Dock & Toast Elements
    const modeDock = document.getElementById('luxury-mode-dock');
    const modeDockMinimized = document.getElementById('luxury-mode-dock-minimized');
    const dockMinimizeBtn = document.getElementById('dock-minimize-btn');
    const dockLockBtn = document.getElementById('dock-lock-btn');
    const dockRandomBtn = document.getElementById('dock-random-btn');
    const toastEl = document.getElementById('luxury-mode-toast');
    const toastTitle = document.getElementById('toast-title');
    const toastDesc = document.getElementById('toast-desc');
    let toastTimer: any = null;

    const MODE_DESCRIPTIONS = [
      {
        name: 'Volumetric Quantum Aura',
        desc: 'Move cursor — concentric holographic orbital drift and breathing aura around silhouette with pristine face stability.',
      },
      {
        name: 'Silk Surface Ripple',
        desc: 'Move cursor over face — generates soft, concentric liquid gold waves radiating outwards.',
      },
      {
        name: 'Celestial Lantern',
        desc: 'Cursor acts as a bioluminescent light wand — igniting particles with warm stardust bloom without distortion.',
      },
      {
        name: 'Gravitational Lens',
        desc: 'Move cursor around face — cosmic space-time curvature bends particles along Einstein ring orbits.',
      },
      {
        name: 'Fluid Stardust Wake',
        desc: 'Swipe or flick cursor — leaves swirling fluid curl-noise eddies and velocity momentum behind.',
      },
      {
        name: 'Soft Physics Displace',
        desc: 'Simple, velvety soft displacement with Gaussian decay, viscous fluid drag, and elastic spring recovery.',
      },
      {
        name: 'Neural Constellation',
        desc: 'Luminous synaptic filaments connect particles to cursor with traveling neural action potentials.',
      },
      {
        name: 'Holographic Cyber Scanlines',
        desc: 'Vertical scanning laser sweep, horizontal quantum comb slices, and chromatic holographic nano-particle glints.',
      },
    ];

    function showModeToast(mode: number, isLock = false, isRandom = false) {
      if (!toastEl || !toastTitle || !toastDesc) return;
      const info = MODE_DESCRIPTIONS[mode - 1] || MODE_DESCRIPTIONS[0];
      if (isLock) {
        toastTitle.textContent = `⭐ Mode ${mode} Locked: ${info.name}`;
        toastDesc.textContent = `Saved as your permanent choice! This mode will stay active across all visits.`;
      } else if (isRandom) {
        toastTitle.textContent = `🎲 Random Effect Active: Mode ${mode} — ${info.name}`;
        toastDesc.textContent = `${info.desc} (Randomized on every page load — press R to shuffle!)`;
      } else {
        toastTitle.textContent = `Mode ${mode}: ${info.name}`;
        toastDesc.textContent = `${info.desc} (Click 'Keep This' to lock, or 'Random Load' to shuffle)`;
      }
      toastEl.classList.remove('opacity-0', '-translate-y-2');
      toastEl.classList.add('opacity-100', 'translate-y-0');

      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => {
        toastEl.classList.remove('opacity-100', 'translate-y-0');
        toastEl.classList.add('opacity-0', '-translate-y-2');
      }, 3400);
    }
    (window as any).showLuxuryModeToast = showModeToast;

    // Mode Sliders
    const intensitySlider = document.getElementById('studio-intensity-slider') as HTMLInputElement | null;
    const speedSlider = document.getElementById('studio-speed-slider') as HTMLInputElement | null;
    const radiusSlider = document.getElementById('studio-radius-slider') as HTMLInputElement | null;

    if (!studioBtn || !studioPanel) return;

    // Toggle button
    studioBtn.onclick = () => {
      studioActive = !studioActive;
      toggleStudioPanel(studioActive);
    };

    studioCloseBtn?.addEventListener('click', () => {
      studioActive = false;
      toggleStudioPanel(false);
    });

    // Mode Buttons Click Handlers
    function updateActiveModeUI() {
      // 1. Update Studio Panel Buttons
      document.querySelectorAll('#studio-mode-buttons .mode-btn').forEach((btn) => {
        const mode = parseInt(btn.getAttribute('data-mode') || '1', 10);
        const dot = btn.querySelector('.mode-dot');
        if (mode === (pendingMode || PARTICLE_CONFIG.interactiveMode)) {
          btn.className = 'mode-btn flex items-center justify-between px-3 py-2 rounded-lg font-mono text-[11px] text-left transition-all duration-300 ease-in-out cursor-pointer bg-[#d4af37] text-zinc-950 font-bold shadow-md';
          dot?.classList.remove('bg-zinc-600');
          dot?.classList.add('bg-zinc-950');
        } else {
          btn.className = 'mode-btn flex items-center justify-between px-3 py-2 rounded-lg font-mono text-[11px] text-left transition-all duration-300 ease-in-out cursor-pointer text-zinc-300 hover:text-white hover:bg-zinc-800';
          dot?.classList.remove('bg-zinc-950');
          dot?.classList.add('bg-zinc-600');
        }
      });

      // 2. Update Floating Dock Buttons
      document.querySelectorAll('.dock-mode-btn').forEach((btn) => {
        const mode = parseInt(btn.getAttribute('data-dock-mode') || '1', 10);
        const badge = btn.querySelector('.dock-badge');
        if (mode === (pendingMode || PARTICLE_CONFIG.interactiveMode)) {
          btn.className = 'dock-mode-btn px-2.5 py-1.5 rounded-full transition-all duration-300 ease-in-out cursor-pointer text-[11px] flex items-center gap-1.5 bg-[#d4af37] text-zinc-950 font-bold shadow-md';
          badge?.classList.remove('bg-zinc-800');
          badge?.classList.add('bg-zinc-950', 'text-[#d4af37]');
        } else {
          btn.className = 'dock-mode-btn px-2.5 py-1.5 rounded-full transition-all duration-300 ease-in-out cursor-pointer text-[11px] flex items-center gap-1.5 text-zinc-300 hover:text-white hover:bg-zinc-800';
          badge?.classList.remove('bg-zinc-950', 'text-[#d4af37]');
          badge?.classList.add('bg-zinc-800');
        }
      });

      // 3. Update Random vs Lock Button State in Dock
      const randomText = document.getElementById('dock-random-text');
      const lockText = document.getElementById('dock-lock-text');
      const currentOrPendingMode = pendingMode || PARTICLE_CONFIG.interactiveMode;
      if (PARTICLE_CONFIG.isRandomMode) {
        if (dockRandomBtn) {
          dockRandomBtn.className = 'px-2.5 py-1.5 rounded-full transition-all duration-300 ease-in-out cursor-pointer text-[11px] flex items-center gap-1.5 bg-[#d4af37]/20 border border-[#d4af37]/60 text-[#d4af37] font-semibold shadow-sm';
        }
        if (randomText) randomText.textContent = 'Random: ON';
        if (dockLockBtn) {
          dockLockBtn.className = 'px-3 py-1.5 rounded-full bg-zinc-900/80 hover:bg-[#d4af37] text-zinc-300 hover:text-zinc-950 border border-zinc-700/80 font-medium text-[11px] transition-all duration-300 ease-in-out cursor-pointer flex items-center gap-1.5 shadow-sm whitespace-nowrap';
        }
        if (lockText) lockText.textContent = 'Keep This';
      } else {
        if (dockRandomBtn) {
          dockRandomBtn.className = 'px-2.5 py-1.5 rounded-full transition-all duration-300 ease-in-out cursor-pointer text-[11px] flex items-center gap-1.5 text-zinc-400 hover:text-white hover:bg-zinc-800 border border-transparent';
        }
        if (randomText) randomText.textContent = 'Random Load';
        if (dockLockBtn) {
          dockLockBtn.className = 'px-3 py-1.5 rounded-full bg-[#d4af37] text-zinc-950 font-bold border border-[#d4af37] text-[11px] transition-all duration-300 ease-in-out cursor-pointer flex items-center gap-1.5 shadow-md whitespace-nowrap';
        }
        if (lockText) lockText.textContent = `✓ Kept (Mode ${currentOrPendingMode})`;
      }

      // Update dynamic slider labels based on active mode
      const intensityLabel = document.getElementById('studio-intensity-label');
      const speedLabel = document.getElementById('studio-speed-label');
      if (intensityLabel && speedLabel) {
        const displayMode = currentOrPendingMode;
        if (displayMode === 1) {
          intensityLabel.textContent = 'Quantum Aura Field Strength';
          speedLabel.textContent = 'Laser Ring Wave Speed';
        } else if (displayMode === 2) {
          intensityLabel.textContent = 'Liquid Wave Amplitude';
          speedLabel.textContent = 'Ripple Wave Speed';
        } else if (displayMode === 3) {
          intensityLabel.textContent = 'Lantern Radiance & Bloom';
          speedLabel.textContent = 'Bioluminescent Ambient Lift';
        } else if (displayMode === 4) {
          intensityLabel.textContent = 'Gravitational Curvature Strength';
          speedLabel.textContent = 'Einstein Radius Streamlines';
        } else if (displayMode === 5) {
          intensityLabel.textContent = 'Curl Turbulence & Wake';
          speedLabel.textContent = 'Swipe Force Momentum';
        } else if (displayMode === 6) {
          intensityLabel.textContent = 'Soft Elastic Cushion Strength';
          speedLabel.textContent = 'Viscous Drag & Fluid Momentum';
        } else if (displayMode === 7) {
          intensityLabel.textContent = 'Synaptic Filament Density';
          speedLabel.textContent = 'Neural Pulse Signal Speed';
        } else if (displayMode === 8) {
          intensityLabel.textContent = 'Scanline Laser Slice Width';
          speedLabel.textContent = 'Laser Sweep Velocity';
        }
      }
    }

    function switchMode(mode: number, showToast = true) {
      if (mode === PARTICLE_CONFIG.interactiveMode && pendingMode === null) return;
      pendingMode = mode;
      updateActiveModeUI();
      saveSettingsToStorage();
      if (showToast) {
        showModeToast(mode);
      }
    }

    function triggerRandomMode() {
      localStorage.removeItem('luxury_particle_locked_mode');
      PARTICLE_CONFIG.isRandomMode = true;
      let nextMode = Math.floor(Math.random() * 8) + 1;
      if (nextMode === PARTICLE_CONFIG.interactiveMode) {
        nextMode = (nextMode % 8) + 1;
      }
      switchMode(nextMode, false);
      showModeToast(nextMode, false, true);
    }

    // Studio panel buttons listener
    document.querySelectorAll('#studio-mode-buttons .mode-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const mode = parseInt((e.currentTarget as HTMLElement).getAttribute('data-mode') || '1', 10);
        switchMode(mode);
      });
    });

    // Dock buttons listener
    document.querySelectorAll('.dock-mode-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const mode = parseInt((e.currentTarget as HTMLElement).getAttribute('data-dock-mode') || '1', 10);
        switchMode(mode);
      });
    });

    // Randomize on Load Button Listener
    dockRandomBtn?.addEventListener('click', () => {
      triggerRandomMode();
    });

    // Dock Minimize & Restore
    dockMinimizeBtn?.addEventListener('click', () => {
      modeDock?.classList.add('hidden');
      modeDockMinimized?.classList.remove('hidden');
      modeDockMinimized?.classList.add('flex');
    });

    modeDockMinimized?.addEventListener('click', () => {
      modeDockMinimized?.classList.add('hidden');
      modeDockMinimized?.classList.remove('flex');
      modeDock?.classList.remove('hidden');
    });

    // Lock Mode Button
    dockLockBtn?.addEventListener('click', () => {
      const mode = PARTICLE_CONFIG.interactiveMode;
      localStorage.setItem('luxury_particle_locked_mode', String(mode));
      PARTICLE_CONFIG.isRandomMode = false;
      saveSettingsToStorage();
      updateActiveModeUI();
      showModeToast(mode, true);
    });

    // Keyboard Shortcuts: Keys 1 to 8 to switch modes live, R to randomize, Alt+P for Studio
    window.addEventListener('keydown', (e) => {
      const activeTag = (document.activeElement?.tagName || '').toUpperCase();
      if (activeTag === 'INPUT' || activeTag === 'TEXTAREA') return;

      if (e.altKey && (e.key === 'p' || e.key === 'P')) {
        studioActive = !studioActive;
        toggleStudioPanel(studioActive);
        return;
      }

      if (e.key === 'r' || e.key === 'R') {
        triggerRandomMode();
        return;
      }

      if (['1', '2', '3', '4', '5', '6', '7', '8'].includes(e.key)) {
        const mode = parseInt(e.key, 10);
        switchMode(mode);
      }
    });

    updateActiveModeUI();

    // Mode Sliders Listeners
    intensitySlider?.addEventListener('input', () => {
      PARTICLE_CONFIG.effectIntensity = parseFloat(intensitySlider.value);
      const valEl = document.getElementById('studio-intensity-val');
      if (valEl) valEl.textContent = `${PARTICLE_CONFIG.effectIntensity.toFixed(2)}x`;
    });

    speedSlider?.addEventListener('input', () => {
      PARTICLE_CONFIG.effectSpeed = parseFloat(speedSlider.value);
      const valEl = document.getElementById('studio-speed-val');
      if (valEl) valEl.textContent = `${PARTICLE_CONFIG.effectSpeed.toFixed(2)}x`;
    });

    radiusSlider?.addEventListener('input', () => {
      PARTICLE_CONFIG.cursorRadius = parseFloat(radiusSlider.value);
      const valEl = document.getElementById('studio-radius-val');
      if (valEl) valEl.textContent = `${Math.round(PARTICLE_CONFIG.cursorRadius)}px`;
    });

    // Render image selector tabs
    if (imageTabsContainer) {
      imageTabsContainer.innerHTML = '';
      PARTICLE_CONFIG.images.forEach((_, idx) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `py-1.5 px-2 rounded-md font-mono text-[11px] transition-all cursor-pointer text-center ${
          idx === selectedImageIdx
            ? 'bg-[#d4af37] text-zinc-950 font-bold shadow-md'
            : 'text-zinc-400 hover:text-white hover:bg-zinc-800'
        }`;
        btn.textContent = `Image ${idx + 1}`;
        btn.onclick = () => {
          selectImageTab(idx);
        };
        imageTabsContainer.appendChild(btn);
      });
    }

    // Render morph scrub markers
    if (morphMarkersContainer) {
      morphMarkersContainer.innerHTML = '';
      PARTICLE_CONFIG.images.forEach((_, idx) => {
        const span = document.createElement('span');
        span.textContent = `Img ${idx + 1}`;
        morphMarkersContainer.appendChild(span);
      });
    }

    syncControlsToActiveImage();

    // Scale slider input
    scaleSlider?.addEventListener('input', () => {
      const layout = getImageLayout(selectedImageIdx);
      layout.scale = parseFloat(scaleSlider.value);
      const valEl = document.getElementById('studio-scale-val');
      if (valEl) valEl.textContent = `${layout.scale.toFixed(2)}x`;
      updateGizmoPosition(window.innerWidth, window.innerHeight);
      saveSettingsToStorage();
    });

    // Align X slider input
    alignXSlider?.addEventListener('input', () => {
      const layout = getImageLayout(selectedImageIdx);
      layout.alignX = parseFloat(alignXSlider.value);
      const valEl = document.getElementById('studio-alignx-val');
      if (valEl) valEl.textContent = `${Math.round(layout.alignX * 100)}%`;
      updateGizmoPosition(window.innerWidth, window.innerHeight);
      saveSettingsToStorage();
    });

    // Align Y slider input
    alignYSlider?.addEventListener('input', () => {
      const layout = getImageLayout(selectedImageIdx);
      layout.alignY = parseFloat(alignYSlider.value);
      const valEl = document.getElementById('studio-aligny-val');
      if (valEl) valEl.textContent = `${Math.round(layout.alignY * 100)}%`;
      updateGizmoPosition(window.innerWidth, window.innerHeight);
      saveSettingsToStorage();
    });

    // Preset buttons for X
    document.querySelectorAll('.preset-x-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const val = parseFloat(target.getAttribute('data-val') || '0.5');
        const layout = getImageLayout(selectedImageIdx);
        layout.alignX = val;
        if (alignXSlider) alignXSlider.value = String(val);
        const valEl = document.getElementById('studio-alignx-val');
        if (valEl) valEl.textContent = `${Math.round(val * 100)}%`;
        updateGizmoPosition(window.innerWidth, window.innerHeight);
        saveSettingsToStorage();
      });
    });

    // Toggle gizmo visibility checkbox
    toggleGizmo?.addEventListener('change', () => {
      studioGizmoVisible = toggleGizmo.checked;
      if (!studioGizmoVisible && gizmo) {
        gizmo.classList.add('hidden');
      } else if (studioGizmoVisible && studioActive && gizmo) {
        gizmo.classList.remove('hidden');
        updateGizmoPosition(window.innerWidth, window.innerHeight);
      }
    });

    // Morph scrub slider input
    morphSlider?.addEventListener('input', () => {
      const pct = parseFloat(morphSlider.value);
      studioManualMorph = pct / 100;
      const morphValEl = document.getElementById('studio-morph-val');
      if (morphValEl) morphValEl.textContent = `${Math.round(pct)}%`;
    });

    syncScrollBtn?.addEventListener('click', () => {
      studioManualMorph = null;
      if (morphSlider) {
        const scrollY = window.scrollY || window.pageYOffset || 0;
        const docHeight = document.documentElement.scrollHeight;
        const winHeight = window.innerHeight;
        const maxScroll = Math.max(1, docHeight - winHeight);
        const curPct = Math.min(100, Math.max(0, (scrollY / maxScroll) * 100));
        morphSlider.value = curPct.toFixed(1);
        const morphValEl = document.getElementById('studio-morph-val');
        if (morphValEl) morphValEl.textContent = `${Math.round(curPct)}%`;
      }
    });

    // Copy Configuration Code
    copyBtn?.addEventListener('click', () => {
      const code = `interactiveMode: ${PARTICLE_CONFIG.interactiveMode},\nimageLayouts: ${JSON.stringify(PARTICLE_CONFIG.imageLayouts, null, 2)},\neffectIntensity: ${PARTICLE_CONFIG.effectIntensity},\ncursorRadius: ${PARTICLE_CONFIG.cursorRadius},`;
      navigator.clipboard.writeText(code).then(() => {
        const textEl = document.getElementById('studio-copy-text');
        if (textEl) textEl.textContent = '✓ Copied!';
        setTimeout(() => {
          if (textEl) textEl.textContent = 'Copy Code';
        }, 2000);
      });
    });

    // Save to Browser button
    saveBtn?.addEventListener('click', () => {
      saveSettingsToStorage();
      const textEl = document.getElementById('studio-save-text');
      if (textEl) textEl.textContent = '✓ Saved!';
      setTimeout(() => {
        if (textEl) textEl.textContent = 'Save to Browser';
      }, 2000);
    });

    // Reset Defaults
    resetBtn?.addEventListener('click', () => {
      if (confirm('Reset all particle settings to defaults?')) {
        localStorage.removeItem('luxury_particle_layouts');
        localStorage.removeItem('luxury_particle_mode');
        PARTICLE_CONFIG.imageLayouts = JSON.parse(JSON.stringify(DEFAULT_IMAGE_LAYOUTS));
        PARTICLE_CONFIG.interactiveMode = 1;
        updateActiveModeUI();
        syncControlsToActiveImage();
        updateGizmoPosition(window.innerWidth, window.innerHeight);
      }
    });

    setupGizmoInteractions();
    setupPanelDrag(dragHeader, studioPanel);
  }

  function toggleStudioPanel(open: boolean) {
    const studioPanel = document.getElementById('particle-studio-panel');
    const gizmo = document.getElementById('particle-placement-gizmo');
    if (!studioPanel) return;

    if (open) {
      studioPanel.classList.remove('hidden');
      if (studioGizmoVisible && gizmo) {
        gizmo.classList.remove('hidden');
        updateGizmoPosition(window.innerWidth, window.innerHeight);
      }
      syncControlsToActiveImage();
    } else {
      studioPanel.classList.add('hidden');
      gizmo?.classList.add('hidden');
      studioManualMorph = null;
    }
  }

  function closeStudioPanel() {
    studioActive = false;
    toggleStudioPanel(false);
  }

  function selectImageTab(idx: number) {
    selectedImageIdx = idx;
    const tabs = document.querySelectorAll('#studio-image-tabs button');
    tabs.forEach((tab, i) => {
      if (i === idx) {
        tab.className = 'py-1.5 px-2 rounded-md font-mono text-[11px] transition-all cursor-pointer text-center bg-[#d4af37] text-zinc-950 font-bold shadow-md';
      } else {
        tab.className = 'py-1.5 px-2 rounded-md font-mono text-[11px] transition-all cursor-pointer text-center text-zinc-400 hover:text-white hover:bg-zinc-800';
      }
    });

    const numImages = PARTICLE_CONFIG.images.length;
    if (numImages > 1) {
      studioManualMorph = idx / (numImages - 1);
      const morphSlider = document.getElementById('studio-morph-slider') as HTMLInputElement | null;
      if (morphSlider) {
        morphSlider.value = String(studioManualMorph * 100);
        const morphValEl = document.getElementById('studio-morph-val');
        if (morphValEl) morphValEl.textContent = `${Math.round(studioManualMorph * 100)}%`;
      }
    }

    syncControlsToActiveImage();
    updateGizmoPosition(window.innerWidth, window.innerHeight);
  }

  function syncControlsToActiveImage() {
    const layout = getImageLayout(selectedImageIdx);
    const scaleSlider = document.getElementById('studio-scale-slider') as HTMLInputElement | null;
    const alignXSlider = document.getElementById('studio-alignx-slider') as HTMLInputElement | null;
    const alignYSlider = document.getElementById('studio-aligny-slider') as HTMLInputElement | null;

    if (scaleSlider) scaleSlider.value = layout.scale.toFixed(2);
    if (alignXSlider) alignXSlider.value = layout.alignX.toFixed(3);
    if (alignYSlider) alignYSlider.value = layout.alignY.toFixed(3);

    const scaleVal = document.getElementById('studio-scale-val');
    const alignXVal = document.getElementById('studio-alignx-val');
    const alignYVal = document.getElementById('studio-aligny-val');

    if (scaleVal) scaleVal.textContent = `${layout.scale.toFixed(2)}x`;
    if (alignXVal) alignXVal.textContent = `${Math.round(layout.alignX * 100)}%`;
    if (alignYVal) alignYVal.textContent = `${Math.round(layout.alignY * 100)}%`;
  }

  function updateGizmoPosition(screenW: number, screenH: number) {
    const gizmo = document.getElementById('particle-placement-gizmo');
    if (!gizmo || !studioActive || !studioGizmoVisible) return;

    const layout = getImageLayout(selectedImageIdx);
    const aspect = activeImageAspects[selectedImageIdx] || 1.0;
    const size = screenH * layout.scale;
    const drawW = size * aspect;
    const drawH = size;
    const centerX = screenW * layout.alignX;
    const centerY = screenH * layout.alignY;

    const left = centerX - drawW / 2;
    const top = centerY - drawH / 2;

    gizmo.style.left = `${left}px`;
    gizmo.style.top = `${top}px`;
    gizmo.style.width = `${drawW}px`;
    gizmo.style.height = `${drawH}px`;

    const label = document.getElementById('gizmo-label');
    const coords = document.getElementById('gizmo-coords');
    if (label) label.textContent = `Image ${selectedImageIdx + 1}`;
    if (coords) {
      coords.textContent = `X: ${(layout.alignX * 100).toFixed(1)}% Y: ${(layout.alignY * 100).toFixed(1)}% S: ${layout.scale.toFixed(2)}x`;
    }
  }

  function setupGizmoInteractions() {
    const gizmo = document.getElementById('particle-placement-gizmo');
    if (!gizmo) return;

    let isDragging = false;
    let isScaling = false;
    let startX = 0;
    let startY = 0;
    let startAlignX = 0;
    let startAlignY = 0;
    let startScale = 1.0;
    let startDist = 0;

    gizmo.addEventListener('pointerdown', (e) => {
      e.stopPropagation();
      e.preventDefault();

      const target = e.target as HTMLElement;
      const layout = getImageLayout(selectedImageIdx);
      const screenW = window.innerWidth;
      const screenH = window.innerHeight;

      targetMouseX = -9999;
      targetMouseY = -9999;
      mouseVelX = 0;
      mouseVelY = 0;

      if (target.classList.contains('gizmo-handle')) {
        isScaling = true;
        startX = e.clientX;
        startY = e.clientY;
        startScale = layout.scale;
        const cx = screenW * layout.alignX;
        const cy = screenH * layout.alignY;
        startDist = Math.hypot(e.clientX - cx, e.clientY - cy);
      } else {
        isDragging = true;
        startX = e.clientX;
        startY = e.clientY;
        startAlignX = layout.alignX;
        startAlignY = layout.alignY;
      }

      window.addEventListener('pointermove', onPointerMove);
      window.addEventListener('pointerup', onPointerUp);
    });

    function onPointerMove(e: PointerEvent) {
      const layout = getImageLayout(selectedImageIdx);
      const screenW = window.innerWidth;
      const screenH = window.innerHeight;

      if (isDragging) {
        const dx = e.clientX - startX;
        const dy = e.clientY - startY;
        layout.alignX = Math.max(0.02, Math.min(0.98, startAlignX + dx / screenW));
        layout.alignY = Math.max(0.02, Math.min(0.98, startAlignY + dy / screenH));
        syncControlsToActiveImage();
        updateGizmoPosition(screenW, screenH);
      } else if (isScaling) {
        const cx = screenW * layout.alignX;
        const cy = screenH * layout.alignY;
        const curDist = Math.hypot(e.clientX - cx, e.clientY - cy);
        const ratio = curDist / Math.max(10, startDist);
        layout.scale = Math.max(0.20, Math.min(2.50, startScale * ratio));
        syncControlsToActiveImage();
        updateGizmoPosition(screenW, screenH);
      }
    }

    function onPointerUp() {
      if (isDragging || isScaling) {
        saveSettingsToStorage();
      }
      isDragging = false;
      isScaling = false;
      window.removeEventListener('pointermove', onPointerMove);
      window.removeEventListener('pointerup', onPointerUp);
    }
  }

  function setupPanelDrag(header: HTMLElement | null, panel: HTMLElement) {
    if (!header) return;

    let isDragging = false;
    let startX = 0;
    let startY = 0;
    let initialLeft = 0;
    let initialTop = 0;

    header.addEventListener('pointerdown', (e) => {
      if ((e.target as HTMLElement).closest('#studio-close-btn')) return;
      isDragging = true;
      startX = e.clientX;
      startY = e.clientY;
      const rect = panel.getBoundingClientRect();
      initialLeft = rect.left;
      initialTop = rect.top;

      panel.style.bottom = 'auto';
      panel.style.right = 'auto';
      panel.style.left = `${initialLeft}px`;
      panel.style.top = `${initialTop}px`;

      window.addEventListener('pointermove', onPointerMove);
      window.addEventListener('pointerup', onPointerUp);
    });

    function onPointerMove(e: PointerEvent) {
      if (!isDragging) return;
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      panel.style.left = `${Math.max(10, Math.min(window.innerWidth - 410, initialLeft + dx))}px`;
      panel.style.top = `${Math.max(10, Math.min(window.innerHeight - 150, initialTop + dy))}px`;
    }

    function onPointerUp() {
      isDragging = false;
      window.removeEventListener('pointermove', onPointerMove);
      window.removeEventListener('pointerup', onPointerUp);
    }
  }

  window.addEventListener('replay-luxury-intro', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
    document.documentElement.classList.add('luxury-animating');
    document.querySelectorAll('.luxury-revealed').forEach(el => el.classList.remove('luxury-revealed'));
    setTimeout(initLuxuryCinematicIntro, 350);
  });

  const observer = new MutationObserver((mutations) => {
    for (const mutation of mutations) {
      if (mutation.type === 'attributes' && mutation.attributeName === 'data-theme') {
        const theme = document.documentElement.getAttribute('data-theme');
        if (theme === 'luxury') {
          initLuxuryCinematicIntro();
        } else {
          if (currentAnimId) cancelAnimationFrame(currentAnimId);
          document.documentElement.classList.remove('luxury-animating');
          document.getElementById('luxury-veil')?.classList.add('hidden');
          document.getElementById('luxury-particle-canvas')?.classList.add('hidden');
          document.getElementById('particle-studio-btn')?.classList.add('hidden');
          closeStudioPanel();
          const portraitImg = document.getElementById('luxury-portrait-img');
          if (portraitImg) {
            portraitImg.style.opacity = '1';
            portraitImg.style.display = '';
          }
        }
      }
    }
  });

  observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLuxuryCinematicIntro);
  } else {
    initLuxuryCinematicIntro();
  }
</script>
