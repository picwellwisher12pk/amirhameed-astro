<script>
  // =========================================================================
  // 🎛️ LUXURY PARTICLE SYSTEM CONFIGURATION - TWEAK ANY SETTING FREELY
  // =========================================================================
  const DEFAULT_IMAGE_LAYOUTS = [
    {
      scale: 1.0936430948476303,
      alignX: 0.7600426894343649,
      alignY: 0.48698481561822127,
    },
    {
      scale: 1.047331014887852,
      alignX: 0.7465314834578441,
      alignY: 0.48590021691973967,
    },
    {
      scale: 1.1170019439785475,
      alignX: 0.8046424759871932,
      alignY: 0.4436008676789588,
    },
  ];

  const PARTICLE_CONFIG = {
    // 1. POSITIONING & SIZING PER IMAGE
    imageLayouts: JSON.parse(JSON.stringify(DEFAULT_IMAGE_LAYOUTS)),

    // 2. 🔮 7 SWITCHABLE ORGANIC INTERACTIVE MODES
    // 1: 3D Holographic Parallax (Tilt & Depth Relief)
    // 2: Silk Surface Ripple (Liquid Gold Waves)
    // 3: Celestial Lantern (Bioluminescent Light)
    // 4: Gravitational Lens (Cosmic Curvature)
