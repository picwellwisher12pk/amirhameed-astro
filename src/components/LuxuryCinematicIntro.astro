---
// Luxury Classical Cinematic Fullscreen High-Density Nano-Particle Cloud Intro (WebGL GPU-Accelerated)
// 5 Switchable Organic Interaction Modes: 3D Hologram, Silk Ripple, Celestial Lantern, Gravity Lens, Fluid Wake
---

<!-- Pitch-black cinematic veil (active during luxury theme entrance) -->
<div
  id="luxury-veil"
  class="fixed inset-0 z-[2] bg-black pointer-events-none transition-opacity duration-1000 opacity-0 hidden"
  aria-hidden="true"
>
</div>

<!-- Massive high-density nano-particle gathering canvas (Fullscreen WebGL) -->
<canvas
  id="luxury-particle-canvas"
  class="fixed inset-0 z-[5] pointer-events-none hidden"
  aria-hidden="true"></canvas>

<!-- Foreground nano-particles & constellation overlay (Fullscreen 2D Canvas above text & images) -->
<canvas
  id="luxury-constellation-canvas"
  class="fixed inset-0 z-[20] pointer-events-none hidden"
  aria-hidden="true"></canvas>

<!-- Interactive On-Screen Transform Gizmo (Visible when Particle Studio is open) -->
<div
  id="particle-placement-gizmo"
  class="fixed z-40 hidden pointer-events-auto border-2 border-dashed border-[#d4af37]/80 rounded-xl select-none cursor-move transition-[box-shadow] duration-200"
  style="box-shadow: 0 0 35px rgba(212, 175, 55, 0.22), inset 0 0 25px rgba(212, 175, 55, 0.08);"
  aria-label="Particle Image Placement Gizmo"
>
  <!-- Image Info & Coordinate Badge at Top Left -->
  <div
    class="absolute -top-8 left-0 px-2.5 py-1 rounded-md bg-zinc-950/95 border border-[#d4af37]/50 text-[11px] font-mono text-[#d4af37] whitespace-nowrap pointer-events-none flex items-center gap-2 shadow-2xl backdrop-blur-md"
  >
    <span class="w-2 h-2 rounded-full bg-[#d4af37] animate-pulse"></span>
    <span id="gizmo-label" class="font-bold">Image 1</span>
    <span class="text-zinc-600">|</span>
    <span id="gizmo-coords" class="text-zinc-300">X: 76% Y: 49% S: 1.09x</span>
  </div>

  <!-- Center Crosshair & Guideline Indicator -->
  <div
    class="absolute inset-0 flex items-center justify-center pointer-events-none opacity-40"
  >
    <div class="w-6 h-[1px] bg-[#d4af37]"></div>
    <div class="h-6 w-[1px] bg-[#d4af37] absolute"></div>
  </div>

  <!-- Drag Center Helper Instruction -->
  <div
    class="absolute inset-0 flex items-center justify-center pointer-events-none"
  >
    <span
      class="text-[10px] font-mono text-[#d4af37]/40 uppercase tracking-widest bg-zinc-950/40 px-2 py-0.5 rounded"
    >
      Drag to Move · Handles to Scale
    </span>
  </div>

  <!-- 4 Corner Handles for Scaling -->
  <div
    class="gizmo-handle nw absolute -top-2.5 -left-2.5 w-5 h-5 bg-[#d4af37] border-2 border-zinc-950 rounded-md cursor-nwse-resize shadow-lg hover:scale-125 transition-transform"
  >
  </div>
  <div
    class="gizmo-handle ne absolute -top-2.5 -right-2.5 w-5 h-5 bg-[#d4af37] border-2 border-zinc-950 rounded-md cursor-nesw-resize shadow-lg hover:scale-125 transition-transform"
  >
  </div>
  <div
    class="gizmo-handle se absolute -bottom-2.5 -right-2.5 w-5 h-5 bg-[#d4af37] border-2 border-zinc-950 rounded-md cursor-nwse-resize shadow-lg hover:scale-125 transition-transform"
  >
  </div>
  <div
    class="gizmo-handle sw absolute -bottom-2.5 -left-2.5 w-5 h-5 bg-[#d4af37] border-2 border-zinc-950 rounded-md cursor-nesw-resize shadow-lg hover:scale-125 transition-transform"
  >
  </div>

  <!-- 4 Edge Handles -->
  <div
    class="gizmo-handle n absolute -top-2 left-1/2 -translate-x-1/2 w-6 h-3 bg-[#d4af37] border border-zinc-950 rounded cursor-ns-resize shadow-lg hover:scale-110 transition-transform"
  >
  </div>
  <div
    class="gizmo-handle s absolute -bottom-2 left-1/2 -translate-x-1/2 w-6 h-3 bg-[#d4af37] border border-zinc-950 rounded cursor-ns-resize shadow-lg hover:scale-110 transition-transform"
  >
  </div>
  <div
    class="gizmo-handle w absolute top-1/2 -left-2 -translate-y-1/2 w-3 h-6 bg-[#d4af37] border border-zinc-950 rounded cursor-ew-resize shadow-lg hover:scale-110 transition-transform"
  >
  </div>
  <div
    class="gizmo-handle e absolute top-1/2 -right-2 -translate-y-1/2 w-3 h-6 bg-[#d4af37] border border-zinc-950 rounded cursor-ew-resize shadow-lg hover:scale-110 transition-transform"
  >
  </div>
</div>

<script>
  // =========================================================================
  // 🎛️ LUXURY PARTICLE SYSTEM CONFIGURATION - TWEAK ANY SETTING FREELY
  // =========================================================================
  const DEFAULT_IMAGE_LAYOUTS = [
    {
      scale: 1.0936430948476303,
      alignX: 0.7600426894343649,
      alignY: 0.48698481561822127,
    },
    {
      scale: 1.5,
      alignX: 0.7465314834578441,
      alignY: 0.48590021691973967,
    },
    {
      scale: 1.1170019439785475,
      alignX: 0.8046424759871932,
      alignY: 0.4436008676789588,
    },
  ];

  const PARTICLE_CONFIG = {
    // 1. POSITIONING & SIZING PER IMAGE
    imageLayouts: JSON.parse(JSON.stringify(DEFAULT_IMAGE_LAYOUTS)),

    // 2. 🔮 7 SWITCHABLE ORGANIC INTERACTIVE MODES
    // 1: 3D Holographic Parallax (Tilt & Depth Relief)
    // 2: Silk Surface Ripple (Liquid Gold Waves)
    // 3: Celestial Lantern (Bioluminescent Light)
    // 4: Gravitational Lens (Cosmic Curvature)
    // 5: Fluid Stardust Wake (Curl Turbulence)
    // 6: Soft Physics Displace (Elastic Damped Membrane)
    // 7: Neural Constellation (Synaptic Filaments)
    interactiveMode: 1,
    isRandomMode: true,
    effectIntensity: 1.0,
    effectSpeed: 1.0,
    cursorRadius: 140.0,
    repelStrength: 20.0,
    returnSpeed: 0.035,
    dragDamping: 0.9,

    // 3. OPACITY & TEXT CONTRAST (Steady 50% opacity from loading across entire life cycle)
    initialOpacity: 0.5,
    settledDimOpacity: 0.5,
    dimTransitionDuration: 1.0,

    // 4. TIMING & GRADUAL SEQUENTIAL REVEAL
    introGatherDuration: 2600,
    elementStaggerDelay: 320,

    // 5. SCROLL ARCHITECTURE & MULTI-PICTURE MORPHING
    fixedInViewport: true,
    morphPlateau: 0.28,
    morphStyle: 1, // 1:WaveWipe 2:GravityCollapse 3:LiquidFlow 4:Lightning 5:RadialIris
    images: [
      "/images/amir-portrait-luxury.jpg",
      // "/images/2.jpg",
      "/images/3.jpg",
      "/images/4.jpg",
    ],
  };

  // Restore saved layouts & mode from localStorage
  function restoreSavedSettings() {
    try {
      const lockedMode = localStorage.getItem("luxury_particle_locked_mode");
      if (lockedMode) {
        const modeNum = parseInt(lockedMode, 10);
        if (modeNum >= 1 && modeNum <= 7) {
          PARTICLE_CONFIG.interactiveMode = modeNum;
          PARTICLE_CONFIG.isRandomMode = false;
        }
      } else {
        // Random mode selected fresh on each page load!
        PARTICLE_CONFIG.interactiveMode = Math.floor(Math.random() * 7) + 1;
        PARTICLE_CONFIG.isRandomMode = true;
      }

      // Clear legacy single-mode storage so it doesn't freeze the random selection
      localStorage.removeItem("luxury_particle_mode");

      const raw = localStorage.getItem("luxury_particle_layouts");
      if (raw) {
        const parsed = JSON.parse(raw);
        if (Array.isArray(parsed)) {
          parsed.forEach((layout, i) => {
            if (layout && typeof layout.scale === "number") {
              PARTICLE_CONFIG.imageLayouts[i] = {
                scale: layout.scale,
                alignX: layout.alignX,
                alignY: layout.alignY,
              };
            }
          });
        }
      }
    } catch (e) {
      console.warn("Could not restore particle settings from localStorage", e);
    }
  }
  restoreSavedSettings();

  function saveSettingsToStorage() {
    try {
      localStorage.setItem(
        "luxury_particle_layouts",
        JSON.stringify(PARTICLE_CONFIG.imageLayouts),
      );
      if (!PARTICLE_CONFIG.isRandomMode) {
        localStorage.setItem(
          "luxury_particle_locked_mode",
          String(PARTICLE_CONFIG.interactiveMode),
        );
      } else {
        localStorage.removeItem("luxury_particle_locked_mode");
      }
    } catch (e) {
      console.warn("Could not save particle settings to localStorage", e);
    }
  }

  function getImageLayout(index: number) {
    if (PARTICLE_CONFIG.imageLayouts[index]) {
      return PARTICLE_CONFIG.imageLayouts[index];
    }
    const fallback = { scale: 1.0, alignX: 0.5, alignY: 0.5 };
    PARTICLE_CONFIG.imageLayouts[index] = fallback;
    return fallback;
  }

  // Expose configuration globally for testing & tweaking: window.PARTICLE_CONFIG
  (window as any).PARTICLE_CONFIG = PARTICLE_CONFIG;

  // WebGL Shaders with 5 Switchable Organic Interaction Modes
  const VS_SOURCE = `
    attribute vec2 a_targetA;
    attribute vec3 a_colorA;
    attribute vec2 a_targetB;
    attribute vec3 a_colorB;
    attribute vec2 a_origin;
    attribute vec4 a_params; // x: delay, y: duration, z: size, w: curl
    attribute float a_scatter; // 0.0: assembles into picture (99%), 1.0: permanent wanderer (1%)

    uniform float u_time;
    uniform vec2 u_resolution;
    uniform vec2 u_mouse;
    uniform vec2 u_mouse_vel;
    uniform float u_mouse_speed;
    uniform float u_mouse_active;
    uniform float u_cursor_radius;
    uniform float u_dim_factor;
    uniform float u_morph_t; // 0.0 to 1.0 morph between Image A and Image B
    uniform int u_morph_style; // 1:WaveWipe 2:GravityCollapse 3:LiquidFlow 4:Lightning 5:RadialIris

    // Interactive Mode & Parameters
    uniform int u_interactive_mode; // 1: Hologram, 2: Ripple, 3: Lantern, 4: Gravity, 5: Fluid
    uniform float u_param_intensity;
    uniform float u_param_speed;
    uniform float u_repel_strength;

    // Dynamic Live Transforms (Scale and Center per Image)
    uniform vec2 u_centerA;
    uniform float u_sizeA;
    uniform vec2 u_centerB;
    uniform float u_sizeB;

    varying vec3 v_color;
    varying float v_alpha;

    // Simplex Noise & Divergence-Free Curl Field
    vec3 mod289(vec3 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
    vec2 mod289(vec2 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
    vec3 permute(vec3 x) { return mod289(((x * 34.0) + 1.0) * x); }

    float snoise(vec2 v) {
      const vec4 C = vec4(0.211324865405187,
                          0.366025403784439,
                         -0.577350269189626,
                          0.024390243902439);
      vec2 i  = floor(v + dot(v, C.yy));
      vec2 x0 = v - i + dot(i, C.xx);
      vec2 i1 = (x0.x > x0.y) ? vec2(1.0, 0.0) : vec2(0.0, 1.0);
      vec4 x12 = x0.xyxy + C.xxzz;
      x12.xy -= i1;
      i = mod289(i);
      vec3 p = permute(permute(i.y + vec3(0.0, i1.y, 1.0))
            + i.x + vec3(0.0, i1.x, 1.0));
      vec3 m = max(0.5 - vec3(dot(x0, x0), dot(x12.xy, x12.xy), dot(x12.zw, x12.zw)), 0.0);
      m = m * m;
      m = m * m;
      vec3 x = 2.0 * fract(p * C.www) - 1.0;
      vec3 h = abs(x) - 0.5;
      vec3 ox = floor(x + 0.5);
      vec3 a0 = x - ox;
      m *= 1.79284291400159 - 0.85373472095314 * (a0 * a0 + h * h);
      vec3 g;
      g.x  = a0.x  * x0.x  + h.x  * x0.y;
      g.yz = a0.yz * x12.xz + h.yz * x12.yw;
      return 130.0 * dot(m, g);
    }

    vec2 curlNoise(vec2 p) {
      float eps = 0.5;
      float n1 = snoise(vec2(p.x, p.y + eps));
      float n2 = snoise(vec2(p.x, p.y - eps));
      float n3 = snoise(vec2(p.x + eps, p.y));
      float n4 = snoise(vec2(p.x - eps, p.y));
      float dx = (n1 - n2) / (2.0 * eps);
      float dy = (n3 - n4) / (2.0 * eps);
      return vec2(dx, -dy);
    }

    void main() {
      float delay = a_params.x;
      float duration = a_params.y;
      float size = a_params.z;
      float curl = a_params.w;

      float pElapsed = max(0.0, u_time - delay);
      float progress = clamp(pElapsed / duration, 0.0, 1.0);

      // Smooth quintic ease out for majestic cinematic gathering
      float t = 1.0 - progress;
      float ease = 1.0 - t * t * t * t;

      // Dynamically compute screen pixel target coordinates from normalized coordinates
      vec2 targetPosA = u_centerA + a_targetA * u_sizeA;
      vec2 targetPosB = u_centerB + a_targetB * u_sizeB;

      // High-entropy per-particle pseudo-random seeds: breaks any artificial banding
      float pRnd1 = fract(sin(dot(a_targetA.xy + vec2(curl, size), vec2(12.9898, 78.233))) * 43758.5453);
      float pRnd2 = fract(sin(dot(a_targetB.xy + vec2(size, -curl), vec2(39.346, 11.135))) * 28462.6315);
      float pRnd3 = fract(a_params.x * 0.0071 + curl * 13.37);

      // Screen origin in absolute pixels:
      vec2 screenOrigin = a_origin * u_resolution;

      // Ambient wandering flow across viewport:
      // When page loads, particles move randomly "here and there"
      vec2 driftCoord = screenOrigin * 0.0016 + vec2(u_time * 0.00015, -u_time * 0.00012);
      vec2 curlWander = curlNoise(driftCoord) * 36.0;
      vec2 harmonicWander = vec2(
        sin(u_time * 0.0013 * (0.7 + pRnd1 * 0.6) + pRnd2 * 6.283) * 26.0,
        cos(u_time * 0.0010 * (0.7 + pRnd2 * 0.6) + pRnd3 * 6.283) * 22.0
      );
      vec2 liveOrigin = screenOrigin + curlWander + harmonicWander;

      // =====================================================================
      // 5 SELECTABLE MORPH STYLES (u_morph_style 1–5)
      // =====================================================================
      vec2 screenCenter = u_resolution * 0.5;
      float mt = u_morph_t; // 0=Image A, 1=Image B
      vec2 morphedTarget;
      vec3 morphedColor;
      float morphHighlight = 0.0; // extra brightness at the wave/transition front
      // ---------------------------------------------------------------
      // STYLE 1: DIRECT SPATIAL FLOW
      // Particles flow directly from their A target to B target.
      // Individual stochastic dispersion: ZERO strips, ZERO bands.
      // Particles embark and arrive independently with organic micro-arcs.
      // ---------------------------------------------------------------
      if (u_morph_style == 1) {
        vec2 midPt = (targetPosA + targetPosB) * 0.5;
        float distFromCenter = length(midPt - screenCenter);
        float maxDist = max(1.0, length(u_resolution) * 0.52);
        float normDist = clamp(distFromCenter / maxDist, 0.0, 1.0);

        // Blending gentle spatial wave with heavy individual particle noise:
        // Ensures particles in the same region do NOT move in lockstep strips
        float particleJitter = (pRnd1 - 0.5) * 0.38 + (pRnd2 - 0.5) * 0.16;
        float particleOffset = normDist * 0.18 + particleJitter;
        float windowWidth = 0.52;
        float localT = clamp((mt * (1.0 + windowWidth) - particleOffset) / windowWidth, 0.0, 1.0);

        // Double-smooth for buttery ease in/out
        float smoothT = localT * localT * (3.0 - 2.0 * localT);
        smoothT = smoothT * smoothT * (3.0 - 2.0 * smoothT);

        // Individual organic micro-arc trajectory:
        // Each particle curves along its own random angle rather than a uniform direction
        float arcHeight = length(targetPosB - targetPosA) * 0.08 * (0.6 + pRnd3 * 0.8);
        vec2 randomArcDir = vec2(cos(pRnd1 * 6.28318), sin(pRnd1 * 6.28318));
        vec2 centerBias = normalize(screenCenter - midPt + vec2(0.001));
        vec2 arcDir = normalize(mix(randomArcDir, centerBias, 0.35));
        float arcAmt = 4.0 * smoothT * (1.0 - smoothT);
        vec2 arcOffset = arcDir * (arcHeight * arcAmt);

        morphedTarget = mix(targetPosA, targetPosB, smoothT) + arcOffset;
        morphedColor = mix(a_colorA, a_colorB, smoothT);
        morphHighlight = 3.0 * localT * (1.0 - localT) * 0.55;

      // ---------------------------------------------------------------
      // STYLE 2: WIND SWIRL & VORTEX
      // Phase 1 (0→0.50): Windstorm blows in; particles spin into a
      //   swirling vortex destroying Image A.
      // Phase 2 (0.50→1.0): Wind subsides; particles spiral inward
      //   to assemble Image B in its respective shape.
      // ---------------------------------------------------------------
      } else if (u_morph_style == 2) {
        float windSplit = 0.50;

        if (mt <= windSplit) {
          float p = mt / windSplit;
          // Left-to-right wind arrival front
          float windFront = clamp(p * 1.5 - (targetPosA.x / max(1.0, u_resolution.x)) * 0.5, 0.0, 1.0);
          float pe = windFront * windFront * (3.0 - 2.0 * windFront);

          // Whirlwind vortex around local image center
          vec2 rel = targetPosA - u_centerA;
          float swirlAngle = pe * 3.6 * (0.8 + 0.4 * abs(curl));
          float cA = cos(swirlAngle); float sA = sin(swirlAngle);
          vec2 spun = vec2(rel.x * cA - rel.y * sA, rel.x * sA + rel.y * cA);

          // Linear wind drift: gusting diagonally right and up
          vec2 windDraft = vec2(300.0, -80.0) * (pe * pe);

          // Curl turbulence
          vec2 curlSample = targetPosA * 0.005 + vec2(u_time * 0.0004, pe * 0.5);
          vec2 curlField = curlNoise(curlSample) * (140.0 * pe);

          morphedTarget = u_centerA + mix(rel, spun, pe) + windDraft + curlField;
          morphedColor = mix(a_colorA, vec3(0.95, 0.88, 0.55), pe * 0.45);
          morphHighlight = pe * 0.45;

        } else {
          float p = (mt - windSplit) / (1.0 - windSplit);
          // Gathering front: particles settle into Image B
          float gatherFront = clamp(p * 1.5 - (1.0 - targetPosB.x / max(1.0, u_resolution.x)) * 0.5, 0.0, 1.0);
          float ge = gatherFront * gatherFront * (3.0 - 2.0 * gatherFront);

          // Spiral in towards Image B
          vec2 relB = targetPosB - u_centerB;
          float returnAngle = (1.0 - ge) * 3.6 * (0.8 + 0.4 * abs(curl));
          float cB = cos(returnAngle); float sB = sin(returnAngle);
          vec2 spunB = vec2(relB.x * cB - relB.y * sB, relB.x * sB + relB.y * cB);

          vec2 residualDraft = vec2(300.0, -80.0) * (1.0 - ge) * (1.0 - ge);
          vec2 residualCurl = curlNoise(targetPosB * 0.005 + vec2(p * 0.5)) * (140.0 * (1.0 - ge));

          vec2 vortexSource = u_centerB + spunB + residualDraft + residualCurl;

          morphedTarget = mix(vortexSource, targetPosB, ge);
          morphedColor = mix(vec3(0.95, 0.88, 0.55), a_colorB, ge);
          morphHighlight = (1.0 - ge) * 0.40;
        }

      // ---------------------------------------------------------------
      // STYLE 3: DIAGONAL WAVE WIPE (editorial page-turn)
      // A light-seam sweeps diagonally; particles transform on contact.
      // ---------------------------------------------------------------
      } else if (u_morph_style == 3) {
        vec2 sweepDir = normalize(vec2(0.65, 0.35));
        vec2 midPt = (targetPosA + targetPosB) * 0.5;
        float proj = dot(midPt / u_resolution, sweepDir);
        float wavePos = mt * 1.08 - 0.04;
        float waveBand = 0.10;
        float signedD = wavePos - proj;
        float localT = clamp(signedD / waveBand + 0.5, 0.0, 1.0);
        float smoothT = localT * localT * (3.0 - 2.0 * localT);
        smoothT = smoothT * smoothT * (3.0 - 2.0 * smoothT);
        morphedTarget = mix(targetPosA, targetPosB, smoothT);
        morphedColor = mix(a_colorA, a_colorB, smoothT);
        morphHighlight = 4.0 * localT * (1.0 - localT);

      // ---------------------------------------------------------------
      // STYLE 4: GRAVITY COLLAPSE (black hole singularity)
      // All particles implode to a bright point, then explode to Image B.
      // ---------------------------------------------------------------
      } else if (u_morph_style == 4) {
        float collapseEnd = 0.44;
        float expandStart = 0.56;
        if (mt <= collapseEnd) {
          float p = mt / collapseEnd;
          float pe = p * p * p;
          morphedTarget = mix(targetPosA, screenCenter, pe);
          morphedColor = mix(a_colorA, vec3(1.0, 0.9, 0.5), pe);
          morphHighlight = pe * 0.9;
        } else if (mt < expandStart) {
          morphedTarget = screenCenter;
          morphedColor = vec3(1.0, 0.95, 0.6);
          morphHighlight = 1.0;
        } else {
          float p = (mt - expandStart) / (1.0 - expandStart);
          float pe = 1.0 - (1.0 - p) * (1.0 - p) * (1.0 - p);
          morphedTarget = mix(screenCenter, targetPosB, pe);
          morphedColor = mix(vec3(1.0, 0.95, 0.6), a_colorB, pe);
          morphHighlight = (1.0 - p) * 0.5;
        }

      // ---------------------------------------------------------------
      // STYLE 5: RADIAL IRIS (camera aperture reveal)
      // Soft stochastic particle dispersion: NO hard concentric rings/bands.
      // ---------------------------------------------------------------
      } else {
        vec2 midPt2 = (targetPosA + targetPosB) * 0.5;
        float distFromCenter = length(midPt2 - screenCenter);
        float maxDist = max(1.0, length(u_resolution) * 0.5);
        float normDist = clamp(distFromCenter / maxDist, 0.0, 1.0);

        // Heavy per-particle dither breaks circular bands into dispersed stardust
        float noisyDist = normDist + (pRnd1 - 0.5) * 0.32 + (pRnd2 - 0.5) * 0.14;
        float irisWidth = 0.38;
        float irisPos = mt * (1.0 + irisWidth) - irisWidth * 0.5;
        float localT = clamp((irisPos - noisyDist) / irisWidth + 0.5, 0.0, 1.0);

        float smoothT = localT * localT * (3.0 - 2.0 * localT);
        smoothT = smoothT * smoothT * (3.0 - 2.0 * smoothT);

        // Individual organic micro-twist per particle
        float irisTwist = (1.0 - smoothT) * smoothT * curl * (0.3 + pRnd3 * 0.4);
        float cI = cos(irisTwist); float sI = sin(irisTwist);
        vec2 diffAB = targetPosB - targetPosA;
        vec2 twistedB = targetPosA + vec2(diffAB.x * cI - diffAB.y * sI, diffAB.x * sI + diffAB.y * cI);

        morphedTarget = mix(targetPosA, twistedB, smoothT);
        morphedColor = mix(a_colorA, a_colorB, smoothT);
        morphHighlight = 3.5 * localT * (1.0 - localT) * 0.65;
      }

      vec3 goldHighlight = vec3(1.0, 0.87, 0.38);
      vec3 finalColor = mix(morphedColor, goldHighlight, clamp(morphHighlight, 0.0, 1.0) * 0.65);
      float pointSize = size * (1.0 + morphHighlight * 0.6 + (1.0 - progress) * 0.6);

      // Gathering flight with dynamic swirl:
      // When progress == 0.0, gatherSwirl is 0 so particle is at liveOrigin drifting freely.
      // As progress goes from 0.0 to 1.0, gatherSwirl gracefully spirals into morphedTarget.
      float gatherSwirl = sin(progress * 3.14159) * curl * 0.85;
      vec2 diff = liveOrigin - morphedTarget;
      float cosA = cos(gatherSwirl);
      float sinA = sin(gatherSwirl);
      vec2 rotatedDiff = vec2(
        diff.x * cosA - diff.y * sinA,
        diff.x * sinA + diff.y * cosA
      );
      vec2 currentOrigin = morphedTarget + rotatedDiff;
      vec2 pos = mix(currentOrigin, morphedTarget, ease);

      // Subtle breathing ambient shimmer when settled
      if (progress >= 1.0) {
        float shimmer = sin(u_time * 0.002 + morphedTarget.x * 0.01 + morphedTarget.y * 0.01) * 0.6;
        pos.y += shimmer;
      }

      // ---------------------------------------------------------------
      // 1% PERMANENT SCATTERED WANDERERS:
      // They NEVER assemble into the picture; they remain distributed
      // across the viewport, drifting continuously in cosmic currents.
      // ---------------------------------------------------------------
      if (a_scatter > 0.5) {
        // While particles are assembling (500ms to 2400ms), wanderers migrate toward assembly center
        // Once assembly completes, inward motion stops and they continue scattered in viewport
        float gatherProgress = clamp((u_time - 500.0) / 1900.0, 0.0, 1.0);
        float pullEase = gatherProgress * gatherProgress * (3.0 - 2.0 * gatherProgress);
        pullEase = pullEase * pullEase * (3.0 - 2.0 * pullEase);

        float pullFraction = 0.18 + 0.28 * pRnd2;
        vec2 assemblyCenter = u_centerA;
        vec2 toCenter = assemblyCenter - screenOrigin;
        vec2 inwardOffset = toCenter * (pullFraction * pullEase);

        vec2 cosmicNoise = curlNoise(screenOrigin * 0.0011 + vec2(u_time * 0.00010, -u_time * 0.00008)) * 65.0;
        vec2 cosmicSine = vec2(
          sin(u_time * 0.0009 * (0.6 + pRnd3 * 0.8) + pRnd1 * 6.283) * 45.0,
          cos(u_time * 0.0007 * (0.6 + pRnd2 * 0.8) + pRnd3 * 6.283) * 35.0
        );
        pos = screenOrigin + inwardOffset + cosmicNoise + cosmicSine;

        // Soft sparkling celestial gold dust
        finalColor = mix(vec3(0.96, 0.84, 0.43), vec3(1.0, 0.94, 0.72), pRnd1);
        pointSize = size * (1.15 + sin(u_time * 0.0028 + pRnd2 * 6.283) * 0.35);
      }

      // =====================================================================
      // 🔮 8 SWITCHABLE ORGANIC INTERACTIVE MODES
      // =====================================================================
      if (u_mouse_active > 0.01) {
        vec2 toMouse = pos - u_mouse;
        float d = length(toMouse);

        // -------------------------------------------------------------
        // MODE 1: Volumetric Quantum Aura (Pure Particle Movements Only)
        // -------------------------------------------------------------
        if (u_interactive_mode == 1) {
          vec2 center = mix(u_centerA, u_centerB, u_morph_t);
          float curSize = mix(u_sizeA, u_sizeB, u_morph_t);
          float distToCenter = length(pos - center);
          float normFaceDist = distToCenter / max(1.0, curSize * 0.45);

          // 1. Concentric Quantum Interference Wave
          float waveSpeed = u_time * 0.0055 * u_param_speed;
          float ringWave = sin(d * 0.048 - waveSpeed);
          float ringDecay = exp(-d * 0.0070);
          float ringIntensity = ringWave * ringDecay * u_param_intensity;

          // 2. Silhouette Aura Factor: Keeps facial core (eyes/nose/mouth) 100% solid & unwarped
          float outerFactor = smoothstep(0.18, 0.95, normFaceDist);
          vec2 tangent = vec2(-toMouse.y, toMouse.x);
          vec2 normTangent = length(tangent) > 0.001 ? normalize(tangent) : vec2(0.0, 1.0);
          vec2 normRadial = d > 0.001 ? (toMouse / d) : vec2(1.0, 0.0);
          
          // Pure particle movements: Orbital quantum harmonic drift + radial breathing wave
          vec2 orbitalPush = normTangent * (sin(d * 0.04 + waveSpeed * 1.5) * 7.5 * outerFactor * ringDecay * u_param_intensity);
          vec2 radialPulse = normRadial * (ringIntensity * 5.5 * outerFactor);
          pos += (orbitalPush + radialPulse) * u_mouse_active;
          // Note: Zero color bloom/glow and zero pointSize change. Pure particle displacement only.
        }

        // -------------------------------------------------------------
        // MODE 2: Silk Surface Ripple (Liquid Gold Waves)
        // -------------------------------------------------------------
        else if (u_interactive_mode == 2) {
          float maxRippleDist = u_cursor_radius * 2.2;
          if (d < maxRippleDist && d > 0.01) {
            float wavePhase = d * 0.075 - u_time * 0.007 * u_param_speed;
            float wave = sin(wavePhase);
            float decay = exp(-d * 0.011) * (1.0 - smoothstep(u_cursor_radius * 0.6, maxRippleDist, d));
            vec2 rippleDisplace = normalize(toMouse) * (wave * 20.0 * decay * u_param_intensity);
            pos += rippleDisplace * u_mouse_active;
          }
        }

        // -------------------------------------------------------------
        // MODE 3: Celestial Lantern (Physical Micro Attraction)
        // -------------------------------------------------------------
        else if (u_interactive_mode == 3) {
          float lanternRadius = u_cursor_radius * 1.6;
          if (d < lanternRadius && d > 0.01) {
            float lightFalloff = max(0.0, 1.0 - d / lanternRadius);
            lightFalloff = lightFalloff * lightFalloff * (3.0 - 2.0 * lightFalloff);
            // Subtle ambient physical attraction toward cursor
            pos += normalize(-toMouse) * (lightFalloff * 8.0 * u_param_intensity) * u_mouse_active;
          }
        }

        // -------------------------------------------------------------
        // MODE 4: Gravitational Lens (Cosmic Curvature)
        // -------------------------------------------------------------
        else if (u_interactive_mode == 4) {
          float maxGravDist = u_cursor_radius * 1.8;
          if (d < maxGravDist && d > 1.0) {
            float r0 = u_cursor_radius * 0.45;
            vec2 tangent = vec2(-toMouse.y, toMouse.x);
            float deflection = (r0 / (d + 25.0)) * (34.0 * u_param_intensity);
            float falloff = 1.0 - smoothstep(r0, maxGravDist, d);
            vec2 gravDisplace = (normalize(tangent) * deflection + normalize(-toMouse) * (deflection * 0.35)) * falloff;
            pos += gravDisplace * u_mouse_active;
          }
        }

        // -------------------------------------------------------------
        // MODE 5: Fluid Stardust Wake (Curl Turbulence)
        // -------------------------------------------------------------
        else if (u_interactive_mode == 5) {
          if (d < u_cursor_radius && d > 0.01) {
            float normD = d / u_cursor_radius;
            float falloff = 1.0 - normD;
            falloff = falloff * falloff * (3.0 - 2.0 * falloff);

            vec2 velocityWake = u_mouse_vel * (0.38 * u_param_intensity) * falloff;
            vec2 curlCoord = pos * 0.0065 + vec2(u_time * 0.0006, -u_time * 0.0005);
            vec2 fluidVortex = curlNoise(curlCoord) * (46.0 * u_param_intensity) * falloff;
            vec2 radialPush = normalize(toMouse) * (u_repel_strength * falloff * (1.0 - normD * 0.5));

            float particleInertia = 0.75 + 0.5 * abs(curl);
            vec2 totalDisplacement = (velocityWake + fluidVortex + radialPush) * particleInertia;
            pos += totalDisplacement * u_mouse_active;
          }
        }

        // -------------------------------------------------------------
        // MODE 6: Simple Soft Physics (Elastic Damped Membrane)
        // -------------------------------------------------------------
        else if (u_interactive_mode == 6) {
          float sigma = u_cursor_radius * 0.58;
          float gaussian = exp(- (d * d) / (2.0 * sigma * sigma));
          
          if (gaussian > 0.0008) {
            vec2 pushDir = (d > 0.01) ? (toMouse / d) : vec2(0.0, 1.0);
            float softPush = gaussian * (22.0 * u_param_intensity);
            vec2 viscousDrag = u_mouse_vel * (0.16 * u_param_intensity) * gaussian;
            float springPhase = u_time * 0.005 * u_param_speed - d * 0.025;
            float springWave = sin(springPhase) * gaussian * (3.0 * u_param_intensity);
            
            vec2 displacement = pushDir * softPush + viscousDrag + pushDir * springWave;
            pos += displacement * u_mouse_active;
          }
        }

        // -------------------------------------------------------------
        // MODE 7: Neural Constellation (Synaptic Web & Nodal Beacons)
        // -------------------------------------------------------------
        else if (u_interactive_mode == 7) {
          float constellRadius = u_cursor_radius * 1.5;
          if (d < constellRadius && d > 0.01) {
            float normD = d / constellRadius;
            float falloff = 1.0 - normD;
            falloff = falloff * falloff * (3.0 - 2.0 * falloff);

            // Subtle magnetic synaptic tension toward cursor
            pos += normalize(-toMouse) * (falloff * 7.0 * u_param_intensity) * u_mouse_active;

            // Micro electrical twitch / synaptic shimmer
            float twitch = sin(u_time * 0.02 + pos.x * 0.15 + pos.y * 0.15) * (falloff * 2.0 * u_param_intensity);
            pos.y += twitch * u_mouse_active;
          }
        }

        // -------------------------------------------------------------
        // MODE 8: Holographic Cyber Scanlines (Laser Sweep & Prismatic Slices)
        // -------------------------------------------------------------
        else if (u_interactive_mode == 8) {
          // 1. Continuous Vertical Holographic Laser Sweep
          float sweepProgress = fract(u_time * 0.00035 * u_param_speed);
          float laserY = sweepProgress * u_resolution.y;
          float beamDist = abs(pos.y - laserY);
          float laserBeam = smoothstep(55.0, 0.0, beamDist) * u_param_intensity;

          // 2. High-Tech Horizontal Micro-Scanline Frequency (Quantum comb)
          float scanFreq = sin(pos.y * 0.75 + u_time * 0.015);
          float glitchJitter = step(0.94, sin(pos.y * 0.25 + u_time * 0.04)) * 3.5;
          
          // Subtle horizontal slice shimmer only when beam passes or cursor is near
          float cursorProximity = max(0.0, 1.0 - d / (u_cursor_radius * 1.3));
          float activeSlice = max(laserBeam, cursorProximity * 0.75);
          pos.x += (scanFreq * 2.2 + glitchJitter) * activeSlice * u_param_intensity * u_mouse_active;

          // 3. Interactive Cursor Interference Beam (Cross-field laser)
          if (abs(pos.x - u_mouse.x) < 2.5 && d < u_cursor_radius * 1.2) {
            pointSize += 1.5 * u_mouse_active;
          }

          // 4. Prismatic Cyan-Gold Chromatic Holographic Shimmer
          if (activeSlice > 0.05) {
            vec3 cyberHolo = vec3(0.55, 0.92, 1.0); // Cyan laser
            vec3 goldHolo = vec3(1.0, 0.88, 0.52);  // Champagne gold
            vec3 holoGlint = mix(goldHolo, cyberHolo, sin(pos.y * 0.1 + u_time * 0.008) * 0.5 + 0.5);
            finalColor = mix(finalColor, holoGlint, activeSlice * 0.65 * u_mouse_active);
            pointSize += activeSlice * 1.4 * u_mouse_active;
          }
        }
      }

      // Map to clip space (-1 to 1)
      vec2 zeroToOne = pos / u_resolution;
      vec2 zeroToTwo = zeroToOne * 2.0;
      vec2 clipSpace = zeroToTwo - 1.0;
      clipSpace.y = -clipSpace.y; // Invert Y for screen

      gl_Position = vec4(clipSpace, 0.0, 1.0);
      gl_PointSize = pointSize;

      v_color = finalColor;

      // Fixed 50% opacity from loading across entire life cycle:
      float initialFade = min(1.0, u_time / 80.0);
      float baseOpacity = 0.50;

      if (a_scatter > 0.5) {
        // 1% ambient wanderers: 50% opacity with subtle starry twinkle
        float twinkle = 0.88 + 0.12 * sin(u_time * 0.003 + pRnd1 * 6.283);
        v_alpha = initialFade * baseOpacity * twinkle;
      } else {
        // 99% assembling image particles: steady 50% opacity throughout
        v_alpha = initialFade * baseOpacity;
      }
    }
  `;

  const FS_SOURCE = `
    precision mediump float;
    varying vec3 v_color;
    varying float v_alpha;

    void main() {
      // Circular nano particle with soft celestial stardust core and ethereal halo
      vec2 coord = gl_PointCoord - vec2(0.5);
      float dist = length(coord);
      if (dist > 0.5) discard;
      float core = smoothstep(0.22, 0.0, dist);
      float halo = smoothstep(0.5, 0.08, dist);
      float intensity = halo * 0.75 + core * 0.55;
      gl_FragColor = vec4(v_color, v_alpha * intensity);
    }
  `;

  let currentAnimId: number | null = null;
  let constellCanvas: HTMLCanvasElement | null = null;
  let constellCtx: CanvasRenderingContext2D | null = null;
  let targetMouseX = -9999;
  let targetMouseY = -9999;
  let mouseX = -9999;
  let mouseY = -9999;
  let interpVelX = 0;
  let interpVelY = 0;
  let mouseVelX = 0;
  let mouseVelY = 0;
  let smoothVelX = 0;
  let smoothVelY = 0;
  let rawMouseActive = 0.0;
  let modeTransitionProgress = 1.0;
  let pendingMode: number | null = null;
  let lastMoveTime = performance.now();

  // Window-level mouse tracking for kinetic velocity & parallax interaction
  window.addEventListener(
    "pointermove",
    (e: MouseEvent | PointerEvent) => {
      const now = performance.now();
      const dt = Math.max(1, now - lastMoveTime);
      lastMoveTime = now;

      if (targetMouseX > -5000) {
        const vx = (e.clientX - targetMouseX) / (dt / 16.6);
        const vy = (e.clientY - targetMouseY) / (dt / 16.6);
        const maxV = 80;
        mouseVelX = Math.max(-maxV, Math.min(maxV, vx));
        mouseVelY = Math.max(-maxV, Math.min(maxV, vy));
      }

      targetMouseX = e.clientX;
      targetMouseY = e.clientY;
    },
    { passive: true },
  );

  window.addEventListener("pointerleave", () => {
    targetMouseX = -9999;
    targetMouseY = -9999;
    mouseVelX = 0;
    mouseVelY = 0;
  });

  // Pre-load all images configured in PARTICLE_CONFIG.images
  async function loadAllConfigImages(
    srcList: string[],
  ): Promise<HTMLImageElement[]> {
    const list =
      srcList && srcList.length > 0
        ? srcList
        : ["/images/amir-portrait-luxury.jpg"];
    const promises = list.map((src) => {
      return new Promise<HTMLImageElement>((resolve) => {
        const img = new Image();
        img.crossOrigin = "anonymous";
        img.onload = () => resolve(img);
        img.onerror = () => {
          console.warn(`[LuxuryParticles] Could not load image: ${src}`);
          resolve(img);
        };
        img.src = src;
      });
    });
    return Promise.all(promises);
  }

  // Sample target positions and colors for any image in NORMALIZED image coordinates (nx, ny)
  function sampleImageTargets(
    img: HTMLImageElement,
    particleCount: number,
  ): Float32Array {
    const imgW = img.naturalWidth || 1800;
    const imgH = img.naturalHeight || 1800;
    const imgAspect = imgW / imgH;

    const sampleW = 400;
    const sampleH = Math.max(250, Math.round(400 / imgAspect));
    const offscreen = document.createElement("canvas");
    offscreen.width = sampleW;
    offscreen.height = sampleH;
    const offCtx = offscreen.getContext("2d");

    const buffer = new Float32Array(particleCount * 5); // 5 floats: nx, ny, r, g, b

    if (!offCtx || imgW === 0 || imgH === 0) {
      for (let i = 0; i < particleCount; i++) {
        buffer[i * 5] = (Math.random() - 0.5) * imgAspect;
        buffer[i * 5 + 1] = Math.random() - 0.5;
        buffer[i * 5 + 2] = 0.96;
        buffer[i * 5 + 3] = 0.84;
        buffer[i * 5 + 4] = 0.43;
      }
      return buffer;
    }

    offCtx.drawImage(img, 0, 0, sampleW, sampleH);
    const imgData = offCtx.getImageData(0, 0, sampleW, sampleH).data;
    const totalPixels = sampleW * sampleH;

    const cdf = new Float64Array(totalPixels);
    let runningSum = 0;

    for (let i = 0; i < totalPixels; i++) {
      const idx = i * 4;
      const r = imgData[idx] / 255;
      const g = imgData[idx + 1] / 255;
      const b = imgData[idx + 2] / 255;
      const a = imgData[idx + 3] / 255;

      const lum = 0.299 * r + 0.587 * g + 0.114 * b;
      let weight = 0;

      if (a > 0.08) {
        if (lum > 0.04) {
          weight = (Math.pow(lum, 0.82) * 1.2 + 0.12) * a;
        } else if (r > 0.02 || g > 0.02 || b > 0.02) {
          weight = 0.05 * a;
        }
      }

      runningSum += weight;
      cdf[i] = runningSum;
    }

    const totalWeight = runningSum > 0 ? runningSum : 1;

    for (let p = 0; p < particleCount; p++) {
      const rnd = Math.random() * totalWeight;

      let low = 0;
      let high = totalPixels - 1;
      while (low < high) {
        const mid = (low + high) >> 1;
        if (cdf[mid] < rnd) {
          low = mid + 1;
        } else {
          high = mid;
        }
      }

      const pixelIndex = low;
      const py = Math.floor(pixelIndex / sampleW);
      const px = pixelIndex % sampleW;

      // Sub-pixel continuous random jitter: completely eliminates grid
      const subX = px + Math.random();
      const subY = py + Math.random();

      // Normalized coordinates centered at (0, 0):
      const nx = (subX / sampleW - 0.5) * imgAspect;
      const ny = subY / sampleH - 0.5;

      const samplePx = Math.min(sampleW - 1, Math.max(0, Math.floor(subX)));
      const samplePy = Math.min(sampleH - 1, Math.max(0, Math.floor(subY)));
      const byteIdx = (samplePy * sampleW + samplePx) * 4;
      const r = imgData[byteIdx] / 255;
      const g = imgData[byteIdx + 1] / 255;
      const b = imgData[byteIdx + 2] / 255;

      const isGold = Math.random() < 0.14;
      const finalR = isGold ? 0.96 : r;
      const finalG = isGold ? 0.84 : g;
      const finalB = isGold ? 0.43 : b;

      const base = p * 5;
      buffer[base] = nx;
      buffer[base + 1] = ny;
      buffer[base + 2] = finalR;
      buffer[base + 3] = finalG;
      buffer[base + 4] = finalB;

      if (p % 110 === 0 && constellationNodes.length < 500) {
        constellationNodes.push({ nx, ny });
      }
    }

    // -------------------------------------------------------------------------
    // Isotropic 2D Space-Filling Curve (Morton Z-Order) + Continuous Random Jitter
    // Eliminates all horizontal/vertical strips, bands, and scanlines.
    // Preserves 2D spatial locality in all directions equally without raster lines.
    // -------------------------------------------------------------------------
    function computeSpatialKey(nx: number, ny: number): number {
      const u = Math.max(
        0,
        Math.min(1023, Math.floor((nx / imgAspect + 0.5) * 1023)),
      );
      const v = Math.max(0, Math.min(1023, Math.floor((ny + 0.5) * 1023)));

      let x = u;
      let y = v;
      x = (x | (x << 8)) & 0x00ff00ff;
      x = (x | (x << 4)) & 0x0f0f0f0f;
      x = (x | (x << 2)) & 0x33333333;
      x = (x | (x << 1)) & 0x55555555;

      y = (y | (y << 8)) & 0x00ff00ff;
      y = (y | (y << 4)) & 0x0f0f0f0f;
      y = (y | (y << 2)) & 0x33333333;
      y = (y | (y << 1)) & 0x55555555;

      // Random continuous sub-cell dither: breaks any artificial banding
      return (x | (y << 1)) + (Math.random() - 0.5) * 32.0;
    }

    const indices = new Int32Array(particleCount);
    const keys = new Float64Array(particleCount);
    for (let i = 0; i < particleCount; i++) {
      indices[i] = i;
      const base = i * 5;
      keys[i] = computeSpatialKey(buffer[base], buffer[base + 1]);
    }

    indices.sort((a, b) => keys[a] - keys[b]);

    const sortedBuffer = new Float32Array(particleCount * 5);
    for (let i = 0; i < particleCount; i++) {
      const src = indices[i] * 5;
      const dst = i * 5;
      sortedBuffer[dst] = buffer[src];
      sortedBuffer[dst + 1] = buffer[src + 1];
      sortedBuffer[dst + 2] = buffer[src + 2];
      sortedBuffer[dst + 3] = buffer[src + 3];
      sortedBuffer[dst + 4] = buffer[src + 4];
    }

    return sortedBuffer;
  }

  // State for Interactive Particle Placement Studio
  let studioActive = false;
  let studioGizmoVisible = true;
  let studioManualMorph: number | null = null;
  let selectedImageIdx = 0;
