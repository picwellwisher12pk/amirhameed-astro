---
// Luxury Classical Cinematic Fullscreen High-Density Nano-Particle Cloud Intro (WebGL GPU-Accelerated)
// 5 Switchable Organic Interaction Modes: 3D Hologram, Silk Ripple, Celestial Lantern, Gravity Lens, Fluid Wake
---

<!-- Pitch-black cinematic veil (active during luxury theme entrance) -->
<div 
  id="luxury-veil" 
  class="fixed inset-0 z-[2] bg-black pointer-events-none transition-opacity duration-1000 opacity-0 hidden"
  aria-hidden="true"
></div>

<!-- Massive high-density nano-particle gathering canvas (Fullscreen WebGL) -->
<canvas 
  id="luxury-particle-canvas" 
  class="fixed inset-0 z-[5] pointer-events-none hidden"
  aria-hidden="true"
></canvas>

<!-- Neural Constellation synaptic filaments canvas (Overlay 2D) -->
<canvas 
  id="luxury-constellation-canvas" 
  class="fixed inset-0 z-[6] pointer-events-none hidden"
  aria-hidden="true"
></canvas>

<!-- Interactive On-Screen Transform Gizmo (Visible when Particle Studio is open) -->
<div
  id="particle-placement-gizmo"
  class="fixed z-40 hidden pointer-events-auto border-2 border-dashed border-[#d4af37]/80 rounded-xl select-none cursor-move transition-[box-shadow] duration-200"
  style="box-shadow: 0 0 35px rgba(212, 175, 55, 0.22), inset 0 0 25px rgba(212, 175, 55, 0.08);"
  aria-label="Particle Image Placement Gizmo"
>
  <!-- Image Info & Coordinate Badge at Top Left -->
  <div class="absolute -top-8 left-0 px-2.5 py-1 rounded-md bg-zinc-950/95 border border-[#d4af37]/50 text-[11px] font-mono text-[#d4af37] whitespace-nowrap pointer-events-none flex items-center gap-2 shadow-2xl backdrop-blur-md">
    <span class="w-2 h-2 rounded-full bg-[#d4af37] animate-pulse"></span>
    <span id="gizmo-label" class="font-bold">Image 1</span>
    <span class="text-zinc-600">|</span>
    <span id="gizmo-coords" class="text-zinc-300">X: 76% Y: 49% S: 1.09x</span>
  </div>

  <!-- Center Crosshair & Guideline Indicator -->
  <div class="absolute inset-0 flex items-center justify-center pointer-events-none opacity-40">
    <div class="w-6 h-[1px] bg-[#d4af37]"></div>
    <div class="h-6 w-[1px] bg-[#d4af37] absolute"></div>
  </div>

  <!-- Drag Center Helper Instruction -->
  <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
    <span class="text-[10px] font-mono text-[#d4af37]/40 uppercase tracking-widest bg-zinc-950/40 px-2 py-0.5 rounded">
      Drag to Move · Handles to Scale
    </span>
  </div>

  <!-- 4 Corner Handles for Scaling -->
  <div class="gizmo-handle nw absolute -top-2.5 -left-2.5 w-5 h-5 bg-[#d4af37] border-2 border-zinc-950 rounded-md cursor-nwse-resize shadow-lg hover:scale-125 transition-transform"></div>
  <div class="gizmo-handle ne absolute -top-2.5 -right-2.5 w-5 h-5 bg-[#d4af37] border-2 border-zinc-950 rounded-md cursor-nesw-resize shadow-lg hover:scale-125 transition-transform"></div>
  <div class="gizmo-handle se absolute -bottom-2.5 -right-2.5 w-5 h-5 bg-[#d4af37] border-2 border-zinc-950 rounded-md cursor-nwse-resize shadow-lg hover:scale-125 transition-transform"></div>
  <div class="gizmo-handle sw absolute -bottom-2.5 -left-2.5 w-5 h-5 bg-[#d4af37] border-2 border-zinc-950 rounded-md cursor-nesw-resize shadow-lg hover:scale-125 transition-transform"></div>

  <!-- 4 Edge Handles -->
  <div class="gizmo-handle n absolute -top-2 left-1/2 -translate-x-1/2 w-6 h-3 bg-[#d4af37] border border-zinc-950 rounded cursor-ns-resize shadow-lg hover:scale-110 transition-transform"></div>
  <div class="gizmo-handle s absolute -bottom-2 left-1/2 -translate-x-1/2 w-6 h-3 bg-[#d4af37] border border-zinc-950 rounded cursor-ns-resize shadow-lg hover:scale-110 transition-transform"></div>
  <div class="gizmo-handle w absolute top-1/2 -left-2 -translate-y-1/2 w-3 h-6 bg-[#d4af37] border border-zinc-950 rounded cursor-ew-resize shadow-lg hover:scale-110 transition-transform"></div>
  <div class="gizmo-handle e absolute top-1/2 -right-2 -translate-y-1/2 w-3 h-6 bg-[#d4af37] border border-zinc-950 rounded cursor-ew-resize shadow-lg hover:scale-110 transition-transform"></div>
</div>

<!-- Floating Luxury Effect Showcase Dock (Bottom Center) -->
<div 
  id="luxury-mode-dock" 
  class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 flex items-center gap-1.5 p-1.5 rounded-full bg-zinc-950/90 border border-[#d4af37]/40 shadow-[0_12px_45px_rgba(0,0,0,0.85)] backdrop-blur-xl text-xs font-mono select-none transition-all duration-300 ease-in-out pointer-events-auto opacity-0 translate-y-4"
  style="box-shadow: 0 10px 35px -5px rgba(0,0,0,0.7), 0 0 20px rgba(212,175,55,0.18);"
>
  <!-- Badge Label -->
  <div class="hidden md:flex items-center gap-2 pl-3 pr-2 py-1 text-[#d4af37]">
    <span class="w-2 h-2 rounded-full bg-[#d4af37] animate-pulse"></span>
    <span class="text-[11px] font-serif font-bold uppercase tracking-wider">Effect Showcase</span>
  </div>

  <!-- 8 Mode Switch Buttons -->
  <div class="flex items-center gap-1">
    <button type="button" data-dock-mode="1" class="dock-mode-btn px-2.5 py-1.5 rounded-full transition-all duration-300 ease-in-out cursor-pointer text-[11px] flex items-center gap-1.5 text-zinc-300 hover:text-white hover:bg-zinc-800" title="1. Volumetric Quantum Aura (Press 1)">
      <span class="dock-badge w-4 h-4 rounded-full bg-zinc-800 flex items-center justify-center text-[10px] font-bold">1</span>
      <span>Quantum Aura</span>
    </button>
    <button type="button" data-dock-mode="2" class="dock-mode-btn px-2.5 py-1.5 rounded-full transition-all duration-300 ease-in-out cursor-pointer text-[11px] flex items-center gap-1.5 text-zinc-300 hover:text-white hover:bg-zinc-800" title="2. Silk Surface Ripple (Press 2)">
      <span class="dock-badge w-4 h-4 rounded-full bg-zinc-800 flex items-center justify-center text-[10px] font-bold">2</span>
      <span>Silk Ripple</span>
    </button>
    <button type="button" data-dock-mode="3" class="dock-mode-btn px-2.5 py-1.5 rounded-full transition-all duration-300 ease-in-out cursor-pointer text-[11px] flex items-center gap-1.5 text-zinc-300 hover:text-white hover:bg-zinc-800" title="3. Celestial Lantern (Press 3)">
      <span class="dock-badge w-4 h-4 rounded-full bg-zinc-800 flex items-center justify-center text-[10px] font-bold">3</span>
      <span>Celestial Lantern</span>
    </button>
    <button type="button" data-dock-mode="4" class="dock-mode-btn px-2.5 py-1.5 rounded-full transition-all duration-300 ease-in-out cursor-pointer text-[11px] flex items-center gap-1.5 text-zinc-300 hover:text-white hover:bg-zinc-800" title="4. Gravitational Lens (Press 4)">
      <span class="dock-badge w-4 h-4 rounded-full bg-zinc-800 flex items-center justify-center text-[10px] font-bold">4</span>
      <span>Gravity Lens</span>
    </button>
    <button type="button" data-dock-mode="5" class="dock-mode-btn px-2.5 py-1.5 rounded-full transition-all duration-300 ease-in-out cursor-pointer text-[11px] flex items-center gap-1.5 text-zinc-300 hover:text-white hover:bg-zinc-800" title="5. Fluid Stardust Wake (Press 5)">
      <span class="dock-badge w-4 h-4 rounded-full bg-zinc-800 flex items-center justify-center text-[10px] font-bold">5</span>
      <span>Fluid Wake</span>
    </button>
    <button type="button" data-dock-mode="6" class="dock-mode-btn px-2.5 py-1.5 rounded-full transition-all duration-300 ease-in-out cursor-pointer text-[11px] flex items-center gap-1.5 text-zinc-300 hover:text-white hover:bg-zinc-800" title="6. Simple Soft Physics Displace (Press 6)">
      <span class="dock-badge w-4 h-4 rounded-full bg-zinc-800 flex items-center justify-center text-[10px] font-bold">6</span>
      <span>Soft Physics</span>
    </button>
    <button type="button" data-dock-mode="7" class="dock-mode-btn px-2.5 py-1.5 rounded-full transition-all duration-300 ease-in-out cursor-pointer text-[11px] flex items-center gap-1.5 text-zinc-300 hover:text-white hover:bg-zinc-800" title="7. Neural Constellation (Press 7)">
      <span class="dock-badge w-4 h-4 rounded-full bg-zinc-800 flex items-center justify-center text-[10px] font-bold">7</span>
      <span>Neural Web</span>
    </button>
    <button type="button" data-dock-mode="8" class="dock-mode-btn px-2.5 py-1.5 rounded-full transition-all duration-300 ease-in-out cursor-pointer text-[11px] flex items-center gap-1.5 text-zinc-300 hover:text-white hover:bg-zinc-800" title="8. Holographic Cyber Scanlines (Press 8)">
      <span class="dock-badge w-4 h-4 rounded-full bg-zinc-800 flex items-center justify-center text-[10px] font-bold">8</span>
      <span>Cyber Scanlines</span>
    </button>
  </div>

  <!-- Divider -->
  <div class="h-4 w-[1px] bg-zinc-800 mx-1"></div>

  <!-- Randomize on Load Button -->
  <button
    id="dock-random-btn"
    type="button"
    class="px-2.5 py-1.5 rounded-full transition-all duration-300 ease-in-out cursor-pointer text-[11px] flex items-center gap-1.5 text-zinc-300 hover:text-white hover:bg-zinc-800/80 border border-transparent"
    title="Play random effect on each page load (Press R)"
  >
    <span class="text-xs">🎲</span>
    <span id="dock-random-text">Random Load</span>
  </button>

  <!-- Keep This One Button -->
  <button
    id="dock-lock-btn"
    type="button"
    class="px-3 py-1.5 rounded-full bg-[#d4af37]/20 hover:bg-[#d4af37] text-[#d4af37] hover:text-zinc-950 border border-[#d4af37]/60 font-semibold text-[11px] transition-all duration-300 ease-in-out cursor-pointer flex items-center gap-1.5 shadow-sm whitespace-nowrap"
    title="Keep this selected effect permanently on every load"
  >
    <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
    <span id="dock-lock-text">Keep This</span>
  </button>

  <!-- Minimize / Close Button -->
  <button
    id="dock-minimize-btn"
    type="button"
    class="w-6 h-6 rounded-full flex items-center justify-center text-zinc-500 hover:text-white hover:bg-zinc-800 transition-colors duration-200 ease-in-out ml-0.5"
    title="Minimize dock"
  >
    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
  </button>
</div>

<!-- Minimized Dock Pill (Appears when dock is minimized) -->
<button
  id="luxury-mode-dock-minimized"
  type="button"
  class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 hidden items-center gap-2 px-4 py-1.5 rounded-full bg-zinc-950/90 border border-[#d4af37]/40 shadow-xl backdrop-blur-xl text-xs font-mono text-[#d4af37] hover:border-[#d4af37] transition-all duration-300 ease-in-out cursor-pointer"
  title="Click to reopen Effect Showcase Dock"
>
  <span class="w-2 h-2 rounded-full bg-[#d4af37] animate-pulse"></span>
  <span class="font-semibold">🔮 Try Effects (Keys 1–8, R to Randomize)</span>
</button>

<!-- Floating Mode Guidance Toast -->
<div 
  id="luxury-mode-toast" 
  class="fixed top-20 left-1/2 -translate-x-1/2 z-50 pointer-events-none transition-all duration-300 ease-in-out opacity-0 -translate-y-2 flex flex-col items-center"
>
  <div class="px-4 py-2 rounded-2xl bg-zinc-950/95 border border-[#d4af37]/60 shadow-[0_10px_30px_rgba(0,0,0,0.85)] backdrop-blur-xl text-center max-w-lg">
    <div id="toast-title" class="text-xs font-serif font-bold text-[#d4af37] uppercase tracking-wider mb-0.5">Mode 1: 3D Holographic Parallax</div>
    <div id="toast-desc" class="text-[11px] text-zinc-300 font-sans">Move cursor across screen to see 3D head tilt and depth perspective relief.</div>
  </div>
</div>

<!-- Floating Particle Studio Trigger Button (Stacked at bottom-right above Replay button) -->
<button
  id="particle-studio-btn"
  type="button"
  class="fixed bottom-[122px] right-6 z-50 flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-zinc-200 dark:border-zinc-800 bg-white/95 dark:bg-zinc-900/95 text-zinc-800 dark:text-[#d4af37] shadow-xl backdrop-blur-md text-xs font-mono hover:border-[#d4af37] transition-all duration-300 ease-in-out hover:scale-105 cursor-pointer hidden"
  title="Open Particle Placement Studio (Alt+P)"
>
  <span class="w-2 h-2 rounded-full bg-[#d4af37] animate-pulse"></span>
  <span>✦ Particle Studio</span>
</button>

<!-- Interactive Floating Particle Placement Studio HUD Panel -->
<div
  id="particle-studio-panel"
  class="fixed bottom-24 right-6 z-50 hidden w-[390px] max-w-[calc(100vw-32px)] bg-zinc-950/95 border border-[#d4af37]/35 rounded-2xl shadow-2xl backdrop-blur-xl text-zinc-200 text-xs font-sans overflow-hidden select-none transition-all duration-300 ease-in-out"
>
  <!-- Studio Header with Drag Bar & Close Button -->
  <div class="flex items-center justify-between px-4 py-3 border-b border-zinc-800/80 bg-zinc-900/60 cursor-grab active:cursor-grabbing" id="studio-drag-header">
    <div class="flex items-center gap-2">
      <span class="w-2.5 h-2.5 rounded-full bg-[#d4af37] shadow-[0_0_8px_#d4af37]"></span>
      <span class="font-serif tracking-wider font-semibold text-[#d4af37] uppercase text-[11px]">Particle Physics &amp; Layout Studio</span>
    </div>
    <div class="flex items-center gap-1.5">
      <span class="text-[10px] font-mono text-zinc-500 hidden sm:inline">Alt+P</span>
      <button id="studio-close-btn" type="button" class="p-1 rounded-md text-zinc-400 hover:text-white hover:bg-zinc-800 transition-colors" title="Close Panel">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
  </div>

  <div class="p-4 space-y-4 max-h-[78vh] overflow-y-auto">
    <!-- 🔮 INTERACTIVE EFFECT MODE SWITCHER (Try All 5 One by One!) -->
    <div class="space-y-1.5">
      <div class="text-[10px] uppercase tracking-wider font-mono text-zinc-400 flex items-center justify-between">
        <span class="text-[#d4af37] font-semibold">🔮 Interactive Effect Mode</span>
        <span class="text-zinc-500 font-normal">Click to test live</span>
      </div>
      <div id="studio-mode-buttons" class="grid grid-cols-1 gap-1.5 p-1.5 bg-zinc-900/90 rounded-xl border border-zinc-800">
        <button type="button" class="mode-btn flex items-center justify-between px-3 py-2 rounded-lg font-mono text-[11px] text-left transition-all duration-300 ease-in-out cursor-pointer" data-mode="1">
          <div class="flex items-center gap-2">
            <span class="mode-dot w-2 h-2 rounded-full bg-zinc-600"></span>
            <span class="font-semibold">1. Volumetric Quantum Aura</span>
          </div>
          <span class="text-[10px] text-zinc-400">Pure Harmonic Drift &amp; Aura</span>
        </button>

        <button type="button" class="mode-btn flex items-center justify-between px-3 py-2 rounded-lg font-mono text-[11px] text-left transition-all duration-300 ease-in-out cursor-pointer" data-mode="2">
          <div class="flex items-center gap-2">
            <span class="mode-dot w-2 h-2 rounded-full bg-zinc-600"></span>
            <span class="font-semibold">2. Silk Surface Ripple</span>
          </div>
          <span class="text-[10px] text-zinc-400">Liquid Gold Waves</span>
        </button>

        <button type="button" class="mode-btn flex items-center justify-between px-3 py-2 rounded-lg font-mono text-[11px] text-left transition-all duration-300 ease-in-out cursor-pointer" data-mode="3">
          <div class="flex items-center gap-2">
            <span class="mode-dot w-2 h-2 rounded-full bg-zinc-600"></span>
            <span class="font-semibold">3. Celestial Lantern</span>
          </div>
          <span class="text-[10px] text-zinc-400">Bioluminescent Glow</span>
        </button>

        <button type="button" class="mode-btn flex items-center justify-between px-3 py-2 rounded-lg font-mono text-[11px] text-left transition-all duration-300 ease-in-out cursor-pointer" data-mode="4">
          <div class="flex items-center gap-2">
            <span class="mode-dot w-2 h-2 rounded-full bg-zinc-600"></span>
            <span class="font-semibold">4. Gravitational Lens</span>
          </div>
          <span class="text-[10px] text-zinc-400">Cosmic Curvature</span>
        </button>

        <button type="button" class="mode-btn flex items-center justify-between px-3 py-2 rounded-lg font-mono text-[11px] text-left transition-all duration-300 ease-in-out cursor-pointer" data-mode="5">
          <div class="flex items-center gap-2">
            <span class="mode-dot w-2 h-2 rounded-full bg-zinc-600"></span>
            <span class="font-semibold">5. Fluid Stardust Wake</span>
          </div>
          <span class="text-[10px] text-zinc-400">Curl Turbulence</span>
        </button>

        <button type="button" class="mode-btn flex items-center justify-between px-3 py-2 rounded-lg font-mono text-[11px] text-left transition-all duration-300 ease-in-out cursor-pointer" data-mode="6">
          <div class="flex items-center gap-2">
            <span class="mode-dot w-2 h-2 rounded-full bg-zinc-600"></span>
            <span class="font-semibold">6. Soft Physics Displace</span>
          </div>
          <span class="text-[10px] text-zinc-400">Elastic Damped Membrane</span>
        </button>

        <button type="button" class="mode-btn flex items-center justify-between px-3 py-2 rounded-lg font-mono text-[11px] text-left transition-all duration-300 ease-in-out cursor-pointer" data-mode="7">
          <div class="flex items-center gap-2">
            <span class="mode-dot w-2 h-2 rounded-full bg-zinc-600"></span>
            <span class="font-semibold">7. Neural Constellation</span>
          </div>
          <span class="text-[10px] text-zinc-400">Synaptic Filaments</span>
        </button>

        <button type="button" class="mode-btn flex items-center justify-between px-3 py-2 rounded-lg font-mono text-[11px] text-left transition-all duration-300 ease-in-out cursor-pointer" data-mode="8">
          <div class="flex items-center gap-2">
            <span class="mode-dot w-2 h-2 rounded-full bg-zinc-600"></span>
            <span class="font-semibold">8. Holographic Cyber Scanlines</span>
          </div>
          <span class="text-[10px] text-zinc-400">Laser Sweep &amp; Prismatic Slices</span>
        </button>
      </div>
    </div>

    <!-- Mode Tuning Sliders -->
    <div class="pt-2 border-t border-zinc-800/80 space-y-3">
      <!-- Intensity / Amplitude Slider -->
      <div>
        <div class="flex items-center justify-between text-xs mb-1">
          <span id="studio-intensity-label" class="text-zinc-300 font-medium">Effect Intensity</span>
          <span id="studio-intensity-val" class="font-mono text-[#d4af37] font-bold">1.00x</span>
        </div>
        <input id="studio-intensity-slider" type="range" min="0.2" max="2.5" step="0.05" value="1.0" class="w-full accent-[#d4af37] h-1.5 bg-zinc-800 rounded-lg appearance-none cursor-pointer" />
      </div>

      <!-- Frequency / Speed Slider -->
      <div>
        <div class="flex items-center justify-between text-xs mb-1">
          <span id="studio-speed-label" class="text-zinc-300 font-medium">Speed / Frequency</span>
          <span id="studio-speed-val" class="font-mono text-[#d4af37] font-bold">1.00x</span>
        </div>
        <input id="studio-speed-slider" type="range" min="0.2" max="2.5" step="0.05" value="1.0" class="w-full accent-[#d4af37] h-1.5 bg-zinc-800 rounded-lg appearance-none cursor-pointer" />
      </div>

      <!-- Wake / Radius Slider -->
      <div>
        <div class="flex items-center justify-between text-xs mb-1">
          <span class="text-zinc-300 font-medium">Influence Radius</span>
          <span id="studio-radius-val" class="font-mono text-[#d4af37] font-bold">140px</span>
        </div>
        <input id="studio-radius-slider" type="range" min="60" max="260" step="5" value="140" class="w-full accent-[#d4af37] h-1.5 bg-zinc-800 rounded-lg appearance-none cursor-pointer" />
      </div>
    </div>

    <!-- Image Selector Tabs -->
    <div class="pt-2 border-t border-zinc-800/80">
      <div class="text-[10px] uppercase tracking-wider font-mono text-zinc-400 mb-1.5 flex items-center justify-between">
        <span>Active Image Layout</span>
        <span class="text-[#d4af37]/80 font-normal">Select image to position</span>
      </div>
      <div id="studio-image-tabs" class="grid grid-cols-3 gap-1.5 p-1 bg-zinc-900/90 rounded-xl border border-zinc-800">
        <!-- Rendered dynamically for each image in PARTICLE_CONFIG.images -->
      </div>
    </div>

    <!-- Live Position & Scale Sliders for Active Image -->
    <div class="space-y-3 pt-1">
      <!-- Scale Slider -->
      <div>
        <div class="flex items-center justify-between text-xs mb-1">
          <span class="text-zinc-300 font-medium">Scale (Size)</span>
          <span id="studio-scale-val" class="font-mono text-[#d4af37] font-bold">1.09x</span>
        </div>
        <input id="studio-scale-slider" type="range" min="0.20" max="2.20" step="0.01" value="1.09" class="w-full accent-[#d4af37] h-1.5 bg-zinc-800 rounded-lg appearance-none cursor-pointer" />
      </div>

      <!-- Align X Slider -->
      <div>
        <div class="flex items-center justify-between text-xs mb-1">
          <span class="text-zinc-300 font-medium">Horizontal Position (Align X)</span>
          <span id="studio-alignx-val" class="font-mono text-[#d4af37] font-bold">76%</span>
        </div>
        <input id="studio-alignx-slider" type="range" min="0.05" max="0.95" step="0.005" value="0.76" class="w-full accent-[#d4af37] h-1.5 bg-zinc-800 rounded-lg appearance-none cursor-pointer" />
        <div class="flex gap-1.5 mt-1.5">
          <button type="button" class="preset-x-btn px-2 py-0.5 rounded bg-zinc-900 border border-zinc-800 hover:border-[#d4af37]/50 text-[10px] text-zinc-400 hover:text-[#d4af37] transition-colors" data-val="0.32">Left (32%)</button>
