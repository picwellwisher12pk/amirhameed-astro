        <button
          type="button"
          id="u-btn-reset-layout"
          class="py-2 px-3 rounded-xl text-slate-400 hover:text-rose-400 font-mono text-xs transition-colors cursor-pointer"
        >
          Reset Layout
        </button>
      </div>

    </div>

    <!-- ===================================================================== -->
    <!-- TAB 3: TYPOGRAPHY STUDIO                                             -->
    <!-- ===================================================================== -->
    <div id="tab-content-fonts" class="space-y-5 hidden">
      
      <!-- Scope Selector -->
      <div class="p-4 rounded-2xl bg-slate-800/60 border border-slate-700/60 space-y-3">
        <label class="text-xs font-bold text-white uppercase tracking-wider block">Target Scope</label>
        <div class="grid grid-cols-2 gap-2" id="u-font-scope-group">
          <button data-scope="everything" class="u-scope-btn px-3 py-2 rounded-xl border border-amber-400/50 bg-amber-400/15 text-white font-medium text-xs text-left cursor-pointer">
            Entire Site &amp; Header
          </button>
          <button data-scope="header-nav" class="u-scope-btn px-3 py-2 rounded-xl border border-slate-700/60 bg-slate-900/60 text-slate-400 hover:text-white text-xs text-left cursor-pointer">
            Header &amp; Nav Only
          </button>
          <button data-scope="headings" class="u-scope-btn px-3 py-2 rounded-xl border border-slate-700/60 bg-slate-900/60 text-slate-400 hover:text-white text-xs text-left cursor-pointer">
            Headings &amp; Logo
          </button>
          <button data-scope="hero-only" class="u-scope-btn px-3 py-2 rounded-xl border border-slate-700/60 bg-slate-900/60 text-slate-400 hover:text-white text-xs text-left cursor-pointer">
            Hero Name Only
          </button>
        </div>
      </div>

      <!-- Category Filter Pills -->
      <div class="p-4 rounded-2xl bg-slate-800/60 border border-slate-700/60 space-y-3">
        <div class="flex items-center justify-between">
          <label class="text-xs font-bold text-white uppercase tracking-wider">Font Family Browser</label>
          <span id="u-active-font-badge" class="text-[11px] font-mono text-amber-300 font-semibold">Cinzel</span>
        </div>

        <div class="flex flex-wrap gap-1.5" id="u-font-cat-pills">
          <button data-cat="all" class="u-cat-pill px-2.5 py-1 rounded-lg text-xs font-medium bg-amber-400 text-slate-950 font-bold cursor-pointer">All (19)</button>
          <button data-cat="classical" class="u-cat-pill px-2.5 py-1 rounded-lg text-xs font-medium bg-slate-900 text-slate-400 hover:text-white cursor-pointer">Classical Serif</button>
          <button data-cat="modern" class="u-cat-pill px-2.5 py-1 rounded-lg text-xs font-medium bg-slate-900 text-slate-400 hover:text-white cursor-pointer">Modern Sans</button>
          <button data-cat="display" class="u-cat-pill px-2.5 py-1 rounded-lg text-xs font-medium bg-slate-900 text-slate-400 hover:text-white cursor-pointer">Heavy / Slab</button>
        </div>

        <!-- Scrollable Font List -->
        <div class="space-y-1.5 max-h-56 overflow-y-auto pr-1" id="u-font-list-container">
          <!-- Rendered dynamically -->
        </div>
      </div>

      <!-- Typography Tuning Sliders -->
      <div class="p-4 rounded-2xl bg-slate-800/60 border border-slate-700/60 space-y-3.5 font-mono text-xs">
        <label class="text-xs font-bold text-white uppercase tracking-wider block font-sans">Metrics &amp; Case Tuning</label>

        <div>
          <div class="flex justify-between mb-1">
            <span class="text-slate-300">Letter Spacing:</span>
            <span id="u-font-val-spacing" class="text-amber-300 font-bold">0.03em</span>
          </div>
          <input type="range" id="u-font-slider-spacing" min="-0.05" max="0.30" step="0.01" value="0.03" class="w-full accent-amber-400 h-2 bg-slate-950 rounded-lg cursor-pointer" />
