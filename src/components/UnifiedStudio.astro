        <div>
          <div class="flex justify-between mb-1">
            <span class="text-slate-300">Font Weight:</span>
            <span id="u-font-val-weight" class="text-amber-300 font-bold">700</span>
          </div>
          <input type="range" id="u-font-slider-weight" min="300" max="900" step="100" value="700" class="w-full accent-amber-400 h-2 bg-slate-950 rounded-lg cursor-pointer" />
        </div>

        <div>
          <div class="flex justify-between mb-1">
            <span class="text-slate-300">Header Font Size:</span>
            <span id="u-font-val-size" class="text-amber-300 font-bold">0.875rem</span>
          </div>
          <input type="range" id="u-font-slider-size" min="0.65" max="2.00" step="0.025" value="0.875" class="w-full accent-amber-400 h-2 bg-slate-950 rounded-lg cursor-pointer" />
        </div>

        <div>
          <div class="flex items-center justify-between">
            <span class="text-slate-300">Text Transform:</span>
            <div class="flex gap-2">
              <button data-transform="none" class="u-font-transform-btn px-2 py-0.5 rounded bg-slate-900 text-slate-400 hover:text-white cursor-pointer">Normal</button>
              <button data-transform="uppercase" class="u-font-transform-btn px-2 py-0.5 rounded bg-amber-400/20 text-amber-300 border border-amber-400/40 font-bold cursor-pointer">UPPERCASE</button>
              <button data-transform="capitalize" class="u-font-transform-btn px-2 py-0.5 rounded bg-slate-900 text-slate-400 hover:text-white cursor-pointer">Title</button>
            </div>
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex items-center justify-between gap-2 pt-2">
        <button
          type="button"
          id="u-btn-copy-css"
          class="flex-1 py-2 px-3 rounded-xl bg-amber-400 hover:bg-amber-300 text-slate-950 font-bold text-xs font-mono transition-all cursor-pointer shadow-sm"
        >
          📋 Copy CSS
        </button>
        <a
          href="/font-tester"
          class="py-2 px-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-mono transition-colors"
        >
          Gallery ↗
        </a>
        <button
          type="button"
          id="u-btn-reset-fonts"
          class="py-2 px-3 rounded-xl text-slate-400 hover:text-rose-400 font-mono text-xs transition-colors cursor-pointer"
        >
          Reset
        </button>
      </div>

    </div>

  </div>
</div>

<script>
  // =========================================================================
  // UNIFIED CREATIVE STUDIO CONTROLLER
  // Combines Particle Physics & Typography into a friendly, breathable modal
  // =========================================================================

  interface FontItem {
    id: string;
    name: string;
    family: string;
    googleQuery: string;
    category: 'classical' | 'modern' | 'display';
    tagline: string;
    recommendedWeight: number;
    recommendedSpacing: string;
  }

  const FONTS_CATALOG: FontItem[] = [
    { id: 'cinzel', name: 'Cinzel', family: "'Cinzel', Georgia, serif", googleQuery: 'Cinzel:wght@400..900', category: 'classical', tagline: 'Imperial Classical Serif', recommendedWeight: 700, recommendedSpacing: '0.03em' },
    { id: 'bodoni-moda', name: 'Bodoni Moda', family: "'Bodoni Moda', Georgia, serif", googleQuery: 'Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900', category: 'classical', tagline: 'Vogue & Luxury Editorial', recommendedWeight: 700, recommendedSpacing: '0.05em' },
    { id: 'marcellus', name: 'Marcellus', family: "'Marcellus', Georgia, serif", googleQuery: 'Marcellus', category: 'classical', tagline: 'Roman Monumental Inscription', recommendedWeight: 400, recommendedSpacing: '0.06em' },
    { id: 'cormorant', name: 'Cormorant', family: "'Cormorant', 'Cormorant Garamond', Georgia, serif", googleQuery: 'Cormorant:ital,wght@0,300..700;1,300..700', category: 'classical', tagline: 'Aristocratic French Elegance', recommendedWeight: 600, recommendedSpacing: '0.04em' },
    { id: 'crimson-pro', name: 'Crimson Pro', family: "'Crimson Pro', Georgia, serif", googleQuery: 'Crimson+Pro:ital,wght@0,300..900;1,300..900', category: 'classical', tagline: 'Refined Bookish Academic', recommendedWeight: 600, recommendedSpacing: '0.02em' },
    { id: 'dm-serif-display', name: 'DM Serif Display', family: "'DM Serif Display', Georgia, serif", googleQuery: 'DM+Serif+Display:ital@0;1', category: 'classical', tagline: 'High-Contrast Drama', recommendedWeight: 400, recommendedSpacing: '-0.01em' },
    { id: 'playfair', name: 'Playfair Display', family: "'Playfair Display', Georgia, serif", googleQuery: 'Playfair+Display:ital,wght@0,400..900;1,400..900', category: 'classical', tagline: 'Transitional Literary Charm', recommendedWeight: 700, recommendedSpacing: '-0.01em' },
    { id: 'source-serif-4', name: 'Source Serif 4', family: "'Source Serif 4', Georgia, serif", googleQuery: 'Source+Serif+4:ital,opsz,wght@0,8..60,300..900;1,8..60,300..900', category: 'classical', tagline: 'Crisp Structural Craft', recommendedWeight: 600, recommendedSpacing: '0.01em' },
    { id: 'bitter', name: 'Bitter', family: "'Bitter', Georgia, serif", googleQuery: 'Bitter:ital,wght@0,300..900;1,300..900', category: 'classical', tagline: 'Comfortable Contemporary Serif', recommendedWeight: 600, recommendedSpacing: '0.01em' },
    { id: 'arvo', name: 'Arvo', family: "'Arvo', Georgia, serif", googleQuery: 'Arvo:ital,wght@0,400;0,700;1,400;1,700', category: 'display', tagline: 'Geometric Slab-Serif', recommendedWeight: 700, recommendedSpacing: '0.02em' },
    { id: 'alfa-slab-one', name: 'Alfa Slab One', family: "'Alfa Slab One', serif", googleQuery: 'Alfa+Slab+One', category: 'display', tagline: 'Ultra-Black Heavyweight Impact', recommendedWeight: 400, recommendedSpacing: '-0.02em' },
    { id: 'changa-one', name: 'Changa One', family: "'Changa One', cursive, sans-serif", googleQuery: 'Changa+One:ital@0;1', category: 'display', tagline: 'Punchy Chunky Poster', recommendedWeight: 400, recommendedSpacing: '0.01em' },
    { id: 'baloo-2', name: 'Baloo 2', family: "'Baloo 2', cursive, sans-serif", googleQuery: 'Baloo+2:wght@400..800', category: 'display', tagline: 'Friendly Affable Character', recommendedWeight: 700, recommendedSpacing: '0.00em' },
    { id: 'unbounded', name: 'Unbounded', family: "'Unbounded', sans-serif", googleQuery: 'Unbounded:wght@300..900', category: 'modern', tagline: 'Futuristic Ultra-Wide Tech', recommendedWeight: 700, recommendedSpacing: '-0.02em' },
    { id: 'geologica', name: 'Geologica', family: "'Geologica', sans-serif", googleQuery: 'Geologica:wght@300..900', category: 'modern', tagline: 'Precision Variable Geometric Sans', recommendedWeight: 600, recommendedSpacing: '0.02em' },
    { id: 'exo-2', name: 'Exo 2', family: "'Exo 2', sans-serif", googleQuery: 'Exo+2:ital,wght@0,300..900;1,300..900', category: 'modern', tagline: 'Cybernetic Tech Grotesque', recommendedWeight: 600, recommendedSpacing: '0.03em' },
    { id: 'oxygen', name: 'Oxygen', family: "'Oxygen', sans-serif", googleQuery: 'Oxygen:wght@300;400;700', category: 'modern', tagline: 'Clean Airy Linux Aesthetic', recommendedWeight: 700, recommendedSpacing: '0.01em' },
    { id: 'merriweather-sans', name: 'Merriweather Sans', family: "'Merriweather Sans', sans-serif", googleQuery: 'Merriweather+Sans:ital,wght@0,300..800;1,300..800', category: 'modern', tagline: 'Highly Readable Humanist', recommendedWeight: 700, recommendedSpacing: '0.02em' },
    { id: 'asap', name: 'Asap', family: "'Asap', sans-serif", googleQuery: 'Asap:ital,wght@0,300..900;1,300..900', category: 'modern', tagline: 'Contemporary Soft Sans', recommendedWeight: 600, recommendedSpacing: '0.01em' }
  ];

  // Font loader helper
  const loadedFonts = new Set<string>();
  function loadGoogleFont(query: string) {
    if (loadedFonts.has(query)) return;
    loadedFonts.add(query);
    const link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = `https://fonts.googleapis.com/css2?family=${query}&display=swap`;
    document.head.appendChild(link);
  }

  loadGoogleFont('Cinzel:wght@400..900');
  loadGoogleFont('Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900');

  // Font state
  let currentFontId = localStorage.getItem('tester-font-id') || 'cinzel';
  let currentScope = localStorage.getItem('tester-scope') || 'everything';
  let currentSpacing = localStorage.getItem('tester-spacing') || '0.03em';
  let currentWeight = localStorage.getItem('tester-weight') || '700';
  let currentSize = localStorage.getItem('tester-size') || '0.875rem';
  let currentTransform = localStorage.getItem('tester-transform') || 'none';
  let activeFontCategory = 'all';

  let styleTag = document.getElementById('dynamic-font-tester-style') as HTMLStyleElement | null;
  if (!styleTag) {
    styleTag = document.createElement('style');
    styleTag.id = 'dynamic-font-tester-style';
    document.head.appendChild(styleTag);
  }

  function applyTypography() {
    const font = FONTS_CATALOG.find(f => f.id === currentFontId) || FONTS_CATALOG[0];
    loadGoogleFont(font.googleQuery);

    const root = document.documentElement;
    root.style.setProperty('--luxury-nav-size', currentSize);

    if (currentScope === 'everything' || currentScope === 'header-nav') {
      root.style.setProperty('--luxury-nav-font', font.family);
      root.style.setProperty('--luxury-nav-spacing', currentSpacing);
      root.style.setProperty('--luxury-nav-weight', currentWeight);
      root.style.setProperty('--luxury-nav-transform', currentTransform);
    }
    if (currentScope === 'everything' || currentScope === 'headings') {
      root.style.setProperty('--luxury-heading-font', font.family);
      root.style.setProperty('--luxury-heading-spacing', currentSpacing);
      root.style.setProperty('--luxury-heading-weight', currentWeight);
      root.style.setProperty('--luxury-heading-transform', currentTransform);
    }
    if (currentScope === 'everything') {
      root.style.setProperty('--luxury-body-font', font.family);
    }

    let selectors: string[] = [];
    if (currentScope === 'everything') {
      selectors = [
        'html[data-theme="luxury"]',
        'html[data-theme="luxury"] body',
        'html[data-theme="luxury"] header',
        'html[data-theme="luxury"] header .header-logo-title',
        'html[data-theme="luxury"] header .header-menu-btn',
        'html[data-theme="luxury"] .viewport-nav-link',
        'html[data-theme="luxury"] h1',
        'html[data-theme="luxury"] h2',
        'html[data-theme="luxury"] h3',
        'html[data-theme="luxury"] h4',
        'html[data-theme="luxury"] p',
        'html[data-theme="luxury"] a',
        'html[data-theme="luxury"] button',
        'html[data-theme="luxury"] .font-display',
        'html[data-theme="luxury"] .font-heading',
        'html[data-theme="luxury"] .luxury-seq-2'
      ];
    } else if (currentScope === 'header-nav') {
      selectors = [
        'html[data-theme="luxury"] header',
        'html[data-theme="luxury"] header .header-logo-title',
        'html[data-theme="luxury"] header .header-menu-btn',
        'html[data-theme="luxury"] .viewport-nav-link'
      ];
    } else if (currentScope === 'headings') {
      selectors = [
        'html[data-theme="luxury"] h1',
        'html[data-theme="luxury"] h2',
        'html[data-theme="luxury"] h3',
        'html[data-theme="luxury"] h4',
        'html[data-theme="luxury"] .font-display',
        'html[data-theme="luxury"] .font-heading',
        'html[data-theme="luxury"] .luxury-seq-2'
      ];
    } else if (currentScope === 'hero-only') {
      selectors = [
        'html[data-theme="luxury"] .luxury-seq-2',
        'html[data-theme="luxury"] h1'
      ];
    }

    if (styleTag) {
      styleTag.textContent = `
        ${selectors.join(',\n')} {
          font-family: ${font.family} !important;
          letter-spacing: ${currentSpacing} !important;
          font-weight: ${currentWeight} !important;
          text-transform: ${currentTransform} !important;
        }
        html[data-theme="luxury"] header,
        html[data-theme="luxury"] header .header-logo-title,
        html[data-theme="luxury"] header .header-menu-btn {
          font-size: ${currentSize} !important;
        }
        html[data-theme="luxury"] .font-urdu,
        html[data-theme="luxury"] [dir="rtl"],
        html[data-theme="luxury"] [dir="rtl"] * {
          font-family: 'Vazirmatn', 'Noto Sans Arabic', serif !important;
          letter-spacing: normal !important;
          text-transform: none !important;
        }
      `;
    }

    const badge = document.getElementById('u-active-font-badge');
    if (badge) badge.textContent = font.name;

    localStorage.setItem('tester-font-id', currentFontId);
    localStorage.setItem('tester-scope', currentScope);
    localStorage.setItem('tester-spacing', currentSpacing);
    localStorage.setItem('tester-weight', currentWeight);
    localStorage.setItem('tester-size', currentSize);
    localStorage.setItem('tester-transform', currentTransform);
  }

  function renderFontList() {
    const container = document.getElementById('u-font-list-container');
    if (!container) return;

    const filtered = activeFontCategory === 'all'
      ? FONTS_CATALOG
      : FONTS_CATALOG.filter(f => f.category === activeFontCategory);

    container.innerHTML = filtered.map(f => {
      const isSelected = f.id === currentFontId;
      return `
        <button
          type="button"
          data-font-id="${f.id}"
          class="u-font-item-btn w-full p-2.5 rounded-xl flex items-center justify-between text-left transition-all cursor-pointer ${
            isSelected
              ? 'bg-amber-400/20 border border-amber-400/60 text-amber-300 font-semibold'
              : 'border border-slate-700/50 bg-slate-900/50 hover:bg-slate-800 text-slate-300'
          }"
        >
          <div>
            <div class="text-xs font-bold flex items-center gap-1.5">
              <span>${f.name}</span>
              ${isSelected ? '<span class="text-[10px] text-amber-400">✓</span>' : ''}
            </div>
            <div class="text-[10px] text-slate-400 font-mono">${f.tagline}</div>
          </div>
          <span class="text-sm font-semibold opacity-90" style="font-family: ${f.family}">Aa</span>
        </button>
      `;
    }).join('');

    container.querySelectorAll('.u-font-item-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-font-id');
        if (id) {
          currentFontId = id;
          const font = FONTS_CATALOG.find(f => f.id === id);
          if (font) {
            currentWeight = String(font.recommendedWeight);
            currentSpacing = font.recommendedSpacing;
            const sW = document.getElementById('u-font-slider-weight') as HTMLInputElement | null;
            const sS = document.getElementById('u-font-slider-spacing') as HTMLInputElement | null;
            const vW = document.getElementById('u-font-val-weight');
            const vS = document.getElementById('u-font-val-spacing');
            if (sW) sW.value = currentWeight;
            if (sS) sS.value = parseFloat(currentSpacing).toString();
            if (vW) vW.textContent = currentWeight;
            if (vS) vS.textContent = currentSpacing;
          }
          applyTypography();
          renderFontList();
        }
      });
    });
  }

  // =========================================================================
  // SETUP MODAL EVENTS, 3-TAB CONTROLLER & MODAL DRAGGING
  // =========================================================================
  function initUnifiedStudio() {
    const modal = document.getElementById('unified-studio-modal');
    const triggerBtn = document.getElementById('unified-studio-trigger');
    const closeBtn = document.getElementById('unified-studio-close');
    const header = document.getElementById('unified-studio-header');

    const tabBtnParticles = document.getElementById('tab-btn-particles');
    const tabBtnLayout = document.getElementById('tab-btn-layout');
    const tabBtnFonts = document.getElementById('tab-btn-fonts');
    const tabContentParticles = document.getElementById('tab-content-particles');
    const tabContentLayout = document.getElementById('tab-content-layout');
    const tabContentFonts = document.getElementById('tab-content-fonts');

    type StudioTab = 'particles' | 'layout' | 'fonts';
    let activeTab: StudioTab = 'particles';

    function switchTab(tab: StudioTab) {
      activeTab = tab;
      const tabs = [
        { id: 'particles', btn: tabBtnParticles, content: tabContentParticles },
        { id: 'layout', btn: tabBtnLayout, content: tabContentLayout },
        { id: 'fonts', btn: tabBtnFonts, content: tabContentFonts }
      ];

      tabs.forEach(t => {
        if (t.id === tab) {
          t.btn?.classList.add('bg-gradient-to-r', 'from-amber-500/20', 'to-amber-400/20', 'text-amber-300', 'border', 'border-amber-400/40', 'shadow-sm');
          t.btn?.classList.remove('text-slate-400');
          t.content?.classList.remove('hidden');
        } else {
          t.btn?.classList.remove('bg-gradient-to-r', 'from-amber-500/20', 'to-amber-400/20', 'text-amber-300', 'border', 'border-amber-400/40', 'shadow-sm');
          t.btn?.classList.add('text-slate-400');
          t.content?.classList.add('hidden');
        }
      });

      if (tab === 'fonts') {
        FONTS_CATALOG.forEach(f => loadGoogleFont(f.googleQuery));
      }
      if (tab === 'layout') {
        const api = (window as any).LuxuryParticleStudio;
        const gizmoCheckbox = document.getElementById('u-toggle-gizmo-box') as HTMLInputElement | null;
        if (api && gizmoCheckbox) {
          api.toggleGizmo(gizmoCheckbox.checked);
        }
      }
    }

    tabBtnParticles?.addEventListener('click', () => switchTab('particles'));
    tabBtnLayout?.addEventListener('click', () => switchTab('layout'));
    tabBtnFonts?.addEventListener('click', () => switchTab('fonts'));

    function openModal(defaultTab?: StudioTab) {
      if (defaultTab) switchTab(defaultTab);
      modal?.classList.remove('hidden');
      modal?.classList.add('flex');
    }

    function closeModal() {
      modal?.classList.add('hidden');
      modal?.classList.remove('flex');
      const api = (window as any).LuxuryParticleStudio;
      if (api) {
        api.setMorphProgress(null);
        api.toggleGizmo(false);
      }
    }

    function toggleModal() {
      if (modal?.classList.contains('hidden')) {
        openModal();
      } else {
        closeModal();
      }
    }

    triggerBtn?.addEventListener('click', toggleModal);
    closeBtn?.addEventListener('click', closeModal);

    // -----------------------------------------------------------------------
    // DRAGGABLE MODAL IMPLEMENTATION (Smooth Pointer Dragging)
    // -----------------------------------------------------------------------
    if (header && modal) {
      let isDragging = false;
      let startX = 0;
      let startY = 0;
      let initialLeft = 0;
      let initialTop = 0;

      header.addEventListener('pointerdown', (e: PointerEvent) => {
        // Do not drag if clicked directly on close button or any clickable element
        if ((e.target as HTMLElement).closest('#unified-studio-close') || (e.target as HTMLElement).closest('button')) {
          return;
        }

        isDragging = true;
        startX = e.clientX;
        startY = e.clientY;
        const rect = modal.getBoundingClientRect();
        initialLeft = rect.left;
        initialTop = rect.top;

        modal.style.bottom = 'auto';
        modal.style.right = 'auto';
        modal.style.left = `${initialLeft}px`;
        modal.style.top = `${initialTop}px`;

        try {
          header.setPointerCapture(e.pointerId);
        } catch (_) {}

        const onPointerMove = (ev: PointerEvent) => {
          if (!isDragging) return;
          const dx = ev.clientX - startX;
          const dy = ev.clientY - startY;

          const maxLeft = Math.max(10, window.innerWidth - modal.offsetWidth - 10);
          const maxTop = Math.max(10, window.innerHeight - 80);
          const newLeft = Math.max(10, Math.min(maxLeft, initialLeft + dx));
          const newTop = Math.max(10, Math.min(maxTop, initialTop + dy));

          modal.style.left = `${newLeft}px`;
          modal.style.top = `${newTop}px`;
        };

        const onPointerUp = (ev: PointerEvent) => {
          isDragging = false;
          try {
            header.releasePointerCapture(ev.pointerId);
          } catch (_) {}
          window.removeEventListener('pointermove', onPointerMove);
          window.removeEventListener('pointerup', onPointerUp);
          window.removeEventListener('pointercancel', onPointerUp);
        };

        window.addEventListener('pointermove', onPointerMove);
        window.addEventListener('pointerup', onPointerUp);
        window.addEventListener('pointercancel', onPointerUp);
      });
    }

    // Keyboard Shortcuts
    window.addEventListener('keydown', (e) => {
      const tag = (document.activeElement?.tagName || '').toUpperCase();
      if (tag === 'INPUT' || tag === 'TEXTAREA') return;

      if (e.key === 'Escape' && !modal?.classList.contains('hidden')) {
        closeModal();
        return;
      }

      if (e.altKey && (e.key === 's' || e.key === 'S')) {
        e.preventDefault();
        toggleModal();
        return;
      }

      if (e.altKey && (e.key === 'p' || e.key === 'P')) {
        e.preventDefault();
        openModal('particles');
        return;
      }

      if (e.altKey && (e.key === 'l' || e.key === 'L')) {
        e.preventDefault();
        openModal('layout');
        return;
      }

      if (e.altKey && (e.key === 'f' || e.key === 'F')) {
        e.preventDefault();
        openModal('fonts');
        return;
      }
    });

    // -----------------------------------------------------------------------
    // PARTICLE TAB: MORPH STYLES BINDING
    // -----------------------------------------------------------------------
    const morphCards = document.querySelectorAll('.u-morph-card');
    function updateMorphStyleSelection(style: number) {
      morphCards.forEach(card => {
        const s = parseInt(card.getAttribute('data-morph-style') || '1', 10);
        const dot = card.querySelector('.u-morph-dot');
        if (s === style) {
          card.className = 'u-morph-card flex items-start gap-3 p-3 rounded-xl text-left border transition-all cursor-pointer bg-amber-400/15 border-amber-400/50 text-amber-200 shadow-sm';
          dot?.classList.remove('bg-slate-600');
          dot?.classList.add('bg-amber-400');
        } else {
          card.className = 'u-morph-card flex items-start gap-3 p-3 rounded-xl text-left border border-slate-700/60 bg-slate-900/60 text-slate-300 hover:border-slate-600 hover:bg-slate-800/50 transition-all cursor-pointer';
          dot?.classList.remove('bg-amber-400');
          dot?.classList.add('bg-slate-600');
        }
      });
      const api = (window as any).LuxuryParticleStudio;
      if (api) api.setMorphStyle(style);
    }

    morphCards.forEach(card => {
      card.addEventListener('click', () => {
        const s = parseInt(card.getAttribute('data-morph-style') || '1', 10);
        updateMorphStyleSelection(s);
      });
    });

    // Scrub Slider & Live Test Loop
    const scrubSlider = document.getElementById('u-morph-scrub-slider') as HTMLInputElement | null;
    const scrubVal = document.getElementById('u-morph-scrub-val');
    const syncScrollBtn = document.getElementById('u-btn-sync-scroll');
    const testMorphBtn = document.getElementById('u-btn-test-morph-anim');

    scrubSlider?.addEventListener('input', () => {
      const pct = parseFloat(scrubSlider.value);
      if (scrubVal) scrubVal.textContent = `${Math.round(pct)}%`;
      const api = (window as any).LuxuryParticleStudio;
      if (api) api.setMorphProgress(pct);
    });

    syncScrollBtn?.addEventListener('click', () => {
      const api = (window as any).LuxuryParticleStudio;
      if (api) api.setMorphProgress(null);
      if (scrubVal) scrubVal.textContent = 'Syncing...';
      setTimeout(() => {
        if (scrubVal) scrubVal.textContent = '0%';
        if (scrubSlider) scrubSlider.value = '0';
      }, 500);
    });

    testMorphBtn?.addEventListener('click', () => {
      const api = (window as any).LuxuryParticleStudio;
      if (api) {
        testMorphBtn.innerHTML = '<span>⏳ Playing Morph Test...</span>';
        api.testMorphAnimation(3200);
        setTimeout(() => {
          testMorphBtn.innerHTML = '<span>▶ Play 3-Sec Morph Test</span>';
        }, 3300);
      }
    });

    window.addEventListener('particle-studio:morph-updated', (e: any) => {
      const pct = e.detail?.pct || 0;
      if (scrubSlider) scrubSlider.value = String(pct);
      if (scrubVal) scrubVal.textContent = `${Math.round(pct)}%`;
    });

    // -----------------------------------------------------------------------
    // PARTICLE TAB: EFFECT SHOWCASE (MODES 1-8 + RANDOM + LOCK)
    // -----------------------------------------------------------------------
    const SHOWCASE_MODES = [
      { name: "Volumetric Quantum Aura", desc: "Pure harmonic celestial drift & aura around silhouette with pristine face stability. Move cursor to stir ethereal particles." },
      { name: "Silk Surface Ripple", desc: "Liquid gold ripples & hydrodynamic waves flow across the surface on cursor hover." },
      { name: "Celestial Lantern", desc: "Cursor acts as a bioluminescent light wand — igniting particles with warm stardust bloom without distortion." },
      { name: "Gravitational Lens", desc: "Spacetime curvature deflection bending particles along Einstein ring orbits around your cursor." },
      { name: "Fluid Stardust Wake", desc: "High-velocity curl noise turbulence and stardust streamlines trailing behind your cursor." },
      { name: "Soft Physics Displace", desc: "Elastic damped membrane displacing and rebounding smoothly with velvety recovery." },
      { name: "Neural Constellation", desc: "Synaptic filaments connecting nearby particles to your cursor with traveling action potentials." },
      { name: "Holographic Cyber Scanlines", desc: "Laser sweep with prismatic chromatic dispersion and horizontal slice scanlines." }
    ];

    const modeButtons = document.querySelectorAll('.u-mode-btn');
    const badgeActiveMode = document.getElementById('u-active-mode-badge');
    const titleDetail = document.getElementById('u-mode-detail-title');
    const descDetail = document.getElementById('u-mode-detail-desc');
    const btnRandom = document.getElementById('u-btn-dock-random');
    const textRandom = document.getElementById('u-btn-dock-random-text');
    const btnLock = document.getElementById('u-btn-dock-lock');
    const textLock = document.getElementById('u-btn-dock-lock-text');

    function syncShowcaseButtons() {
      const api = (window as any).LuxuryParticleStudio;
      if (!api) return;
      const isRandom = typeof api.isRandomMode === 'function' ? api.isRandomMode() : false;
      const isLocked = typeof api.isLocked === 'function' ? api.isLocked() : false;
      if (textRandom) {
        textRandom.textContent = isRandom ? "Random: ON" : "Random Load";
      }
      if (btnRandom) {
        if (isRandom) {
          btnRandom.className = "px-2.5 py-1.5 rounded-xl border border-amber-400/60 bg-amber-400/20 text-amber-300 text-xs font-mono font-bold flex items-center gap-1.5 transition-all cursor-pointer shadow-sm";
        } else {
          btnRandom.className = "px-2.5 py-1.5 rounded-xl border border-slate-700 bg-slate-900/80 hover:bg-slate-800 text-slate-300 hover:text-white text-xs font-mono font-medium flex items-center gap-1.5 transition-all cursor-pointer shadow-sm";
        }
      }
      if (textLock) {
        textLock.textContent = isLocked ? "Locked ⭐" : "Keep This";
      }
    }

    function updateActiveMode(mode: number) {
      const info = SHOWCASE_MODES[mode - 1] || SHOWCASE_MODES[0];
      if (badgeActiveMode) badgeActiveMode.textContent = `Mode ${mode}: ${info.name.split(' ')[0]}`;
      if (titleDetail) titleDetail.textContent = `Mode ${mode}: ${info.name}`;
      if (descDetail) descDetail.textContent = info.desc;

      modeButtons.forEach(btn => {
        const m = parseInt(btn.getAttribute('data-mode') || '1', 10);
        if (m === mode) {
          btn.className = 'u-mode-btn p-2.5 rounded-xl border text-left text-xs font-medium transition-all cursor-pointer bg-amber-400/20 border-amber-400 text-amber-300 font-bold shadow-sm';
        } else {
          btn.className = 'u-mode-btn p-2.5 rounded-xl border border-slate-700/60 bg-slate-900/60 text-slate-300 hover:border-slate-600 text-left text-xs font-medium transition-all cursor-pointer';
        }
      });
      const api = (window as any).LuxuryParticleStudio;
      if (api && api.switchMode) api.switchMode(mode);
      syncShowcaseButtons();
    }

    modeButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const m = parseInt(btn.getAttribute('data-mode') || '1', 10);
        updateActiveMode(m);
      });
    });

    btnRandom?.addEventListener('click', () => {
      const api = (window as any).LuxuryParticleStudio;
      if (api && api.triggerRandomMode) {
        const nextMode = api.triggerRandomMode();
        updateActiveMode(nextMode);
      }
    });

    btnLock?.addEventListener('click', () => {
      const api = (window as any).LuxuryParticleStudio;
      if (api && api.lockCurrentMode) {
        api.lockCurrentMode();
        if (textLock) textLock.textContent = "✓ Locked!";
        setTimeout(() => {
          syncShowcaseButtons();
        }, 1500);
      }
    });

    // Physics sliders
    const sIntensity = document.getElementById('u-slider-intensity') as HTMLInputElement | null;
    const sSpeed = document.getElementById('u-slider-speed') as HTMLInputElement | null;
    const sRadius = document.getElementById('u-slider-radius') as HTMLInputElement | null;
    const vIntensity = document.getElementById('u-physics-intensity-val');
    const vSpeed = document.getElementById('u-physics-speed-val');
    const vRadius = document.getElementById('u-physics-radius-val');

    function syncPhysics() {
      const intensity = parseFloat(sIntensity?.value || '1.0');
      const speed = parseFloat(sSpeed?.value || '1.0');
      const radius = parseFloat(sRadius?.value || '140');
      if (vIntensity) vIntensity.textContent = `${intensity.toFixed(2)}x`;
      if (vSpeed) vSpeed.textContent = `${speed.toFixed(2)}x`;
      if (vRadius) vRadius.textContent = `${Math.round(radius)}px`;
      const api = (window as any).LuxuryParticleStudio;
      if (api) api.setPhysics(intensity, speed, radius);
    }

    sIntensity?.addEventListener('input', syncPhysics);
    sSpeed?.addEventListener('input', syncPhysics);
    sRadius?.addEventListener('input', syncPhysics);

    // Image layout selection & sliders
    let activeImgIdx = 0;
    const imgTabs = document.querySelectorAll('.u-img-tab');
    const sScale = document.getElementById('u-slider-scale') as HTMLInputElement | null;
    const sAlignX = document.getElementById('u-slider-alignx') as HTMLInputElement | null;
    const sAlignY = document.getElementById('u-slider-aligny') as HTMLInputElement | null;
    const vScale = document.getElementById('u-layout-scale-val');
    const vAlignX = document.getElementById('u-layout-alignx-val');
    const vAlignY = document.getElementById('u-layout-aligny-val');
    const gizmoBox = document.getElementById('u-toggle-gizmo-box') as HTMLInputElement | null;

    function selectImage(idx: number) {
      activeImgIdx = idx;
      imgTabs.forEach((tab, i) => {
        if (i === idx) {
          tab.className = 'u-img-tab py-2 px-2 rounded-lg font-mono text-xs font-bold bg-amber-400 text-slate-950 shadow';
        } else {
          tab.className = 'u-img-tab py-2 px-2 rounded-lg font-mono text-xs text-slate-400 hover:text-white';
        }
      });
      const api = (window as any).LuxuryParticleStudio;
      if (api) {
        api.selectImageTab(idx);
        const curLayout = api.getLayout ? api.getLayout(idx) : null;
        if (curLayout) {
          if (sScale) sScale.value = curLayout.scale.toFixed(2);
          if (sAlignX) sAlignX.value = curLayout.alignX.toFixed(3);
          if (sAlignY) sAlignY.value = curLayout.alignY.toFixed(3);
          if (vScale) vScale.textContent = `${curLayout.scale.toFixed(2)}x`;
          if (vAlignX) vAlignX.textContent = `${Math.round(curLayout.alignX * 100)}%`;
          if (vAlignY) vAlignY.textContent = `${Math.round(curLayout.alignY * 100)}%`;
        }
      }
    }

    imgTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const idx = parseInt(tab.getAttribute('data-img-idx') || '0', 10);
        selectImage(idx);
      });
    });

    function syncLayoutSliders() {
      const scale = parseFloat(sScale?.value || '1.09');
      const alignX = parseFloat(sAlignX?.value || '0.76');
      const alignY = parseFloat(sAlignY?.value || '0.49');
      if (vScale) vScale.textContent = `${scale.toFixed(2)}x`;
      if (vAlignX) vAlignX.textContent = `${Math.round(alignX * 100)}%`;
      if (vAlignY) vAlignY.textContent = `${Math.round(alignY * 100)}%`;
      const api = (window as any).LuxuryParticleStudio;
      if (api) api.setLayout(activeImgIdx, scale, alignX, alignY);
    }

    sScale?.addEventListener('input', syncLayoutSliders);
    sAlignX?.addEventListener('input', syncLayoutSliders);
    sAlignY?.addEventListener('input', syncLayoutSliders);

    document.querySelectorAll('.u-preset-x-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const val = parseFloat(btn.getAttribute('data-val') || '0.5');
        if (sAlignX) sAlignX.value = String(val);
        syncLayoutSliders();
      });
    });

    gizmoBox?.addEventListener('change', () => {
      const api = (window as any).LuxuryParticleStudio;
      if (api) api.toggleGizmo(gizmoBox.checked);
    });

    // Listen to live gizmo drag/scale updates from canvas
    window.addEventListener('particle-studio:layout-updated', (e: any) => {
      const { idx, layout } = e.detail || {};
      if (idx === activeImgIdx && layout) {
        if (sScale) sScale.value = layout.scale.toFixed(2);
        if (sAlignX) sAlignX.value = layout.alignX.toFixed(3);
        if (sAlignY) sAlignY.value = layout.alignY.toFixed(3);
        if (vScale) vScale.textContent = `${layout.scale.toFixed(2)}x`;
        if (vAlignX) vAlignX.textContent = `${Math.round(layout.alignX * 100)}%`;
        if (vAlignY) vAlignY.textContent = `${Math.round(layout.alignY * 100)}%`;
      }
    });

    // Layout Save & Reset Buttons
    document.getElementById('u-btn-save-layout')?.addEventListener('click', (e) => {
      const api = (window as any).LuxuryParticleStudio;
      if (api) api.saveSettings();
      const target = e.currentTarget as HTMLElement;
      target.textContent = '✓ Saved Layout!';
      setTimeout(() => { target.textContent = 'Save Layout to Browser'; }, 1800);
    });

    document.getElementById('u-btn-reset-layout')?.addEventListener('click', () => {
      if (confirm('Reset canvas image layouts to defaults?')) {
        const api = (window as any).LuxuryParticleStudio;
        if (api) {
          api.resetDefaults();
          selectImage(activeImgIdx);
        }
      }
    });

    // Particle Physics Save & Reset Buttons
    document.getElementById('u-btn-save-particles')?.addEventListener('click', (e) => {
      const api = (window as any).LuxuryParticleStudio;
      if (api) api.saveSettings();
      const target = e.currentTarget as HTMLElement;
      target.textContent = '✓ Saved Physics!';
      setTimeout(() => { target.textContent = 'Save Physics to Browser'; }, 1800);
    });

    document.getElementById('u-btn-reset-particles')?.addEventListener('click', () => {
      if (confirm('Reset particle physics settings to defaults?')) {
        const api = (window as any).LuxuryParticleStudio;
        if (api) api.resetDefaults();
        updateMorphStyleSelection(1);
        updateActiveMode(1);
      }
    });

    // -----------------------------------------------------------------------
    // TYPOGRAPHY TAB BINDINGS
    // -----------------------------------------------------------------------
    const scopeBtns = document.querySelectorAll('.u-scope-btn');
    function updateScopeUI() {
      scopeBtns.forEach(btn => {
        const s = btn.getAttribute('data-scope');
        if (s === currentScope) {
          btn.className = 'u-scope-btn px-3 py-2 rounded-xl border border-amber-400/50 bg-amber-400/15 text-white font-medium text-xs text-left cursor-pointer';
        } else {
          btn.className = 'u-scope-btn px-3 py-2 rounded-xl border border-slate-700/60 bg-slate-900/60 text-slate-400 hover:text-white text-xs text-left cursor-pointer';
        }
      });
    }

    scopeBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const s = btn.getAttribute('data-scope');
        if (s) {
          currentScope = s;
          updateScopeUI();
          applyTypography();
        }
      });
    });

    const catPills = document.querySelectorAll('.u-cat-pill');
    catPills.forEach(pill => {
      pill.addEventListener('click', () => {
        const cat = pill.getAttribute('data-cat') || 'all';
        activeFontCategory = cat;
        catPills.forEach(p => {
          p.className = 'u-cat-pill px-2.5 py-1 rounded-lg text-xs font-medium bg-slate-900 text-slate-400 hover:text-white cursor-pointer';
        });
        pill.className = 'u-cat-pill px-2.5 py-1 rounded-lg text-xs font-medium bg-amber-400 text-slate-950 font-bold cursor-pointer';
        renderFontList();
      });
    });

    const sliderSpacing = document.getElementById('u-font-slider-spacing') as HTMLInputElement | null;
    const sliderWeight = document.getElementById('u-font-slider-weight') as HTMLInputElement | null;
    const sliderSize = document.getElementById('u-font-slider-size') as HTMLInputElement | null;
    const valSpacing = document.getElementById('u-font-val-spacing');
    const valWeight = document.getElementById('u-font-val-weight');
    const valSize = document.getElementById('u-font-val-size');

    sliderSpacing?.addEventListener('input', () => {
      currentSpacing = `${sliderSpacing.value}em`;
      if (valSpacing) valSpacing.textContent = currentSpacing;
      applyTypography();
    });

    sliderWeight?.addEventListener('input', () => {
      currentWeight = sliderWeight.value;
      if (valWeight) valWeight.textContent = currentWeight;
      applyTypography();
    });

    sliderSize?.addEventListener('input', () => {
      currentSize = `${sliderSize.value}rem`;
      if (valSize) valSize.textContent = currentSize;
      applyTypography();
    });

    const transformBtns = document.querySelectorAll('.u-font-transform-btn');
    function updateTransformUI() {
      transformBtns.forEach(b => {
        const t = b.getAttribute('data-transform') || 'none';
        if (t === currentTransform) {
          b.className = 'u-font-transform-btn px-2 py-0.5 rounded bg-amber-400/20 text-amber-300 border border-amber-400/40 font-bold cursor-pointer';
        } else {
          b.className = 'u-font-transform-btn px-2 py-0.5 rounded bg-slate-900 text-slate-400 hover:text-white cursor-pointer';
        }
      });
    }

    transformBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const t = btn.getAttribute('data-transform') || 'none';
        currentTransform = t;
        updateTransformUI();
        applyTypography();
      });
    });

    document.getElementById('u-btn-copy-css')?.addEventListener('click', (e) => {
      const font = FONTS_CATALOG.find(f => f.id === currentFontId) || FONTS_CATALOG[0];
      const css = `/* ${font.name} typography preset */\nfont-family: ${font.family};\nfont-size: ${currentSize};\nletter-spacing: ${currentSpacing};\nfont-weight: ${currentWeight};\ntext-transform: ${currentTransform};`;
      navigator.clipboard.writeText(css).then(() => {
        const target = e.currentTarget as HTMLElement;
        target.textContent = '✓ Copied CSS!';
        setTimeout(() => { target.textContent = '📋 Copy CSS'; }, 1800);
      });
    });

    document.getElementById('u-btn-reset-fonts')?.addEventListener('click', () => {
      currentFontId = 'cinzel';
      currentScope = 'everything';
      currentSpacing = '0.03em';
      currentWeight = '700';
      currentSize = '0.875rem';
      currentTransform = 'none';
      if (sliderSpacing) sliderSpacing.value = '0.03';
      if (sliderWeight) sliderWeight.value = '700';
      if (sliderSize) sliderSize.value = '0.875';
      if (valSpacing) valSpacing.textContent = '0.03em';
      if (valWeight) valWeight.textContent = '700';
      if (valSize) valSize.textContent = '0.875rem';
      updateScopeUI();
      updateTransformUI();
      applyTypography();
      renderFontList();
    });

    // Initial sync
    syncShowcaseButtons();
    updateScopeUI();
    updateTransformUI();
    renderFontList();
    applyTypography();

    // Hotkeys 1-8 and R to switch modes live
    window.addEventListener('keydown', (e) => {
      const tag = (document.activeElement?.tagName || '').toUpperCase();
      if (tag === 'INPUT' || tag === 'TEXTAREA') return;
      if (['1', '2', '3', '4', '5', '6', '7', '8'].includes(e.key)) {
        const mode = parseInt(e.key, 10);
        updateActiveMode(mode);
      } else if (e.key === 'r' || e.key === 'R') {
        const api = (window as any).LuxuryParticleStudio;
        if (api && api.triggerRandomMode) {
          const next = api.triggerRandomMode();
          updateActiveMode(next);
        }
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initUnifiedStudio);
  } else {
    initUnifiedStudio();
  }
</script>
