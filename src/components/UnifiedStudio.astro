---
// Unified Creative Studio: Particle VFX & Typography in One Breathable, Friendly Tabbed Modal
---

<!-- Single Floating Studio Launcher Button (Bottom Right) -->
<div id="unified-studio-launcher" class="fixed bottom-6 right-6 z-50 select-none">
  <button
    id="unified-studio-trigger"
    type="button"
    class="studio-launcher-btn group flex items-center gap-2.5 px-4 py-2.5 rounded-full bg-slate-900/95 hover:bg-slate-800 text-slate-100 border border-slate-700/80 shadow-xl hover:shadow-2xl backdrop-blur-xl text-xs font-medium transition-all duration-300 hover:scale-105 cursor-pointer hover:border-amber-400/60"
    title="Open Creative Studio: Particle VFX & Typography (Alt+S)"
  >
    <span class="flex items-center justify-center w-5 h-5 rounded-full bg-gradient-to-tr from-amber-500 to-amber-300 text-slate-950 font-black text-[11px] shadow-sm group-hover:rotate-12 transition-transform">✦</span>
    <span class="font-semibold tracking-wide">Studio</span>
    <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-slate-800 text-slate-400 border border-slate-700/50">Alt+S</span>
  </button>
</div>

<!-- Unified Studio Floating Modal Window -->
<div
  id="unified-studio-modal"
  class="fixed bottom-20 right-6 z-50 hidden w-[540px] max-w-[calc(100vw-32px)] max-h-[85vh] flex-col rounded-3xl bg-slate-900/98 text-slate-100 border border-slate-700/80 shadow-[0_25px_70px_-15px_rgba(0,0,0,0.85)] backdrop-blur-2xl overflow-hidden font-sans select-none transition-all duration-300 ease-out"
>
  <!-- Modal Header: Draggable Title Bar & Close Button -->
  <div
    id="unified-studio-header"
    class="flex items-center justify-between px-5 py-3.5 border-b border-slate-800 bg-slate-950/80 cursor-move select-none shrink-0"
    title="Creative Studio • Drag header to move anywhere on screen"
  >
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-amber-500 to-amber-300 flex items-center justify-center text-slate-950 font-black text-sm shadow-md">
        ✦
      </div>
      <div>
        <h2 class="font-bold text-sm text-white tracking-tight flex items-center gap-2">
          <span>Creative Studio</span>
          <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-amber-400/15 text-amber-300 border border-amber-400/30">Pro Lab</span>
        </h2>
        <p class="text-[11px] text-slate-400 font-normal flex items-center gap-1.5">
          <span>Particle Physics &bull; Layout &bull; Typography</span>
          <span class="text-slate-600 hidden sm:inline">&bull;</span>
          <span class="text-[10px] text-slate-400 hidden sm:inline">Drag to move</span>
        </p>
      </div>
    </div>

    <div class="flex items-center gap-2">
      <!-- Drag Grip Indicator -->
      <div class="hidden sm:flex items-center text-slate-500 text-xs tracking-tighter px-1.5 select-none" title="Drag handle">
        ⋮⋮
      </div>
      <button
        id="unified-studio-close"
        type="button"
        class="w-7 h-7 rounded-xl flex items-center justify-center text-slate-400 hover:text-white hover:bg-slate-800 transition-colors text-lg cursor-pointer"
        title="Close Studio (Esc)"
      >
        &times;
      </button>
    </div>
  </div>

  <!-- Segmented 3-Tab Switcher (Breathable, Clear & Responsive) -->
  <div class="px-5 pt-3 pb-2 border-b border-slate-800/80 bg-slate-900/90 shrink-0">
    <div class="grid grid-cols-3 p-1 bg-slate-950/80 rounded-2xl border border-slate-800 gap-1">
      <button
        type="button"
        id="tab-btn-particles"
        class="studio-tab-btn flex items-center justify-center gap-1.5 py-2 px-2 rounded-xl font-medium text-xs transition-all cursor-pointer bg-gradient-to-r from-amber-500/20 to-amber-400/20 text-amber-300 border border-amber-400/40 shadow-sm"
        data-tab="particles"
      >
        <span class="text-amber-400">✦</span>
        <span>Particle Physics</span>
        <span class="text-[10px] font-mono text-slate-400 hidden lg:inline">Alt+P</span>
      </button>

      <button
        type="button"
        id="tab-btn-layout"
        class="studio-tab-btn flex items-center justify-center gap-1.5 py-2 px-2 rounded-xl font-medium text-xs transition-all cursor-pointer text-slate-400 hover:text-slate-200 hover:bg-slate-800/50"
        data-tab="layout"
      >
        <span class="text-emerald-400 font-bold">📐</span>
        <span>Layout Studio</span>
        <span class="text-[10px] font-mono text-slate-400 hidden lg:inline">Alt+L</span>
      </button>

      <button
        type="button"
        id="tab-btn-fonts"
        class="studio-tab-btn flex items-center justify-center gap-1.5 py-2 px-2 rounded-xl font-medium text-xs transition-all cursor-pointer text-slate-400 hover:text-slate-200 hover:bg-slate-800/50"
        data-tab="fonts"
      >
        <span class="text-sky-400 font-serif font-bold">Aa</span>
        <span>Typography</span>
        <span class="text-[10px] font-mono text-slate-400 hidden lg:inline">Alt+F</span>
      </button>
    </div>
  </div>

  <!-- Modal Scrollable Content Container -->
  <div class="p-5 overflow-y-auto flex-grow space-y-6 max-h-[calc(85vh-150px)]">

    <!-- ===================================================================== -->
    <!-- TAB 1: PARTICLE & VFX STUDIO                                         -->
    <!-- ===================================================================== -->
    <div id="tab-content-particles" class="space-y-5">
      
      <!-- 1. MORPH TRANSITION STYLES (User's Key Request!) -->
      <div class="p-4 rounded-2xl bg-slate-800/60 border border-slate-700/60 space-y-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-amber-400 shadow-[0_0_8px_#f59e0b]"></span>
            <label class="text-xs font-bold text-white uppercase tracking-wider">Image Morph Transition Style</label>
          </div>
          <span class="text-[10px] font-mono text-amber-300/90 bg-amber-400/10 px-2 py-0.5 rounded-full border border-amber-400/20">5 Styles</span>
        </div>
        <p class="text-[11px] text-slate-400 leading-normal">
          Determines how particles flow and reassemble between pictures when scrolling:
        </p>

        <!-- 5 Style Option Cards -->
        <div id="u-morph-style-cards" class="grid grid-cols-1 gap-2">
          
          <!-- Style 1: Direct Spatial Flow (User Idea 1) -->
          <button
            type="button"
            class="u-morph-card flex items-start gap-3 p-3 rounded-xl text-left border transition-all cursor-pointer bg-amber-400/15 border-amber-400/50 text-amber-200 shadow-sm"
            data-morph-style="1"
          >
            <span class="u-morph-dot mt-1 w-2.5 h-2.5 rounded-full bg-amber-400 shrink-0"></span>
            <div class="flex-grow">
              <div class="flex items-center justify-between">
                <span class="font-bold text-xs text-white">1. Direct Spatial Flow <span class="text-[10px] font-mono text-amber-300 font-semibold">(Logical Flow)</span></span>
                <span class="text-[10px] font-mono px-1.5 py-0.2 rounded bg-amber-400/20 text-amber-300">Recommended</span>
              </div>
              <p class="text-[11px] text-slate-300 mt-0.5">
                Particles navigate directly to matching coordinates in the next image — clean, logical, and structured.
              </p>
            </div>
          </button>

          <!-- Style 2: Wind Swirl & Vortex (User Idea 2) -->
          <button
            type="button"
            class="u-morph-card flex items-start gap-3 p-3 rounded-xl text-left border border-slate-700/60 bg-slate-900/60 text-slate-300 hover:border-slate-600 hover:bg-slate-800/50 transition-all cursor-pointer"
            data-morph-style="2"
          >
            <span class="u-morph-dot mt-1 w-2.5 h-2.5 rounded-full bg-slate-600 shrink-0"></span>
            <div class="flex-grow">
              <div class="flex items-center justify-between">
                <span class="font-bold text-xs text-white">2. Wind Swirl &amp; Vortex <span class="text-[10px] font-mono text-amber-300 font-semibold">(Cyclone Storm)</span></span>
                <span class="text-[10px] font-mono px-1.5 py-0.2 rounded bg-slate-800 text-slate-400">Dynamic</span>
              </div>
              <p class="text-[11px] text-slate-400 mt-0.5">
                A windstorm blows across, tears the image into a swirling vortex, then calmly converges into the next image.
              </p>
            </div>
          </button>

          <!-- Style 3: Diagonal Wave Wipe -->
          <button
            type="button"
            class="u-morph-card flex items-start gap-3 p-3 rounded-xl text-left border border-slate-700/60 bg-slate-900/60 text-slate-300 hover:border-slate-600 hover:bg-slate-800/50 transition-all cursor-pointer"
            data-morph-style="3"
          >
            <span class="u-morph-dot mt-1 w-2.5 h-2.5 rounded-full bg-slate-600 shrink-0"></span>
            <div class="flex-grow">
              <span class="font-bold text-xs text-white">3. Diagonal Wave Wipe</span>
              <p class="text-[11px] text-slate-400 mt-0.5">
                An editorial light-seam sweeps diagonally; particles seamlessly transform on contact.
              </p>
            </div>
          </button>

          <!-- Style 4: Gravity Singularity -->
          <button
            type="button"
            class="u-morph-card flex items-start gap-3 p-3 rounded-xl text-left border border-slate-700/60 bg-slate-900/60 text-slate-300 hover:border-slate-600 hover:bg-slate-800/50 transition-all cursor-pointer"
            data-morph-style="4"
          >
            <span class="u-morph-dot mt-1 w-2.5 h-2.5 rounded-full bg-slate-600 shrink-0"></span>
            <div class="flex-grow">
              <span class="font-bold text-xs text-white">4. Gravity Collapse (Singularity)</span>
              <p class="text-[11px] text-slate-400 mt-0.5">
                Black hole implosion into a luminous cosmic core, then blossoms outward into the next image.
              </p>
            </div>
          </button>

          <!-- Style 5: Radial Iris Aperture -->
          <button
            type="button"
            class="u-morph-card flex items-start gap-3 p-3 rounded-xl text-left border border-slate-700/60 bg-slate-900/60 text-slate-300 hover:border-slate-600 hover:bg-slate-800/50 transition-all cursor-pointer"
            data-morph-style="5"
          >
            <span class="u-morph-dot mt-1 w-2.5 h-2.5 rounded-full bg-slate-600 shrink-0"></span>
            <div class="flex-grow">
              <span class="font-bold text-xs text-white">5. Radial Iris Aperture</span>
              <p class="text-[11px] text-slate-400 mt-0.5">
                A camera iris ring opens outward with a gentle twisting reveal.
              </p>
            </div>
          </button>

        </div>

        <!-- Live Scrub & Animation Preview Controls -->
        <div class="pt-3 border-t border-slate-700/60 space-y-2">
          <div class="flex items-center justify-between text-xs">
            <span class="text-slate-300 font-medium">Scrub Morph Progress:</span>
            <div class="flex items-center gap-2">
              <span id="u-morph-scrub-val" class="font-mono text-amber-300 font-bold">0%</span>
              <button
                type="button"
                id="u-btn-sync-scroll"
                class="text-[11px] font-mono text-sky-400 hover:text-sky-300 underline cursor-pointer"
              >
                Sync to Scroll
              </button>
            </div>
          </div>

          <input
            id="u-morph-scrub-slider"
            type="range"
            min="0"
            max="100"
            step="0.5"
            value="0"
            class="w-full accent-amber-400 h-2 bg-slate-950 rounded-lg appearance-none cursor-pointer"
          />

          <!-- Play Test Animation Button -->
          <div class="flex gap-2 pt-1">
            <button
              type="button"
              id="u-btn-test-morph-anim"
              class="flex-grow py-2 px-3 rounded-xl bg-gradient-to-r from-amber-500 to-amber-400 hover:from-amber-400 hover:to-amber-300 text-slate-950 font-bold text-xs flex items-center justify-center gap-1.5 transition-all shadow-md cursor-pointer hover:scale-[1.02]"
            >
              <span>▶ Play 3-Sec Morph Test</span>
            </button>
          </div>
        </div>

      </div>

      <!-- 2. EFFECT SHOWCASE (MODES 1 TO 8 + RANDOMIZE + LOCK) -->
      <div class="p-4 rounded-2xl bg-slate-800/60 border border-slate-700/60 space-y-3.5">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <div>
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-amber-400 shadow-[0_0_10px_#f59e0b] animate-pulse"></span>
              <label class="text-xs font-bold text-white uppercase tracking-wider">Effect Showcase</label>
              <span id="u-active-mode-badge" class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-amber-400/20 text-amber-300 border border-amber-400/30">Mode 1: Quantum Aura</span>
            </div>
            <p class="text-[11px] text-slate-400 mt-0.5">Test, shuffle, or lock your interactive particle physics mode</p>
          </div>

          <!-- Showcase Action Buttons (Random Load & Keep This) -->
          <div class="flex items-center gap-1.5 shrink-0">
            <button
              type="button"
              id="u-btn-dock-random"
              class="px-2.5 py-1.5 rounded-xl border border-slate-700 bg-slate-900/80 hover:bg-slate-800 text-slate-300 hover:text-white text-xs font-mono font-medium flex items-center gap-1.5 transition-all cursor-pointer shadow-sm"
              title="Play random effect on each page load (Press R)"
            >
              <span>🎲</span>
              <span id="u-btn-dock-random-text">Random Load</span>
            </button>

            <button
              type="button"
              id="u-btn-dock-lock"
              class="px-2.5 py-1.5 rounded-xl border border-amber-400/50 bg-amber-400/15 hover:bg-amber-400 hover:text-slate-950 text-amber-300 text-xs font-mono font-bold flex items-center gap-1.5 transition-all cursor-pointer shadow-sm"
              title="Lock this selected effect permanently on every load"
            >
              <span>⭐</span>
              <span id="u-btn-dock-lock-text">Keep This</span>
            </button>
          </div>
        </div>

        <!-- Dynamic Effect Information Box -->
        <div id="u-mode-detail-card" class="p-3 rounded-xl bg-slate-950/70 border border-slate-800 space-y-1">
          <div class="flex items-center justify-between">
            <h4 id="u-mode-detail-title" class="font-bold text-xs text-amber-300">Mode 1: Volumetric Quantum Aura</h4>
            <span class="text-[10px] font-mono text-slate-500">Press 1–8 live</span>
          </div>
          <p id="u-mode-detail-desc" class="text-[11px] text-slate-300 leading-relaxed">
            Move cursor across screen — concentric holographic orbital drift and breathing aura around silhouette with pristine face stability.
          </p>
        </div>

        <!-- 8 Mode Selector Cards -->
        <div id="u-particle-mode-grid" class="grid grid-cols-2 gap-2">
          <button type="button" data-mode="1" class="u-mode-btn p-2.5 rounded-xl border text-left text-xs font-medium transition-all cursor-pointer bg-amber-400/20 border-amber-400 text-amber-300 font-bold shadow-sm">
            <div class="flex items-center justify-between">
              <span class="font-bold">1. Quantum Aura</span>
              <span class="text-[9px] font-mono px-1 rounded bg-amber-400/20 text-amber-300">1</span>
            </div>
            <div class="text-[10px] text-slate-300 mt-0.5">Harmonic Drift</div>
          </button>

          <button type="button" data-mode="2" class="u-mode-btn p-2.5 rounded-xl border border-slate-700/60 bg-slate-900/60 text-slate-300 hover:border-slate-600 text-left text-xs font-medium transition-all cursor-pointer">
            <div class="flex items-center justify-between">
              <span class="font-bold">2. Silk Ripple</span>
              <span class="text-[9px] font-mono px-1 rounded bg-slate-800 text-slate-400">2</span>
            </div>
            <div class="text-[10px] text-slate-400 mt-0.5">Liquid Gold Waves</div>
          </button>

          <button type="button" data-mode="3" class="u-mode-btn p-2.5 rounded-xl border border-slate-700/60 bg-slate-900/60 text-slate-300 hover:border-slate-600 text-left text-xs font-medium transition-all cursor-pointer">
            <div class="flex items-center justify-between">
              <span class="font-bold">3. Celestial Lantern</span>
              <span class="text-[9px] font-mono px-1 rounded bg-slate-800 text-slate-400">3</span>
            </div>
            <div class="text-[10px] text-slate-400 mt-0.5">Bioluminescent</div>
          </button>

          <button type="button" data-mode="4" class="u-mode-btn p-2.5 rounded-xl border border-slate-700/60 bg-slate-900/60 text-slate-300 hover:border-slate-600 text-left text-xs font-medium transition-all cursor-pointer">
            <div class="flex items-center justify-between">
              <span class="font-bold">4. Gravitational Lens</span>
              <span class="text-[9px] font-mono px-1 rounded bg-slate-800 text-slate-400">4</span>
            </div>
            <div class="text-[10px] text-slate-400 mt-0.5">Curvature Warp</div>
          </button>

          <button type="button" data-mode="5" class="u-mode-btn p-2.5 rounded-xl border border-slate-700/60 bg-slate-900/60 text-slate-300 hover:border-slate-600 text-left text-xs font-medium transition-all cursor-pointer">
            <div class="flex items-center justify-between">
              <span class="font-bold">5. Stardust Wake</span>
              <span class="text-[9px] font-mono px-1 rounded bg-slate-800 text-slate-400">5</span>
            </div>
            <div class="text-[10px] text-slate-400 mt-0.5">Curl Turbulence</div>
          </button>

          <button type="button" data-mode="6" class="u-mode-btn p-2.5 rounded-xl border border-slate-700/60 bg-slate-900/60 text-slate-300 hover:border-slate-600 text-left text-xs font-medium transition-all cursor-pointer">
            <div class="flex items-center justify-between">
              <span class="font-bold">6. Soft Displace</span>
              <span class="text-[9px] font-mono px-1 rounded bg-slate-800 text-slate-400">6</span>
            </div>
            <div class="text-[10px] text-slate-400 mt-0.5">Elastic Membrane</div>
          </button>

          <button type="button" data-mode="7" class="u-mode-btn p-2.5 rounded-xl border border-slate-700/60 bg-slate-900/60 text-slate-300 hover:border-slate-600 text-left text-xs font-medium transition-all cursor-pointer">
            <div class="flex items-center justify-between">
              <span class="font-bold">7. Neural Web</span>
              <span class="text-[9px] font-mono px-1 rounded bg-slate-800 text-slate-400">7</span>
            </div>
            <div class="text-[10px] text-slate-400 mt-0.5">Synaptic Filaments</div>
          </button>

          <button type="button" data-mode="8" class="u-mode-btn p-2.5 rounded-xl border border-slate-700/60 bg-slate-900/60 text-slate-300 hover:border-slate-600 text-left text-xs font-medium transition-all cursor-pointer">
            <div class="flex items-center justify-between">
              <span class="font-bold">8. Cyber Scanlines</span>
              <span class="text-[9px] font-mono px-1 rounded bg-slate-800 text-slate-400">8</span>
            </div>
            <div class="text-[10px] text-slate-400 mt-0.5">Laser Prismatic</div>
          </button>
        </div>

        <!-- Sliders: Intensity, Speed, Radius -->
        <div class="pt-3 border-t border-slate-700/60 space-y-3 font-mono text-xs">
          <div>
            <div class="flex justify-between mb-1">
              <span class="text-slate-300">Effect Intensity:</span>
              <span id="u-physics-intensity-val" class="text-amber-300 font-bold">1.00x</span>
            </div>
            <input id="u-slider-intensity" type="range" min="0.2" max="2.5" step="0.05" value="1.0" class="w-full accent-amber-400 h-2 bg-slate-950 rounded-lg cursor-pointer" />
          </div>
          <div>
            <div class="flex justify-between mb-1">
              <span class="text-slate-300">Speed / Frequency:</span>
              <span id="u-physics-speed-val" class="text-amber-300 font-bold">1.00x</span>
            </div>
            <input id="u-slider-speed" type="range" min="0.2" max="2.5" step="0.05" value="1.0" class="w-full accent-amber-400 h-2 bg-slate-950 rounded-lg cursor-pointer" />
          </div>
          <div>
            <div class="flex justify-between mb-1">
              <span class="text-slate-300">Influence Radius:</span>
              <span id="u-physics-radius-val" class="text-amber-300 font-bold">140px</span>
            </div>
            <input id="u-slider-radius" type="range" min="60" max="260" step="5" value="140" class="w-full accent-amber-400 h-2 bg-slate-950 rounded-lg cursor-pointer" />
          </div>
        </div>
      </div>

      <!-- Particle Physics Action Buttons -->
      <div class="flex items-center justify-between gap-2 pt-2">
        <button
          type="button"
          id="u-btn-save-particles"
          class="flex-1 py-2 px-3 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-600 text-white font-mono text-xs font-semibold transition-all cursor-pointer"
        >
          Save Physics to Browser
        </button>
        <button
          type="button"
          id="u-btn-reset-particles"
          class="py-2 px-3 rounded-xl text-slate-400 hover:text-rose-400 font-mono text-xs transition-colors cursor-pointer"
        >
          Reset Defaults
        </button>
      </div>

    </div>

    <!-- ===================================================================== -->
    <!-- TAB 2: CANVAS LAYOUT STUDIO                                          -->
    <!-- ===================================================================== -->
    <div id="tab-content-layout" class="space-y-5 hidden">
      
      <!-- IMAGE POSITIONING & CANVAS GIZMO -->
      <div class="p-4 rounded-2xl bg-slate-800/60 border border-slate-700/60 space-y-4">
        <div class="flex items-center justify-between">
          <div>
            <label class="text-xs font-bold text-white uppercase tracking-wider block">Canvas Image Placement &amp; Scaling</label>
            <p class="text-[11px] text-slate-400 mt-0.5">Position each image target in 2D viewport coordinates</p>
          </div>
          <div class="flex items-center gap-2 bg-slate-900/90 px-2.5 py-1.5 rounded-xl border border-slate-700/60">
            <input type="checkbox" id="u-toggle-gizmo-box" checked class="accent-amber-400 cursor-pointer rounded" />
            <label for="u-toggle-gizmo-box" class="text-[11px] text-amber-300 font-medium cursor-pointer">Show Drag Box</label>
          </div>
        </div>

        <!-- Image Selector Pills -->
        <div class="space-y-1.5">
          <span class="text-[10px] font-mono text-slate-400 uppercase tracking-wider">Select Target Image:</span>
          <div class="grid grid-cols-3 gap-1.5 p-1 bg-slate-950 rounded-xl border border-slate-800" id="u-image-selector-tabs">
            <button type="button" data-img-idx="0" class="u-img-tab py-2 px-2 rounded-lg font-mono text-xs font-bold bg-amber-400 text-slate-950 shadow">Img 1 (Hero)</button>
            <button type="button" data-img-idx="1" class="u-img-tab py-2 px-2 rounded-lg font-mono text-xs text-slate-400 hover:text-white">Img 2 (Mondoro)</button>
            <button type="button" data-img-idx="2" class="u-img-tab py-2 px-2 rounded-lg font-mono text-xs text-slate-400 hover:text-white">Img 3 (Censor)</button>
          </div>
        </div>

        <!-- Scale, AlignX, AlignY -->
        <div class="space-y-3.5 font-mono text-xs pt-1">
          <div>
            <div class="flex justify-between mb-1">
