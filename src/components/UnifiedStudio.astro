        <div class="p-3 rounded-xl bg-slate-950/60 border border-slate-800 text-[11px] text-slate-400 flex items-start gap-2">
          <span class="text-amber-400 text-sm">💡</span>
          <span>Tip: When <strong>"Show Drag Box"</strong> is enabled, you can click and drag the yellow dotted box directly on the screen or drag its corners to resize!</span>
        </div>
      </div>

      <!-- Action Buttons for Layout -->
      <div class="flex items-center justify-between gap-2 pt-1">
        <button
          type="button"
          id="u-btn-save-layout"
          class="flex-1 py-2 px-3 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-600 text-white font-mono text-xs font-semibold transition-all cursor-pointer"
        >
          Save Layout to Browser
