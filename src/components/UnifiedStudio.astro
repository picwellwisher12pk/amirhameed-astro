            <div class="flex gap-2 mt-2">
              <button type="button" class="u-preset-x-btn px-2.5 py-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 border border-slate-700/60 text-[11px] text-slate-300 cursor-pointer" data-val="0.32">Left (32%)</button>
              <button type="button" class="u-preset-x-btn px-2.5 py-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 border border-slate-700/60 text-[11px] text-slate-300 cursor-pointer" data-val="0.50">Center (50%)</button>
              <button type="button" class="u-preset-x-btn px-2.5 py-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 border border-slate-700/60 text-[11px] text-slate-300 cursor-pointer" data-val="0.76">Right (76%)</button>
