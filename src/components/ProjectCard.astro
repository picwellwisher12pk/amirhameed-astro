---
interface Props {
  project: {
    id: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      category: string;
      tags: string[];
      heroImage?: string;
      demoUrl?: string;
      repoUrl?: string;
      featured?: boolean;
      status?: string;
    };
  };
}

const { project } = Astro.props;
const { data, id } = project;
---

<div class="luxury-project-card group relative flex flex-col rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/60 p-6 transition-all duration-300 hover:-translate-y-1 hover:border-indigo-500/50 hover:shadow-xl hover:shadow-indigo-500/5">
  <!-- Card Header: Category & Status -->
  <div class="flex items-center justify-between gap-2 mb-4">
    <span class="luxury-card-category inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 border border-indigo-100 dark:border-indigo-900/40">
      {data.category}
    </span>
    
    {data.status && (
      <span class:list={[
        "luxury-card-status text-[11px] font-mono font-medium px-2 py-0.5 rounded-md",
        data.status === 'completed' ? "bg-emerald-50 text-emerald-600 dark:bg-emerald-950/50 dark:text-emerald-400 border border-emerald-200/50 dark:border-emerald-800/30" : "bg-amber-50 text-amber-600 dark:bg-amber-950/50 dark:text-amber-400 border border-amber-200/50 dark:border-amber-800/30"
      ]}>
        {data.status === 'completed' ? 'Live' : 'In Progress'}
      </span>
    )}
  </div>

  <!-- Title & Description -->
  <h3 class="luxury-card-title text-xl font-bold text-zinc-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
    <a href={`/projects/${id}`}>
      <span class="absolute inset-0"></span>
      {data.title}
    </a>
  </h3>

  <p class="luxury-card-desc mt-2 text-sm text-zinc-600 dark:text-zinc-400 line-clamp-3 leading-relaxed flex-grow">
    {data.description}
  </p>

  <!-- Tags -->
  <div class="luxury-card-tags mt-5 flex flex-wrap gap-1.5 z-10">
    {data.tags.map((tag) => (
      <span class="luxury-tag-pill px-2 py-0.5 text-xs font-mono rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400">
        #{tag}
      </span>
    ))}
  </div>

  <!-- Card Footer Links -->
  <div class="luxury-card-footer mt-6 pt-4 border-t border-zinc-100 dark:border-zinc-800/70 flex items-center justify-between z-10 text-xs font-medium">
    <span class="luxury-card-date text-zinc-400 dark:text-zinc-500 font-mono">
      {data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}
    </span>

    <div class="flex items-center gap-3">
      {data.repoUrl && (
        <a 
          href={data.repoUrl} 
          target="_blank" 
          rel="noopener noreferrer"
          class="luxury-card-link text-zinc-500 hover:text-zinc-900 dark:hover:text-white transition-colors"
          title="View Source Repository"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
        </a>
      )}

      {data.demoUrl && (
        <a 
          href={data.demoUrl} 
          target="_blank" 
          rel="noopener noreferrer"
          class="luxury-card-link inline-flex items-center gap-1 text-indigo-600 dark:text-indigo-400 hover:underline"
        >
          <span>Demo</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
        </a>
      )}
    </div>
  </div>
</div>
