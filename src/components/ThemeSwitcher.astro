---
// Theme Switcher Widget (Embedded in Footer - Disabled for now)
---

<!-- Footer Embedded Theme Switcher Widget -->
<div id="theme-switcher-widget" class="relative inline-flex items-center theme-switcher-widget">
  <div class="relative">
    <button 
      id="theme-switcher-toggle"
      disabled
      aria-disabled="true"
      class="flex items-center gap-2 px-3 py-1.5 rounded-full border border-zinc-200 dark:border-zinc-800/90 bg-white/60 dark:bg-zinc-900/60 backdrop-blur-sm text-xs font-mono text-zinc-400 dark:text-zinc-500 cursor-not-allowed opacity-75 select-none transition-all"
      title="Theme switching is disabled for now"
    >
      <span class="w-2 h-2 rounded-full bg-[#d4af37]" id="active-theme-dot"></span>
      <span id="active-theme-name" class="font-medium">Luxury Classical</span>
      <!-- Palette icon -->
      <svg class="w-3.5 h-3.5 text-zinc-400/80 dark:text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4 5 5 0 015-5h4a5 5 0 015 5 4 4 0 01-4 4H7zM12 3v6m0 0l-3-3m3 3l3-3" />
      </svg>
      <span class="text-[9px] uppercase tracking-wider px-1.5 py-0.5 rounded bg-zinc-200/50 dark:bg-zinc-800/60 text-zinc-500 dark:text-zinc-400 font-sans">Disabled</span>
    </button>

    <!-- Dropdown / Modal Panel (Kept for future re-enabling; pops up above footer) -->
    <div 
      id="theme-switcher-menu" 
      class="hidden absolute bottom-full mb-3 right-0 sm:right-auto sm:left-0 w-72 p-4 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 shadow-2xl space-y-3 font-sans z-50 pointer-events-none"
    >
      <div class="flex items-center justify-between pb-2 border-b border-zinc-100 dark:border-zinc-800">
        <span class="text-xs font-bold text-zinc-900 dark:text-white uppercase tracking-wider font-mono">Theme Personality</span>
        <button id="close-theme-menu" class="text-zinc-400 hover:text-zinc-600 dark:hover:text-white text-xs">&times;</button>
      </div>

      <!-- Theme options -->
      <div class="space-y-1.5" id="theme-options-list">
        
        <button 
          data-theme-choice="modern"
          class="theme-opt w-full flex items-center justify-between p-2 rounded-xl text-left hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors text-xs font-medium cursor-pointer"
        >
          <div class="flex items-center gap-2.5">
            <span class="w-3 h-3 rounded-full bg-indigo-500"></span>
            <div>
              <div class="text-zinc-900 dark:text-white font-semibold">Modern Studio</div>
              <div class="text-[10px] text-zinc-500 font-mono">Indigo glow &bull; Rounded cards</div>
            </div>
          </div>
          <span class="theme-check text-indigo-500 font-bold hidden">✓</span>
        </button>

        <button 
          data-theme-choice="mono"
          class="theme-opt w-full flex items-center justify-between p-2 rounded-xl text-left hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors text-xs font-medium cursor-pointer"
        >
          <div class="flex items-center gap-2.5">
            <span class="w-3 h-3 rounded-xs bg-emerald-500"></span>
            <div>
              <div class="text-zinc-900 dark:text-white font-semibold font-mono">Cyber / Mono</div>
              <div class="text-[10px] text-zinc-500 font-mono">JetBrains &bull; Sharp wireframe</div>
            </div>
          </div>
          <span class="theme-check text-emerald-500 font-bold hidden">✓</span>
        </button>

        <button 
          data-theme-choice="editorial"
          class="theme-opt w-full flex items-center justify-between p-2 rounded-xl text-left hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors text-xs font-medium cursor-pointer"
        >
          <div class="flex items-center gap-2.5">
            <span class="w-3 h-3 rounded-full bg-orange-600"></span>
            <div>
              <div class="text-zinc-900 dark:text-white font-semibold font-serif">Editorial Warm</div>
              <div class="text-[10px] text-zinc-500 font-mono">Playfair serif &bull; Warm paper</div>
            </div>
          </div>
          <span class="theme-check text-orange-600 font-bold hidden">✓</span>
        </button>

        <button 
          data-theme-choice="brutalist"
          class="theme-opt w-full flex items-center justify-between p-2 rounded-xl text-left hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors text-xs font-medium cursor-pointer"
        >
          <div class="flex items-center gap-2.5">
            <span class="w-3 h-3 rounded-xs bg-amber-500 border border-black"></span>
            <div>
              <div class="text-zinc-900 dark:text-white font-bold">Neo-Brutalist</div>
              <div class="text-[10px] text-zinc-500 font-mono">Solid borders &bull; Hard shadows</div>
            </div>
          </div>
          <span class="theme-check text-amber-500 font-bold hidden">✓</span>
        </button>

        <button 
          data-theme-choice="luxury"
          class="theme-opt w-full flex items-center justify-between p-2 rounded-xl text-left hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors text-xs font-medium cursor-pointer"
        >
          <div class="flex items-center gap-2.5">
            <span class="w-3 h-3 rounded-full bg-[#d4af37] shadow-[0_0_8px_rgba(212,175,55,0.6)]"></span>
            <div>
              <div class="text-zinc-900 dark:text-white font-semibold font-serif tracking-wider">Luxury Classical</div>
              <div class="text-[10px] text-zinc-500 font-mono">Pitch black &bull; Cinzel serif &bull; Gold</div>
            </div>
          </div>
          <span class="theme-check text-[#d4af37] font-bold hidden">✓</span>
        </button>

      </div>

      <!-- A/B Random Testing Toggle -->
      <div class="pt-2 border-t border-zinc-100 dark:border-zinc-800">
        <button 
          id="toggle-ab-mode"
          class="w-full py-2 px-2.5 rounded-xl border border-dashed border-zinc-300 dark:border-zinc-700 hover:border-indigo-500 text-zinc-700 dark:text-zinc-300 text-xs font-mono flex items-center justify-between transition-colors cursor-pointer"
        >
          <span class="flex items-center gap-1.5">
            <span>🎲</span> Random A/B Mode
          </span>
          <span id="ab-status" class="px-2 py-0.5 rounded text-[10px] font-bold bg-zinc-100 dark:bg-zinc-800 text-zinc-500">OFF</span>
        </button>
      </div>

    </div>
  </div>
</div>

<script>
  const themes = ['modern', 'mono', 'editorial', 'brutalist', 'luxury'];
  const themeNames: Record<string, string> = {
    modern: 'Modern',
    mono: 'Cyber Mono',
    editorial: 'Editorial',
    brutalist: 'Brutalist',
    luxury: 'Luxury Classical'
  };
  const themeColors: Record<string, string> = {
    modern: '#6366f1',
    mono: '#10b981',
    editorial: '#ea580c',
    brutalist: '#f59e0b',
    luxury: '#d4af37'
  };

  const toggleBtn = document.getElementById('theme-switcher-toggle') as HTMLButtonElement | null;
  const menu = document.getElementById('theme-switcher-menu');
  const closeBtn = document.getElementById('close-theme-menu');
  const activeDot = document.getElementById('active-theme-dot');
  const activeName = document.getElementById('active-theme-name');
  const options = document.querySelectorAll('.theme-opt');
  const abBtn = document.getElementById('toggle-ab-mode');
  const abStatus = document.getElementById('ab-status');

  // Theme switcher is currently disabled
  const IS_DISABLED = true;

  function updateUI(theme: string) {
    if (activeName) activeName.textContent = themeNames[theme] || 'Theme';
    if (activeDot) activeDot.style.backgroundColor = themeColors[theme] || '#d4af37';

    options.forEach((opt) => {
      const choice = opt.getAttribute('data-theme-choice');
      const check = opt.querySelector('.theme-check');
      if (choice === theme) {
        check?.classList.remove('hidden');
        opt.classList.add('bg-zinc-100', 'dark:bg-zinc-800');
      } else {
        check?.classList.add('hidden');
        opt.classList.remove('bg-zinc-100', 'dark:bg-zinc-800');
      }
    });

    const isAb = localStorage.getItem('ab-theme-mode') === 'true';
    if (abStatus) {
      abStatus.textContent = isAb ? 'ON' : 'OFF';
      if (isAb) {
        abStatus.className = 'px-2 py-0.5 rounded text-[10px] font-bold bg-indigo-50 text-indigo-600 dark:bg-indigo-950 dark:text-indigo-400';
      } else {
        abStatus.className = 'px-2 py-0.5 rounded text-[10px] font-bold bg-zinc-100 dark:bg-zinc-800 text-zinc-500';
      }
    }
  }

  // Toggle menu (prevented while disabled)
  toggleBtn?.addEventListener('click', (e) => {
    e.preventDefault();
    e.stopPropagation();
    if (IS_DISABLED) return;
    menu?.classList.toggle('hidden');
  });

  closeBtn?.addEventListener('click', () => {
    menu?.classList.add('hidden');
  });

  document.addEventListener('click', (e) => {
    if (!menu?.contains(e.target as Node) && !toggleBtn?.contains(e.target as Node)) {
      menu?.classList.add('hidden');
    }
  });

  // Select manual theme (prevented while disabled)
  options.forEach((opt) => {
    opt.addEventListener('click', () => {
      if (IS_DISABLED) return;
      const choice = opt.getAttribute('data-theme-choice') || 'luxury';
      localStorage.setItem('user-theme', choice);
      localStorage.setItem('ab-theme-mode', 'false');
      document.documentElement.setAttribute('data-theme', choice);
      updateUI(choice);
    });
  });

  // Toggle A/B Random mode (prevented while disabled)
  abBtn?.addEventListener('click', () => {
    if (IS_DISABLED) return;
    const isAb = localStorage.getItem('ab-theme-mode') === 'true';
    const nextState = !isAb;
    localStorage.setItem('ab-theme-mode', String(nextState));

    if (nextState) {
      const randomTheme = themes[Math.floor(Math.random() * themes.length)];
      localStorage.setItem('user-theme', randomTheme);
      updateUI(randomTheme);
    } else {
      updateUI(localStorage.getItem('user-theme') || 'luxury');
    }
  });

  // Initialize on load
  const currentTheme = document.documentElement.getAttribute('data-theme') || 'luxury';
  updateUI(currentTheme);
</script>
