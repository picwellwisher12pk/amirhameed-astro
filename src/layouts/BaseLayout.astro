---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Amir Hameed — UI/UX Architect & Full-Stack Builder",
  description = "Personal website, projects showcase, and technical writings of Amir Hameed, seasoned UI/UX designer and frontend developer.",
  image = "/favicon.svg",
} = Astro.props;

const currentPath = Astro.url.pathname;

import fs from "node:fs";
import path from "node:path";

import ThemeSwitcher from "../components/ThemeSwitcher.astro";
import LuxuryCinematicIntro from "../components/LuxuryCinematicIntro.astro";
import UnifiedStudio from "../components/UnifiedStudio.astro";

const hasCustomLogoSvg = fs.existsSync(path.resolve("./public/logo.svg"));
const hasCustomLogoPng = fs.existsSync(path.resolve("./public/logo.png"));
const customLogo = hasCustomLogoSvg
  ? "/logo.svg"
  : hasCustomLogoPng
    ? "/logo.png"
    : null;
---

<!doctype html>
<html lang="en" class="dark" data-theme="luxury">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={image} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,600&family=Space+Grotesk:wght@500;600;700&family=Cinzel:wght@500;600;700;800;900&family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Vazirmatn:wght@300;400;500;600;700;800&family=Noto+Sans+Arabic:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      // Initialize dark/light mode early to avoid FOUC
      const theme = (() => {
        if (
          typeof localStorage !== "undefined" &&
          localStorage.getItem("theme")
        ) {
          return localStorage.getItem("theme");
        }
        if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
          return "dark";
        }
        return "light";
      })();

      if (theme === "light") {
        document.documentElement.classList.remove("dark");
      } else {
        document.documentElement.classList.add("dark");
      }

      // Visual Theme Personality (Theme switcher disabled for now - lock to luxury theme)
      const userTheme = "luxury";
      document.documentElement.classList.add("dark");
      document.documentElement.classList.add("luxury-animating");
      document.documentElement.setAttribute("data-theme", userTheme);
    </script>
  </head>
  <body
    class="bg-zinc-50 dark:bg-zinc-950 text-zinc-900 dark:text-zinc-100 min-h-screen flex flex-col font-['Plus_Jakarta_Sans',sans-serif] selection:bg-indigo-500 selection:text-white transition-colors duration-200"
  >
    <!-- Top Navigation Bar (Transparent, No Background) -->
    <header
      class="sticky top-0 z-50 bg-transparent border-none shadow-none luxury-seq-header"
    >
      <div
        class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between"
      >
        <!-- Logo -->
        <a href="/" class="flex items-center gap-3 group">
          {
            customLogo ? (
              <img
                src={customLogo}
                alt="Amir Hameed"
                class="header-brand-icon h-9 w-auto max-w-[140px] object-contain group-hover:scale-105 transition-transform"
              />
            ) : (
              <div class="header-brand-icon w-9 h-9 rounded-xl bg-gradient-to-tr from-indigo-600 to-violet-500 flex items-center justify-center text-white font-bold text-lg shadow-md shadow-indigo-500/20 group-hover:scale-105 transition-transform">
                AH
              </div>
            )
          }
          <div class="flex flex-col">
            <span
              class="header-logo-title font-medium text-white leading-none text-sm transition-colors"
              >Amir Hameed</span
            >
          </div>
        </a>

        <!-- Right Side: Simple 3-Bar Burger Menu Button (No borders, no background) -->
        <div class="flex items-center">
          <button
            id="viewport-menu-btn"
            aria-label="Open Navigation Menu"
            aria-expanded="false"
            class="header-menu-btn p-2 text-white/90 hover:text-[#d4af37] transition-colors cursor-pointer border-none bg-transparent"
          >
            <!-- Simple 3 bar icon -->
            <svg
              class="w-6 h-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Fullscreen Viewport-Size Navigation Menu Overlay -->
    <div
      id="viewport-fullscreen-menu"
      class="fixed inset-0 z-[100] w-screen h-screen flex flex-col justify-between bg-black/98 backdrop-blur-3xl transition-all duration-400 ease-in-out opacity-0 pointer-events-none"
      aria-hidden="true"
    >
      <!-- Top Bar inside Viewport Menu -->
      <div
        class="max-w-6xl mx-auto w-full px-4 sm:px-6 h-16 flex items-center justify-between shrink-0 border-b border-zinc-800/60"
      >
        <a href="/" class="viewport-menu-logo flex items-center gap-3">
          <span
            class="header-logo-title font-medium text-white leading-none text-sm"
            >Amir Hameed</span
          >
        </a>
        <button
          id="viewport-menu-close-btn"
          aria-label="Close Navigation Menu"
          class="flex items-center gap-2 px-3 py-1.5 rounded-lg border border-zinc-800 text-zinc-400 hover:text-white hover:border-[#d4af37]/60 transition-colors duration-300 ease-in-out cursor-pointer group"
        >
          <span
            class="text-xs uppercase tracking-widest font-mono text-zinc-400 group-hover:text-white"
            >Close</span
          >
          <svg
            class="w-4 h-4 transition-transform duration-300 ease-in-out group-hover:rotate-90"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <!-- Center: Viewport Navigation Links -->
      <div class="flex-grow flex items-center justify-center px-6 py-8">
        <nav
          class="flex flex-col items-center justify-center space-y-4 sm:space-y-6 text-center"
        >
          <a
            href="/"
            class:list={[
              "viewport-nav-link text-2xl sm:text-4xl md:text-5xl font-light tracking-wider transition-all duration-300 ease-in-out hover:scale-105",
              currentPath === "/"
                ? "active-nav-link text-[#d4af37] font-semibold"
                : "text-white/80 hover:text-white hover:text-[#d4af37]",
            ]}
          >
            <span
              class="text-xs sm:text-sm font-mono text-zinc-500 mr-2 sm:mr-3 tracking-widest"
              >01</span
            >
            Home
          </a>
          <a
            href="/projects"
            class:list={[
              "viewport-nav-link text-2xl sm:text-4xl md:text-5xl font-light tracking-wider transition-all duration-300 ease-in-out hover:scale-105",
              currentPath.startsWith("/projects")
                ? "active-nav-link text-[#d4af37] font-semibold"
                : "text-white/80 hover:text-white hover:text-[#d4af37]",
            ]}
          >
            <span
              class="text-xs sm:text-sm font-mono text-zinc-500 mr-2 sm:mr-3 tracking-widest"
              >02</span
            >
            Projects
          </a>
          <a
            href="/blog"
            class:list={[
              "viewport-nav-link text-2xl sm:text-4xl md:text-5xl font-light tracking-wider transition-all duration-300 ease-in-out hover:scale-105",
              currentPath.startsWith("/blog")
                ? "active-nav-link text-[#d4af37] font-semibold"
                : "text-white/80 hover:text-white hover:text-[#d4af37]",
            ]}
          >
            <span
              class="text-xs sm:text-sm font-mono text-zinc-500 mr-2 sm:mr-3 tracking-widest"
              >03</span
            >
            Blog
          </a>
          <a
            href="/about"
            class:list={[
              "viewport-nav-link text-2xl sm:text-4xl md:text-5xl font-light tracking-wider transition-all duration-300 ease-in-out hover:scale-105",
              currentPath.startsWith("/about")
                ? "active-nav-link text-[#d4af37] font-semibold"
                : "text-white/80 hover:text-white hover:text-[#d4af37]",
            ]}
          >
            <span
              class="text-xs sm:text-sm font-mono text-zinc-500 mr-2 sm:mr-3 tracking-widest"
              >04</span
            >
            About
          </a>
          <a
            href="/contact"
            class:list={[
              "viewport-nav-link text-2xl sm:text-4xl md:text-5xl font-light tracking-wider transition-all duration-300 ease-in-out hover:scale-105",
              currentPath.startsWith("/contact")
                ? "active-nav-link text-[#d4af37] font-semibold"
                : "text-white/80 hover:text-white hover:text-[#d4af37]",
            ]}
          >
            <span
              class="text-xs sm:text-sm font-mono text-zinc-500 mr-2 sm:mr-3 tracking-widest"
              >05</span
            >
            Contact
          </a>
        </nav>
      </div>

      <!-- Bottom Bar: Coordinates, Email, Socials -->
      <div
        class="max-w-6xl mx-auto w-full px-4 sm:px-6 py-6 border-t border-zinc-800/60 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-zinc-500"
      >
        <div>
          <span class="text-[#d4af37]">Amir Hameed</span> &mdash; UI/UX Architect
          &amp; Full-Stack Builder
        </div>
        <div class="flex items-center gap-6 text-zinc-400">
          <a
            href="mailto:contact@amirhameed.com"
            class="hover:text-[#d4af37] transition-colors"
            >contact@amirhameed.com</a
          >
          <a
            href="https://github.com/amirhameed"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-white transition-colors">GitHub</a
          >
          <a href="/contact" class="hover:text-[#d4af37] transition-colors"
            >Let's Talk &rarr;</a
          >
        </div>
      </div>
    </div>

    <!-- Main Content Area -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <footer
      class="mt-20 border-t border-zinc-200 dark:border-zinc-800/80 bg-zinc-100/50 dark:bg-zinc-950/50 py-12"
    >
      <div
        class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col md:flex-row items-center justify-between gap-6"
      >
        <div class="flex flex-col items-center md:items-start">
          <div class="font-bold text-zinc-900 dark:text-white">Amir Hameed</div>
        </div>

        <div
          class="flex items-center gap-6 text-sm text-zinc-500 dark:text-zinc-400"
        >
          <a
            href="/projects"
            class="hover:text-zinc-900 dark:hover:text-white transition-colors"
            >Projects</a
          >
          <a
            href="/blog"
            class="hover:text-zinc-900 dark:hover:text-white transition-colors"
            >Blog</a
          >
          <a
            href="/about"
            class="hover:text-zinc-900 dark:hover:text-white transition-colors"
            >About</a
          >
          <a
            href="/contact"
            class="hover:text-zinc-900 dark:hover:text-white transition-colors"
            >Contact</a
          >
          <a
            href="https://github.com/amirhameed"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-zinc-900 dark:hover:text-white transition-colors"
            >GitHub</a
          >
        </div>

        <div class="flex flex-col sm:flex-row items-center gap-4">
          <ThemeSwitcher />
          <div class="text-xs text-zinc-400 dark:text-zinc-500 font-mono">
            &copy; {new Date().getFullYear()} amirhameed.com
          </div>
        </div>
      </div>
    </footer>

    <!-- Viewport Fullscreen Menu Script -->
    <script>
      const menuBtn = document.getElementById("viewport-menu-btn");
      const menuOverlay = document.getElementById("viewport-fullscreen-menu");
      const closeBtn = document.getElementById("viewport-menu-close-btn");

      function openMenu() {
        if (!menuOverlay) return;
        menuOverlay.classList.remove("opacity-0", "pointer-events-none");
        menuOverlay.classList.add("opacity-100", "pointer-events-auto");
        menuOverlay.setAttribute("aria-hidden", "false");
        menuBtn?.setAttribute("aria-expanded", "true");
        document.documentElement.classList.add("overflow-hidden");
        document.body.classList.add("overflow-hidden");
      }

      function closeMenu() {
        if (!menuOverlay) return;
        menuOverlay.classList.remove("opacity-100", "pointer-events-auto");
        menuOverlay.classList.add("opacity-0", "pointer-events-none");
        menuOverlay.setAttribute("aria-hidden", "true");
        menuBtn?.setAttribute("aria-expanded", "false");
        document.documentElement.classList.remove("overflow-hidden");
        document.body.classList.remove("overflow-hidden");
      }

      menuBtn?.addEventListener("click", openMenu);
      closeBtn?.addEventListener("click", closeMenu);

      window.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeMenu();
      });

      menuOverlay?.querySelectorAll(".viewport-nav-link").forEach((link) => {
        link.addEventListener("click", closeMenu);
      });
    </script>
    <!-- Luxury Cinematic Intro Animation Overlay -->
    <LuxuryCinematicIntro />
    <!-- Unified Creative Studio: Particle VFX & Typography Live Studio -->
    <UnifiedStudio />
  </body>
</html>
